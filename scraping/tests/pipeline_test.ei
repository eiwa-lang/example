import { assert } from "std.core"
import { InvalidPipeline, PipelineNotFound, parsePipeline, Goto, Collect, Paginate, Click, Wait, Captcha } from ".scraper.pipeline.pipeline"
import { parseEvery } from ".scraper.pipeline.schedule"
import { PipelineStore, parsePipelineYaml } from ".scraper.pipeline.store"

fun quotesFixture(): String {
    return "{\"name\": \"quotes\", \"steps\": [{\"goto\": {\"url\": \"https://quotes.toscrape.com/\"}}, {\"collect\": {\"selector\": \"div.quote\", \"fields\": [{\"name\": \"text\", \"selector\": \"span.text\"}, {\"name\": \"author\", \"selector\": \"small.author\"}, {\"name\": \"tags\", \"selector\": \"a.tag\", \"many\": true}]}}, {\"paginate\": {\"selector\": \"li.next a\", \"maxPages\": 100}}], \"required\": [\"text\", \"author\"]}"
}

fun invalidFixture(raw: String): Bool {
    try {
        parsePipeline(raw)
        return false
    } catch (e: InvalidPipeline) {
        return true
    }
}

test "pipeline: quotes fixture parses and validates" {
    val p = parsePipeline(quotesFixture())
    assert(p.name == "quotes", "name")
    assert(p.steps.size() == 3, "steps")
    assert(p.steps.get(0) is Goto, "goto")
    assert(p.steps.get(1) is Collect, "collect")
    assert(p.steps.get(2) is Paginate, "paginate")
    assert((p.steps.get(1) as Collect).fields.size() == 3, "fields")
    assert((p.steps.get(1) as Collect).fields.get(2).many == true, "tags-many")
    assert(p.fieldNames().size() == 3, "names")
}

test "pipeline: omitted keys fall back to defaults" {
    val p = parsePipeline(quotesFixture())
    assert((p.steps.get(0) as Goto).waitUntil == "load", "waitUntil")
    assert((p.steps.get(0) as Goto).timeoutMs == 15000, "timeout")
    assert((p.steps.get(1) as Collect).fields.get(0).many == false, "many")
    assert((p.steps.get(1) as Collect).fields.get(0).attr == null, "attr-absent-is-null")
}

test "pipeline: omitted optionals decode as null" {
    val p = parsePipeline(quotesFixture())
    assert((p.steps.get(1) as Collect).fields.get(0).attr == null, "attr")
    val raw = "{\"name\": \"product\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/p/42\"}}, {\"collect\": {\"fields\": [{\"name\": \"pname\", \"selector\": \".name\"}]}}], \"required\": [\"pname\"]}"
    val q = parsePipeline(raw)
    assert((q.steps.get(1) as Collect).selector == null, "selector")
}

test "pipeline: legacy empty-string snapshot still runs as absent" {
    val raw = "{\"name\": \"product\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/p/42\"}}, {\"collect\": {\"selector\": \"\", \"fields\": [{\"name\": \"pname\", \"selector\": \".name\", \"many\": false, \"attr\": \"\"}]}}], \"required\": [\"pname\"]}"
    val p = parsePipeline(raw)
    assert((p.steps.get(1) as Collect).selector == "", "tolerated")
    assert((p.steps.get(1) as Collect).fields.get(0).attr == "", "tolerated-attr")
}

test "pipeline: unknown step tag is rejected" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"fly\": {}}], \"required\": []}"
    assert(invalidFixture(raw), "tag")
}

test "pipeline: first step must be goto" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"collect\": {\"fields\": [{\"name\": \"n\", \"selector\": \".n\"}]}}], \"required\": []}"
    assert(invalidFixture(raw), "order")
}

test "pipeline: collect without fields is rejected" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"collect\": {\"selector\": \"div.x\", \"fields\": []}}], \"required\": []}"
    assert(invalidFixture(raw), "fields")
}

test "pipeline: unknown required field is rejected" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"collect\": {\"fields\": [{\"name\": \"n\", \"selector\": \".n\"}]}}], \"required\": [\"autor\"]}"
    assert(invalidFixture(raw), "required")
}

test "pipeline: duplicate field names are rejected" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"collect\": {\"fields\": [{\"name\": \"n\", \"selector\": \".a\"}, {\"name\": \"n\", \"selector\": \".b\"}]}}], \"required\": []}"
    assert(invalidFixture(raw), "dupe")
}

test "pipeline: decode error maps to InvalidPipeline" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}]}"
    assert(invalidFixture(raw), "missing-required-key")
}

test "pipeline: single-record collect omits selector" {
    val raw = "{\"name\": \"product\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/p/42\"}}, {\"collect\": {\"fields\": [{\"name\": \"pname\", \"selector\": \".name\"}]}}], \"required\": [\"pname\"]}"
    val p = parsePipeline(raw)
    assert((p.steps.get(1) as Collect).selector == null, "no-selector")
}

test "pipeline: round-trips through json" {
    val p = parsePipeline(quotesFixture())
    val back = parsePipeline(p.toJson())
    assert(back.name == "quotes", "name")
    assert(back.steps.get(1) is Collect, "collect")
    assert((back.steps.get(1) as Collect).fields.get(0).selector == "span.text", "field")
    assert(back.required.size() == 2, "required")
}

test "pipeline: click and wait validate" {
    val raw = "{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"click\": {\"selector\": \"button.tab\", \"index\": 6}}, {\"wait\": {\"selector\": \"#view h3\", \"text\": \"MCP\"}}, {\"collect\": {\"fields\": [{\"name\": \"t\", \"selector\": \"h3\"}]}}], \"required\": [\"t\"]}"
    val p = parsePipeline(raw)
    assert(p.steps.size() == 4, "steps")
    assert(p.steps.get(1) is Click, "click")
    assert(p.steps.get(2) is Wait, "wait")
    assert((p.steps.get(2) as Wait).timeoutMs == 5000, "wait-default")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"click\": {\"selector\": \"\", \"index\": 1}}], \"required\": []}"), "click-selector")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"click\": {\"selector\": \"b\", \"index\": 0}}], \"required\": []}"), "click-index")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"wait\": {\"selector\": \"\", \"text\": \"\"}}], \"required\": []}"), "wait-selector")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"wait\": {\"selector\": \"h3\", \"timeoutMs\": 0}}], \"required\": []}"), "wait-timeout")
}

test "pipeline: gotoUrl returns the first goto url" {
    val p = parsePipeline(quotesFixture())
    assert(p.gotoUrl() == "https://quotes.toscrape.com/", "url")
}

test "pipeline: catch-bound message assigns to String" {
    var m = "unset"
    try {
        throw Exception("boom")
    } catch (e: Exception) {
        m = e.message()
    }
    assert(m == "boom")
    val n: String = m
    assert(n == "boom")
}

fun missingPipeline(store: PipelineStore, name: String): Bool {
    try {
        store.load(name)
        return false
    } catch (e: PipelineNotFound) {
        return true
    }
}

fun badName(store: PipelineStore, name: String): Bool {
    try {
        store.load(name)
        return false
    } catch (e: InvalidPipeline) {
        return true
    }
}

test "pipeline: store rejects unsafe names" {
    val store = PipelineStore("pipelines")
    assert(badName(store, "../eiwa"), "traversal")
    assert(badName(store, "a/b"), "subdir")
    assert(badName(store, ""), "empty")
    assert(badName(store, "a|b"), "separator")
}

test "pipeline: store loads quotes.yaml from disk" {
    val store = PipelineStore("pipelines")
    val p = store.load("quotes")
    assert(p.name == "quotes", "name")
    assert(p.steps.size() == 3, "steps")
    assert((p.steps.get(1) as Collect).selector == "div.quote", "selector")
    assert((p.steps.get(0) as Goto).timeoutMs == 15000, "default")
    assert(p.required.size() == 2, "required")
    assert(p.schedule == null, "manual-only")
}

test "pipeline: malformed yaml maps to InvalidPipeline" {
    try {
        parsePipelineYaml("steps: [ unbalanced")
        assert(false, "throws")
    } catch (e: InvalidPipeline) {
        assert(true, "typed")
    }
}

test "pipeline: store loads eiwa-mcp with click and wait" {
    val p = PipelineStore("pipelines").load("eiwa-mcp")
    assert(p.name == "eiwa-mcp", "name")
    assert(p.steps.size() == 5, "steps")
    assert(p.steps.get(2) is Click, "click")
    assert(p.steps.get(3) is Wait, "wait")
    assert(p.gotoUrl() == "https://eiwa.dev/", "url")
}

test "pipeline: store maps missing file to PipelineNotFound" {
    val store = PipelineStore("pipelines")
    assert(missingPipeline(store, "nope"), "missing")
    assert(missingPipeline(PipelineStore("no-such-dir"), "quotes"), "dir")
}

test "pipeline: captcha validates" {
    val raw = "{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"captcha\": {\"provider\": \"two-captcha\", \"responseSelector\": \"#g-response\"}}, {\"collect\": {\"fields\": [{\"name\": \"t\", \"selector\": \"h3\"}]}}], \"required\": [\"t\"]}"
    val p = parsePipeline(raw)
    assert(p.steps.size() == 3, "steps")
    assert(p.steps.get(1) is Captcha, "captcha")
    assert((p.steps.get(1) as Captcha).provider == "two-captcha", "provider")
    assert((p.steps.get(1) as Captcha).timeoutMs == 120000, "timeout-default")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"captcha\": {\"responseSelector\": \"#g\"}}], \"required\": []}"), "provider-required")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"captcha\": {\"provider\": \"Two_Captcha!\"}}], \"required\": []}"), "provider-charset")
    assert(invalidFixture("{\"name\": \"x\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"captcha\": {\"provider\": \"fake\"}}], \"required\": []}"), "response-required")
}

test "pipeline: every parses durations to ms" {
    assert(parseEvery("30s") == 30000, "seconds")
    assert(parseEvery("15m") == 900000, "minutes")
    assert(parseEvery("2h") == 7200000, "hours")
    assert(parseEvery("1d") == 86400000, "days")
    assert(parseEvery("") == null, "empty")
    assert(parseEvery("10") == null, "no-unit")
    assert(parseEvery("m") == null, "no-count")
    assert(parseEvery("1x") == null, "unit")
    assert(parseEvery("0h") == null, "zero")
    assert(parseEvery("1.5h") == null, "fraction")
}

test "pipeline: bad schedule every is rejected" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"collect\": {\"fields\": [{\"name\": \"n\", \"selector\": \".n\"}]}}], \"required\": [], \"schedule\": {\"every\": \"soon\"}}"
    assert(invalidFixture(raw), "every")
}

test "pipeline: schedule round-trips through json" {
    val raw = "{\"name\": \"q\", \"steps\": [{\"goto\": {\"url\": \"https://example.com/\"}}, {\"collect\": {\"fields\": [{\"name\": \"n\", \"selector\": \".n\"}]}}], \"required\": [\"n\"], \"schedule\": {\"every\": \"1h\"}}"
    val p = parsePipeline(raw)
    assert(p.schedule != null, "present")
    assert(p.schedule!!.everyMs() == 3600000, "cadence")
    val back = parsePipeline(p.toJson())
    assert(back.schedule != null, "kept")
    assert(back.schedule!!.every == "1h", "value")
}

test "pipeline: store lists yaml pipelines" {
    val names = PipelineStore("pipelines").list()
    assert(names.contains("quotes"), "quotes")
    assert(names.contains("eiwa-mcp"), "mcp")
    assert(names.contains("recaptcha-demo"), "demo")
}

test "pipeline: store loads dolar with schedule" {
    val p = PipelineStore("pipelines").load("dolar")
    assert(p.name == "dolar", "name")
    assert(p.schedule != null, "scheduled")
    assert(p.schedule!!.everyMs() == 60000, "every-minute")
    assert(p.gotoUrl() == "https://br.investing.com/currencies/usd-brl", "url")
    assert((p.steps.get(2) as Collect).fields.size() == 5, "fields")
    assert((p.steps.get(2) as Collect).fields.get(0).name == "price", "field")
}
