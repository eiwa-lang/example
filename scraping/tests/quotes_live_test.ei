import { assert } from "std.core"
import { Env } from "std.env"
import { Browser } from "browser.browser"
import { Job } from ".scraper.job"
import { PipelineStore } from ".scraper.pipeline.store"
import { PipelineRunner } from ".scraper.pipeline.runner"

test "pipeline: live quotes through a real worker" {
    val url = Env.get("SCRAPER_TEST_WORKER_URL")
    if (url == null || url == "") {
        echo("quotes live: skip (set SCRAPER_TEST_WORKER_URL)")
    } else {
        val pipeline = PipelineStore("pipelines").load("quotes")
        val browser = Browser([url], 2)
        val runner = PipelineRunner(browser)
        val job = Job("live-1", "quotes", "https://quotes.toscrape.com/", "page", 0, 3, "live-1", "quotes", pipeline.toJson())
        val res = runner.run(job, pipeline)
        assert(res.kind == "records", "kind-$res.note")
        assert(res.records.size() >= 50, "count-${res.records.size()}")
        assert(res.records.get(0).text("author") != "", "author")
        assert(res.records.get(0).texts("tags").size() > 0, "tags")
        browser.close()
    }
}
