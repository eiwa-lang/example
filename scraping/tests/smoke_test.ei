import { assert } from "std.core"
import { Env } from "std.env"
import { InvalidConfig, loadConfig, splitCsv, parsePositive, envPositive } from ".scraper.config"

fun validEnv(): Void {
    // Load first so explicit sets below win over repo .env values
    // (Env.get auto-loads once per process, overwriting unconditionally).
    Env.load()
    Env.set("BROWSER_WORKERS", "ws://browser-worker:8080")
    Env.set("DATABASE_URL", "postgres://scraper:scraper@localhost:5432/scraping")
    Env.set("CONCURRENCY", "4")
    Env.set("POLL_INTERVAL_MS", "1000")
    Env.set("ARTIFACT_DIR", "/tmp/scraper-artifacts")
    Env.set("PIPELINES_DIR", "pipelines")
}

fun cleanEnv(): Void {
    Env.load()
    Env.unset("BROWSER_WORKERS")
    Env.unset("DATABASE_URL")
    Env.unset("CONCURRENCY")
    Env.unset("POLL_INTERVAL_MS")
    Env.unset("ARTIFACT_DIR")
    Env.unset("PIPELINES_DIR")
    Env.unset("SCHEDULER_INTERVAL_MS")
    Env.unset("ORPHAN_TIMEOUT_MS")
}

fun loadFails(): Bool {
    try {
        loadConfig()
        return false
    } catch (e: InvalidConfig) {
        return true
    }
}

test "config: valid env parses" {
    validEnv()
    val cfg = loadConfig()
    assert(cfg.browserWorkers.size() == 1, "workers")
    assert(cfg.concurrency == 4, "concurrency")
    assert(cfg.pollIntervalMs == 1000, "poll")
    cleanEnv()
}

test "config: missing values throw" {
    cleanEnv()
    assert(loadFails(), "empty")
    validEnv()
    Env.unset("DATABASE_URL")
    assert(loadFails(), "no-db")
    cleanEnv()
}

test "config: malformed numbers throw" {
    validEnv()
    Env.set("CONCURRENCY", "many")
    assert(loadFails(), "nan")
    Env.set("CONCURRENCY", "0")
    assert(loadFails(), "zero")
    cleanEnv()
}

test "config: csv splits and trims empties" {
    assert(splitCsv("").size() == 0)
    assert(splitCsv("ws://a:8080,ws://b:8080").size() == 2)
    assert(parsePositive(null) == null)
    assert(parsePositive("") == null)
    assert(parsePositive("12") == 12)
    assert(parsePositive("1x") == null)
    assert(envPositive(null, 4, "X") == 4)
    assert(envPositive("", 4, "X") == 4)
    assert(envPositive("12", 4, "X") == 12)
}

test "config: captcha providers default to empty allowlist" {
    validEnv()
    Env.unset("CAPTCHA_PROVIDERS")
    assert(loadConfig().captchaProviders.size() == 0, "disabled")
    Env.set("CAPTCHA_PROVIDERS", "two-captcha,fake")
    val cfg = loadConfig()
    assert(cfg.captchaProviders.size() == 2, "parsed")
    assert(cfg.captchaProviders.get(0) == "two-captcha", "first")
    cleanEnv()
}

test "config: scheduler tick defaults" {
    validEnv()
    val cfg = loadConfig()
    assert(cfg.scheduleIntervalMs == 60000, "tick")
    assert(cfg.orphanTimeoutMs == 600000, "orphan")
    Env.set("SCHEDULER_INTERVAL_MS", "0")
    assert(loadFails(), "zero")
    Env.set("SCHEDULER_INTERVAL_MS", "30s")
    assert(loadFails(), "nan")
    Env.set("SCHEDULER_INTERVAL_MS", "60000")
    Env.set("ORPHAN_TIMEOUT_MS", "0")
    assert(loadFails(), "orphan-zero")
    cleanEnv()
}
