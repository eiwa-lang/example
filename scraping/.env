# Local run against the compose stack (worker on 18080, PG on 5435).
# Eiwa has no dotenv loader: export first, e.g.
#   set -a; source .env; set +a; ./scraper
BROWSER_WORKERS=ws://127.0.0.1:18080
DATABASE_URL=postgres://scraper:scraper@127.0.0.1:5435/scraping
CONCURRENCY=2
POLL_INTERVAL_MS=1000
ARTIFACT_DIR=/tmp/scraper-artifacts
PIPELINES_DIR=pipelines
CAPTCHA_PROVIDERS=universal
# Self-hosted universal solver (compose --profile captcha).
# Local `eiwa run` fala com o host; dentro do compose use http://captcha-solver:8855.
SOLVER_URL=http://127.0.0.1:8855
SOLVER_KEY=local-dev-key-001
# Scheduler (all optional; empty/absent = defaults).
# SCHEDULER_INTERVAL_MS=60000