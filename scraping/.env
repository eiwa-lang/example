# Local run against the compose stack (worker on 18080, PG on 5435).
# Eiwa has no dotenv loader: export first, e.g.
#   set -a; source .env; set +a; ./scraper
BROWSER_WORKERS=ws://127.0.0.1:18080
DATABASE_URL=postgres://scraper:scraper@127.0.0.1:5435/scraping
CONCURRENCY=2
POLL_INTERVAL_MS=1000
ARTIFACT_DIR=/tmp/scraper-artifacts
PIPELINES_DIR=pipelines
