// PipelineStore: loads versioned pipeline JSON from disk. Read-through
// on every load; content always enters via parsePipeline.
import { File } from "std.fs"
import { fromYaml } from "std.yaml"
import { Pipeline, PipelineNotFound, InvalidPipeline } from ".scraper.pipeline.pipeline"

type PipelineStore(val dir: String) {

    fun path(name: String): String {
        return this.dir + "/" + name + ".yaml"
    }

    fun validName(name: String): Bool {
        if (name == "") {
            return false
        }
        repeat(name.length) { i ->
            val ch = name.substring(i, i + 1)
            if (ch == "/" || ch == "|" || ch == ".") {
                return false
            }
        }
        return true
    }

    fun load(name: String): Pipeline {
        if (this.validName(name) == false) {
            throw InvalidPipeline("bad pipeline name: " + name)
        }
        val raw = try {
            File.read(this.path(name))
        } catch (e) {
            throw PipelineNotFound(name)
        }
        if (raw == "") {
            throw PipelineNotFound(name)
        }
        return parsePipelineYaml(raw)
    }
}

fun parsePipelineYaml(raw: String): Pipeline {
    val p = try {
        fromYaml<Pipeline>(raw)
    } catch (e: Exception) {
        throw InvalidPipeline("bad pipeline yaml: " + e.message())
    }
    if (p == null) {
        throw InvalidPipeline("bad pipeline yaml")
    }
    p.validate()
    return p
}
