// Pipeline types: agnostic extraction DSL. Only the YAML knows the
// product/page/rules; this file knows only the verbs (closed union).
import { List, MutableList } from "std.collections"
import { repeat } from "std.system"
import { Serializable } from "std.serde"
import { Json, fromJson } from "std.json"
import { Schedule } from ".scraper.pipeline.schedule"

type InvalidPipeline(val detail: String) : Throwable {
    implement fun message(): String {
        return this.detail
    }
}

type PipelineNotFound(val name: String) : Throwable {
    implement fun message(): String {
        return "pipeline not found: " + this.name
    }
}

type FieldDef(val name: String, val selector: String, val many: Bool = false, val attr: String? = null) : Serializable + Json

type Goto(val url: String, val waitUntil: String = "load", val timeoutMs: Int = 15000) : Serializable + Json

type Collect(val fields: List<FieldDef>, val selector: String? = null) : Serializable + Json

type Paginate(val selector: String, val maxPages: Int) : Serializable + Json

type Click(val selector: String, val index: Int = 1) : Serializable + Json

type Wait(val selector: String, val text: String? = null, val timeoutMs: Int = 5000) : Serializable + Json

type Captcha(val provider: String, val responseSelector: String, val sitekey: String? = null, val submitSelector: String? = null, val timeoutMs: Int = 120000) : Serializable + Json

union Step {
    @Alias("goto") Goto,
    @Alias("click") Click,
    @Alias("wait") Wait,
    @Alias("collect") Collect,
    @Alias("paginate") Paginate,
    @Alias("captcha") Captcha
}

type Pipeline(val name: String, val steps: List<Step>, val required: List<String>, val schedule: Schedule? = null) : Serializable + Json {

    fun validate(): Void {
        if (this.name == "") {
            throw InvalidPipeline("pipeline needs a name")
        }
        if (this.steps.size() == 0) {
            throw InvalidPipeline("pipeline needs steps")
        }
        if ((this.steps.get(0) is Goto) == false) {
            throw InvalidPipeline("first step must be goto")
        }
        repeat(this.steps.size()) { i ->
            this.validateStep(this.steps.get(i))
        }
        this.validateRequired()
        if (this.schedule != null && this.schedule!!.everyMs() <= 0) {
            throw InvalidPipeline("bad schedule every: " + this.schedule!!.every)
        }
    }

    fun validateStep(s: Step): Void {
        if (s is Goto) {
            if ((s as Goto).url == "") {
                throw InvalidPipeline("goto needs url")
            }
        } else if (s is Click) {
            val c = s as Click
            if (c.selector == "") {
                throw InvalidPipeline("click needs selector")
            }
            if (c.index < 1) {
                throw InvalidPipeline("click needs index >= 1")
            }
        } else if (s is Wait) {
            val w = s as Wait
            if (w.selector == "") {
                throw InvalidPipeline("wait needs selector")
            }
            if (w.timeoutMs <= 0) {
                throw InvalidPipeline("wait needs timeoutMs > 0")
            }
        } else if (s is Collect) {
            this.validateFields(s as Collect)
        } else if (s is Captcha) {
            val c = s as Captcha
            if (validProviderName(c.provider) == false) {
                throw InvalidPipeline("bad captcha provider")
            }
            if (c.responseSelector == "") {
                throw InvalidPipeline("captcha needs responseSelector")
            }
        } else if (s is Paginate) {
            val p = s as Paginate
            if (p.selector == "") {
                throw InvalidPipeline("paginate needs selector")
            }
            if (p.maxPages <= 0) {
                throw InvalidPipeline("paginate needs maxPages > 0")
            }
        } else {
            throw InvalidPipeline("unsupported step")
        }
    }

    fun validateFields(c: Collect): Void {
        if (c.fields.size() == 0) {
            throw InvalidPipeline("collect needs fields")
        }
        repeat(c.fields.size()) { i ->
            val f = c.fields.get(i)
            if (f.name == "") {
                throw InvalidPipeline("field needs a name")
            }
            if (f.selector == "") {
                throw InvalidPipeline("field needs selector: " + f.name)
            }
            repeat(i) { j ->
                if (c.fields.get(j).name == f.name) {
                    throw InvalidPipeline("duplicate field: " + f.name)
                }
            }
        }
    }

    fun fieldNames(): List<String> {
        val out: MutableList<String> = MutableList<String>()
        repeat(this.steps.size()) { i ->
            val s = this.steps.get(i)
            if (s is Collect) {
                val c = s as Collect
                repeat(c.fields.size()) { k ->
                    out.add(c.fields.get(k).name)
                }
            }
        }
        return out.freeze()
    }

    fun gotoUrl(): String {
        repeat(this.steps.size()) { i ->
            val s = this.steps.get(i)
            if (s is Goto) {
                return (s as Goto).url
            }
        }
        return ""
    }

    fun hasField(names: List<String>, want: String): Bool {        
        repeat(names.size()) { i ->
            if (names.get(i) == want) {
                return true
            }
        }
        return false
    }

    fun validateRequired(): Void {
        val names = this.fieldNames()
        repeat(this.required.size()) { i ->
            if (this.hasField(names, this.required.get(i)) == false) {
                throw InvalidPipeline("unknown required field: " + this.required.get(i))
            }
        }
    }
}

fun validProviderName(name: String): Bool {
    if (name == "") {
        return false
    }
    repeat(name.length) { i ->
        if ("abcdefghijklmnopqrstuvwxyz0123456789-".indexOf(name.substring(i, i + 1)) < 0) {
            return false
        }
    }
    return true
}

fun parsePipeline(raw: String): Pipeline {
    val p = try {
        fromJson<Pipeline>(raw)
    } catch (e: Exception) {
        throw InvalidPipeline("bad pipeline json: " + e.message())
    }
    if (p == null) {
        throw InvalidPipeline("bad pipeline json")
    }
    p.validate()
    return p
}
