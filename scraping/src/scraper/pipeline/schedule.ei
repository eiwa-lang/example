// Schedule: per-pipeline cadence ("30s", "15m", "6h", "1d").
// Standalone module: only std imports, so it can move to a shared lib
// untouched. Pipelines reference it; the Scheduler consumes it.
import { repeat } from "std.system"
import { Serializable } from "std.serde"
import { Json } from "std.json"

// Pipelines declaring it are enqueued by the Scheduler every `every`.
// Absent = manual runs only.
type Schedule(val every: String) : Serializable + Json {

    fun everyMs(): Int? {
        return parseEvery(this.every)
    }
}

// Duration to milliseconds, null when malformed. Pure: unit-tested.
fun parseEvery(raw: String): Int? {
    if (raw.length < 2) {
        return null
    }
    val unit = raw.substring(raw.length - 1, raw.length)
    var mult = 0
    if (unit == "s") {
        mult = 1000
    } else if (unit == "m") {
        mult = 60000
    } else if (unit == "h") {
        mult = 3600000
    } else if (unit == "d") {
        mult = 86400000
    } else {
        return null
    }
    val count = parseEveryCount(raw.substring(0, raw.length - 1))
    if (count == null || count!! <= 0 || count!! > 1000000000) {
        return null
    }
    return count!! * mult
}

fun parseEveryCount(raw: String): Int? {
    if (raw.length == 0) {
        return null
    }
    var n = 0
    repeat(raw.length) { i ->
        val d = "0123456789".indexOf(raw.substring(i, i + 1))
        if (d < 0) {
            return null
        }
        n = n * 10 + d
    }
    return n
}
