// Metrics handle: in-memory Prometheus counters, snake_case.
// No I/O here; Scraper serves render() over HTTP.
import { MutableMap } from "std.collections"

type Metrics(
    val jobs: MutableMap<String, Int> = MutableMap<String, Int>(),
    val fetchErrors: MutableMap<String, Int> = MutableMap<String, Int>()
) {

    fun bumpJobs(outcome: String): Void {
        this.jobs.put(outcome, (this.jobs.get(outcome) ?: 0) + 1)
    }

    fun bumpFetchError(reason: String): Void {
        this.fetchErrors.put(reason, (this.fetchErrors.get(reason) ?: 0) + 1)
    }

    fun jobCount(outcome: String): Int {
        return this.jobs.get(outcome) ?: 0
    }

    fun render(): String {
        var out = ""
        for (this.jobs) { entry ->
            out = out + "scrape_jobs_total{outcome=\"" + entry.key + "\"} " + entry.value.toString() + "\n"
        }
        for (this.fetchErrors) { entry ->
            out = out + "scrape_fetch_errors_total{reason=\"" + entry.key + "\"} " + entry.value.toString() + "\n"
        }
        return out
    }
}
