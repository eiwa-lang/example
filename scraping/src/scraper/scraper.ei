// Scraper handle: queue loop, connector dispatch, outcomes, metrics,
// health. Owns orchestration; connectors own fetching, Store owns SQL.
import { Closeable } from "std.core"
import { repeat, loop } from "std.system"
import { sleepMs } from "std.time"
import { DbError } from "std.db"
import { Serializable } from "std.serde"
import { Json, fromJson } from "std.json"
import { Browser } from "browser.browser"
import { arest } from "arest.arest"
import { HttpStatus } from "std.http"
import { Config } from ".scraper.config"
import { Job, backoffMs, shouldRetry } from ".scraper.job"
import { Store } from ".scraper.store"
import { Metrics } from ".scraper.metrics"
import { PipelineStore } from ".scraper.pipeline.store"
import { PipelineRunner } from ".scraper.pipeline.runner"
import { InvalidPipeline, PipelineNotFound, parsePipeline } from ".scraper.pipeline.pipeline"

// Notes that may retry with backoff (transient); everything else
// dead-letters. Pure policy, unit-tested.
fun retryableNote(note: String): Bool {
    if (note == "browser-timeout" || note == "browser-exhausted") {
        return true
    }
    return false
}

type JobRequest(
    val pipeline: String,
    val maxAttempts: Int = 3,
    val idempotencyKey: String = ""
) : Serializable + Json

type CreatedJob(val id: String, val status: String) : Serializable + Json

type InvalidJob(val detail: String) : Throwable {
    implement fun message(): String {
        return this.detail
    }
}

type DuplicateJob(val id: String) : Throwable {
    implement fun message(): String {
        return "duplicate job: " + this.id
    }
}

type HealthBody(val status: String, val pending: Int) : Serializable + Json

type Scraper(val config: Config, val store: Store, val browser: Browser, val pipelines: PipelineStore, val metrics: Metrics = Metrics()) : Closeable {

    fun runPipeline(job: Job): String {
        val pipeline = try {
            parsePipeline(job.pipelineJson)
        } catch (e: InvalidPipeline) {
            this.store.fail(job.id, false, 0)
            this.metrics.bumpJobs("dead")
            Log.info { "job dead: ${job.id} bad-pipeline" }
            return "dead-bad-pipeline"
        }
        val res = PipelineRunner(this.browser).run(job, pipeline)
        if (res.kind == "failed") {
            this.metrics.bumpFetchError(res.note)
            if (shouldRetry(job.attempt, job.maxAttempts, retryableNote(res.note))) {
                this.store.fail(job.id, true, backoffMs(job.attempt))
                this.metrics.bumpJobs("retry")
                Log.info { "job retry: ${job.id} ${res.note} attempt ${job.attempt}" }
                return "retry-" + res.note
            }
            this.store.fail(job.id, false, 0)
            this.metrics.bumpJobs("dead")
            Log.info { "job dead: ${job.id} ${res.note} attempt ${job.attempt}" }
            return "dead-" + res.note
        }
        repeat(res.records.size()) { i ->
            this.store.insertRecord(job.id, job.pipeline, res.records.get(i).toJson(), job.url, job.id + "-" + i.toString())
        }
        this.store.complete(job.id)
        this.metrics.bumpJobs("done")
        Log.info { "job done: ${job.id} ${res.records.size()} records" }
        return "done-" + res.records.size().toString()
    }

    fun runOnce(): String {
        try {
            val job = this.store.claim()
            if (job == null) {
                this.metrics.bumpJobs("empty")
                return "empty"
            }
            Log.info { "job claimed: ${job.id} ${job.pipeline} attempt ${job.attempt}" }
            return this.runPipeline(job)
        } catch (e: DbError) {
            this.metrics.bumpJobs("store-down")
            Log.error { "store unreachable in run loop" }
            return "store-down"
        }
    }

    fun run() {
        loop {
            val outcome = this.runOnce()
            if (outcome == "empty" || outcome == "store-down") {
                sleepMs(this.config.pollIntervalMs)
            }
        }
    }

    fun storeHealth(): HealthBody {
        try {
            return HealthBody("ok", this.store.pendingCount())
        } catch (e: DbError) {
            return HealthBody("degraded", -1)
        }
    }

    // POST /jobs body is a JobRequest DTO (arest deserializes shape;
    // domain rules stay here). Only the pipeline name comes from the
    // caller; url, selectors and rules come from pipelines/<name>.json.
    // Unknown pipeline, bad maxAttempts or malformed body fail fast with
    // InvalidJob instead of dead-lettering later. Duplicates throw
    // DuplicateJob, store failures propagate as DbError. Pure domain:
    // raw body in, created job out.
    fun createJob(rawBody: String): CreatedJob {
        val req = try {
            fromJson<JobRequest>(rawBody)
        } catch (e: Exception) {
            throw InvalidJob("bad job request")
        }
        if (req == null) {
            throw InvalidJob("bad job request")
        }
        if (req.pipeline == "") {
            throw InvalidJob("unknown pipeline")
        }
        if (req.maxAttempts <= 0) {
            throw InvalidJob("bad maxAttempts")
        }
        val pipeline = try {
            this.pipelines.load(req.pipeline)
        } catch (e: PipelineNotFound) {
            throw InvalidJob("unknown pipeline")
        }
        var key = pipeline.gotoUrl()
        if (req.idempotencyKey != "") {
            key = req.idempotencyKey
        }
        val id = req.pipeline + "-" + key
        if (this.store.enqueue(req.pipeline, pipeline.gotoUrl(), "page", req.maxAttempts, key, req.pipeline, pipeline.toJson())) {
            return CreatedJob(id, "queued")
        }
        throw DuplicateJob(id)
    }

    fun serveArest(port: Int): Void {
        val self = this
        arest(port) {
            routing {
                get("/health") {
                    respondJson(self.storeHealth().toJson())
                }
                get("/metrics") {
                    respondText(self.metrics.render())
                }
                post("/jobs") {
                    try {
                        val created = self.createJob(this.request.body)
                        respondJson(created.toJson(), HttpStatus.CREATED)
                    } catch (e: InvalidJob) {
                        respondJson(["error" of e.detail].toJson(), HttpStatus.BAD_REQUEST)
                    } catch (e: DuplicateJob) {
                        respondJson(["error" of "duplicate job"].toJson(), HttpStatus.CONFLICT)
                    } catch (e: DbError) {
                        respondJson(["error" of "store unreachable"].toJson(), HttpStatus.SERVICE_UNAVAILABLE)
                    } catch (e) {
                        Log.error { "unhandled job submit" }
                        respondJson(["error" of "internal error"].toJson(), HttpStatus.INTERNAL_SERVER_ERROR)
                    }
                }
            }
        }
    }

    implement fun close(): Void {
        this.browser.close()
        this.store.close()
    }
}
