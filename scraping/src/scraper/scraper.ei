// Scraper handle: queue loop, connector dispatch, outcomes, metrics,
// health. Owns orchestration; connectors own fetching, Store owns SQL.
import { Closeable } from "std.core"
import { repeat } from "std.system"
import { sleepMs } from "std.time"
import { DbError } from "std.db"
import { Serializable } from "std.serde"
import { Json } from "std.json"
import { Browser } from "browser.browser"
import { arest } from "arest.arest"
import { ApplicationCall } from "arest.server.application_call"
import { HttpStatus } from "std.http"
import { Config } from ".scraper.config"
import { Job, backoffMs, shouldRetry } from ".scraper.job"
import { Store } from ".scraper.store"
import { Metrics } from ".scraper.metrics"
import { QuotesConnector } from ".scraper.targets.quotes"

// Notes that may retry with backoff (transient); everything else
// dead-letters. Pure policy, unit-tested.
fun retryableNote(note: String): Bool {
    if (note == "browser-timeout" || note == "browser-exhausted") {
        return true
    }
    return false
}

type JobRequest(
    val connector: String,
    val url: String,
    val kind: String = "page",
    val maxAttempts: Int = 3,
    val idempotencyKey: String = ""
) : Serializable + Json

type HealthBody(val status: String, val pending: Int) : Serializable + Json

type Scraper(val config: Config, val store: Store, val browser: Browser, val metrics: Metrics = Metrics()) : Closeable {

    fun runOnce(): String {
        val job = this.store.claim()
        if (job == null) {
            this.metrics.bumpJobs("empty")
            return "empty"
        }
        Log.info { "job claimed: ${job.id} ${job.connector} attempt ${job.attempt}" }
        if (job.connector == "quotes") {
            return this.runQuotes(job)
        }
        this.store.fail(job.id, false, 0)
        this.metrics.bumpJobs("unknown")
        Log.info { "job dead: ${job.id} unknown connector ${job.connector}" }
        return "unknown-" + job.connector
    }

    fun runQuotes(job: Job): String {
        val connector = QuotesConnector(this.browser)
        val res = connector.fetch(job)
        if (res.kind == "failed") {
            this.metrics.bumpFetchError(res.note)
            if (shouldRetry(job.attempt, job.maxAttempts, retryableNote(res.note))) {
                this.store.fail(job.id, true, backoffMs(job.attempt))
                this.metrics.bumpJobs("retry")
                Log.info { "job retry: ${job.id} ${res.note} attempt ${job.attempt}" }
                return "retry-" + res.note
            }
            this.store.fail(job.id, false, 0)
            this.metrics.bumpJobs("dead")
            Log.info { "job dead: ${job.id} ${res.note} attempt ${job.attempt}" }
            return "dead-" + res.note
        }
        val recs = connector.normalize(res.body)
        repeat(recs.size()) { i ->
            this.store.insertRecord(job.id, job.connector, recs.get(i).toJson(), job.url, job.id + "-" + i.toString())
        }
        this.store.complete(job.id)
        this.metrics.bumpJobs("done")
        Log.info { "job done: ${job.id} ${recs.size()} records" }
        return "done-" + recs.size().toString()
    }

    // Bounded loop for tests and runs: limit < 0 runs forever
    // (sleeping between empty claims), otherwise stops after limit
    // jobs or first empty claim. Returns jobs completed.
    fun run(limit: Int): Int {
        var done = 0
        var n = 0
        while (limit < 0 || n < limit) {
            val outcome = this.runOnce()
            if (outcome == "empty") {
                if (limit < 0) {
                    sleepMs(this.config.pollIntervalMs)
                } else {
                    return done
                }
            } else {
                done = done + 1
                n = n + 1
            }
        }
        return done
    }

    fun health(): HealthBody {
        try {
            return HealthBody("ok", this.store.pendingCount())
        } catch (e: DbError) {
            return HealthBody("degraded", -1)
        }
    }

    // POST /jobs body is a JobRequest DTO (arest deserializes shape;
    // domain rules stay here). Strict at the boundary: unknown
    // connector, bad url, or malformed fields fail fast instead of
    // dead-lettering later.
    fun createJob(call: ApplicationCall): Void {
        val req = try {
            call.receive<JobRequest>()
        } catch (e: Throwable) {
            null
        }
        if (req == null) {
            call.respondText("bad job request", HttpStatus.BAD_REQUEST)
            return
        }
        if (req.connector != "quotes") {
            call.respondText("unknown connector", HttpStatus.BAD_REQUEST)
            return
        }
        if (req.url.indexOf("http://") != 0 && req.url.indexOf("https://") != 0) {
            call.respondText("bad url", HttpStatus.BAD_REQUEST)
            return
        }
        if (req.kind == "") {
            call.respondText("bad kind", HttpStatus.BAD_REQUEST)
            return
        }
        if (req.maxAttempts <= 0) {
            call.respondText("bad maxAttempts", HttpStatus.BAD_REQUEST)
            return
        }
        var key = req.url
        if (req.idempotencyKey != "") {
            key = req.idempotencyKey
        }
        // Defaults now apply at deserialize: a missing kind arrives as
        // "page", missing maxAttempts as 3, missing key as "" (→ url).
        try {
            if (this.store.enqueue(req.connector, req.url, req.kind, req.maxAttempts, key)) {
                call.respondJson(["id" of (req.connector + "-" + key), "status" of "queued"].toJson(), HttpStatus.CREATED)
            } else {
                call.respondText("duplicate job", HttpStatus.CONFLICT)
            }
        } catch (e: DbError) {
            call.respondText("store unreachable", HttpStatus.SERVICE_UNAVAILABLE)
        }
    }

    fun serveArest(port: Int): Void {
        val self = this
        arest(port) {
            routing {
                get("/health") {
                    respondJson(self.health().toJson())
                }
                get("/metrics") {
                    respondText(self.metrics.render())
                }
                post("/jobs") {
                    self.createJob(this)
                }
            }
        }
    }

    implement fun close(): Void {
        this.browser.close()
        this.store.close()
    }
}
