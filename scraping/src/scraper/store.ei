// Store handle: Postgres connection, migrations, job queue, records.
// Owns SQL; Job stays a pure value type.
import { Closeable } from "std.core"
import { repeat } from "std.system"
import { Connection } from "std.db"
import { Job } from ".scraper.job"
import { LockStore } from ".scraper.shedlock"

fun migrationCount(): Int {
    return 3
}

fun migrationSql(version: Int): String {
    if (version == 1) {
        return "
            CREATE TABLE IF NOT EXISTS jobs (id TEXT PRIMARY KEY, connector TEXT NOT NULL, url TEXT NOT NULL, kind TEXT NOT NULL, status TEXT NOT NULL, attempt INT NOT NULL, max_attempts INT NOT NULL, idempotency_key TEXT UNIQUE NOT NULL, not_before TIMESTAMPTZ NOT NULL DEFAULT now(), created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now()); 
            CREATE TABLE IF NOT EXISTS records (id TEXT PRIMARY KEY, job_id TEXT NOT NULL REFERENCES jobs(id), connector TEXT NOT NULL, payload JSONB NOT NULL, source_url TEXT NOT NULL, fetched_at TIMESTAMPTZ NOT NULL DEFAULT now()); 
            CREATE TABLE IF NOT EXISTS artifacts (id TEXT PRIMARY KEY, job_id TEXT NOT NULL REFERENCES jobs(id), file_name TEXT NOT NULL, mime TEXT NOT NULL, size BIGINT NOT NULL, storage_path TEXT NOT NULL, sha256 TEXT NOT NULL, fetched_at TIMESTAMPTZ NOT NULL DEFAULT now()); CREATE INDEX IF NOT EXISTS artifacts_sha256_idx ON artifacts (sha256, job_id); 
            CREATE TABLE IF NOT EXISTS schema_version (version INT PRIMARY KEY)
        "
    }
    if (version == 2) {
        return "
            ALTER TABLE jobs ADD COLUMN IF NOT EXISTS pipeline TEXT NOT NULL DEFAULT ''; 
            ALTER TABLE jobs ADD COLUMN IF NOT EXISTS pipeline_json JSONB NOT NULL DEFAULT '{}'
        "
    }
    if (version == 3) {
        return "CREATE TABLE IF NOT EXISTS shedlock (name TEXT PRIMARY KEY, locked_until TIMESTAMPTZ NOT NULL DEFAULT now(), locked_by TEXT NOT NULL DEFAULT '')"
    }
    return ""
}

type Store(val conn: Connection) : Closeable, LockStore {

    // Version-tracked: reads schema_version and applies only pending
    // migrations, so a settled database boots silent. Missing table
    // means a fresh database (start from zero); concurrent boots stay
    // safe via IF NOT EXISTS + ON CONFLICT DO NOTHING.
    fun appliedVersion(): Int {
        try {
            val rows = this.conn.query("SELECT version AS v FROM schema_version ORDER BY version").rows()
            var top = 0
            repeat(rows.size()) { i ->
                val v = rows.get(i).int("v")
                if (v > top) {
                    top = v
                }
            }
            return top
        } catch (e: DbError) {
            return 0
        }
    }

    fun migrate(): Int {
        var applied = 0
        var v = this.appliedVersion() + 1
        while (v <= migrationCount()) {
            this.conn.execute(migrationSql(v))
            this.conn.execute("INSERT INTO schema_version (version) VALUES ($1) ON CONFLICT (version) DO NOTHING", [v.toString()])
            applied = applied + 1
            v = v + 1
        }
        return applied
    }

    fun enqueue(connector: String, url: String, kind: String, maxAttempts: Int, idempotencyKey: String, pipeline: String, pipelineJson: String): Bool {
        val id = connector + "-" + idempotencyKey
        val res = this.conn.execute("
            INSERT INTO jobs (id, connector, url, kind, status, attempt, max_attempts, idempotency_key, pipeline, pipeline_json) 
            VALUES ($1, $2, $3, $4, 'queued', 0, $5, $6, $7, $8::jsonb) ON CONFLICT (idempotency_key) DO NOTHING
        ", [id, connector, url, kind, maxAttempts.toString(), idempotencyKey, pipeline, pipelineJson])
        return res.rowsAffected() == 1
    }

    fun claim(): Job? {
        val res = this.conn.query("
            UPDATE jobs SET status = 'running', attempt = attempt + 1, updated_at = now() 
            WHERE id = (SELECT id FROM jobs WHERE status = 'queued' AND not_before <= now() 
                ORDER BY created_at LIMIT 1 FOR UPDATE SKIP LOCKED) RETURNING id, connector, url, kind, attempt, max_attempts, idempotency_key, pipeline, pipeline_json
        ")
        val rows = res.rows()
        if (rows.size() == 0) {
            return null
        }
        val row = rows.get(0)
        return Job(row.string("id"), row.string("connector"), row.string("url"), row.string("kind"), row.int("attempt"), row.int("max_attempts"), row.string("idempotency_key"), row.string("pipeline"), row.string("pipeline_json"))
    }

    fun complete(id: String): Bool {
        val res = this.conn.execute("UPDATE jobs SET status = 'done', updated_at = now() WHERE id = $1", [id])
        return res.rowsAffected() == 1
    }

    // Shedlock: distributed mutex over Postgres so N pods schedule a
    // due pipeline exactly once. Acquire is atomic (single statement);
    // ttlMs is crash insurance, release narrows the exclusion window.
    implement fun acquireLock(name: String, ttlMs: Int, owner: String): Bool {
        val res = this.conn.query("
            INSERT INTO shedlock (name, locked_until, locked_by) VALUES ($1, now() + ($2 || ' milliseconds')::interval, $3)
            ON CONFLICT (name) DO UPDATE SET locked_until = EXCLUDED.locked_until, locked_by = EXCLUDED.locked_by
            WHERE shedlock.locked_until <= now() RETURNING name
        ", [name, ttlMs.toString(), owner])
        return res.rows().size() == 1
    }

    implement fun releaseLock(name: String, owner: String): Bool {
        val res = this.conn.execute("UPDATE shedlock SET locked_until = now() WHERE name = $1 AND locked_by = $2", [name, owner])
        return res.rowsAffected() == 1
    }

    // Single-flight: a pipeline with a queued/running job is not scheduled.
    fun hasActive(pipeline: String): Bool {
        val res = this.conn.query("SELECT 1 AS one FROM jobs WHERE pipeline = $1 AND status IN ('queued', 'running') LIMIT 1", [pipeline])
        return res.rows().size() > 0
    }

    fun fail(id: String, retryable: Bool, delayMs: Int): Bool {
        val status = if (retryable) { "queued" } else { "dead" }
        val res = this.conn.execute(
            "UPDATE jobs SET status = $1, not_before = now() + ($2 || ' milliseconds')::interval, updated_at = now() WHERE id = $3", 
            [status, delayMs.toString(), id]
        )
        return res.rowsAffected() == 1
    }

    fun insertRecord(jobId: String, connector: String, payload: String, sourceUrl: String, recordId: String): Bool {
        val res = this.conn.execute(
            "INSERT INTO records (id, job_id, connector, payload, source_url) VALUES ($1, $2, $3, $4::jsonb, $5)",
            [recordId, jobId, connector, payload, sourceUrl]
        )
        return res.rowsAffected() == 1
    }

    fun pendingCount(): Int {
        val res = this.conn.query("SELECT COUNT(*) AS n FROM jobs WHERE status = 'queued'")
        val rows = res.rows()
        if (rows.size() == 0) {
            return 0
        }
        return rows.get(0).int("n")
    }

    // Retention/admin helper; tests use it to reset fixed keys.
    fun deleteJob(id: String): Bool {
        this.conn.execute("DELETE FROM records WHERE job_id = $1", [id])
        this.conn.execute("DELETE FROM artifacts WHERE job_id = $1", [id])
        val res = this.conn.execute("DELETE FROM jobs WHERE id = $1", [id])
        return res.rowsAffected() == 1
    }

    implement fun close(): Void {
        this.conn.close()
    }
}
