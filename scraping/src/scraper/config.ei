// Service config: env-driven, validated at boot, fail fast.
// Missing or malformed values fail here, never half-boot.
import { Env } from "std.env"
import { List, MutableList } from "std.collections"
import { repeat } from "std.system"

type Config(
    val browserWorkers: List<String>,
    val databaseUrl: String,
    val concurrency: Int,
    val pollIntervalMs: Int,
    val artifactDir: String,
    val pipelinesDir: String,
    val captchaProviders: List<String> = [],
    val solverUrl: String = "",
    val solverKey: String = "",
    val scheduleIntervalMs: Int = 60000,
    val orphanTimeoutMs: Int = 600000
)

type InvalidConfig(val detail: String) : Throwable {
    implement fun message(): String {
        return this.detail
    }
}

fun splitCsv(raw: String): List<String> {
    val out: MutableList<String> = MutableList<String>()
    var cur = ""
    repeat(raw.length) { i ->
        val ch = raw.substring(i, i + 1)
        if (ch == ",") {
            if (cur != "") {
                out.add(cur)
            }
            cur = ""
        } else {
            cur = cur + ch
        }
    }
    if (cur != "") {
        out.add(cur)
    }
    return out.freeze()
}

fun digitValue(ch: String): Int {
    return "0123456789".indexOf(ch)
}

fun parsePositive(raw: String?): Int? {
    if (raw == null || raw == "") {
        return null
    }
    var n = 0
    var digits = 0
    var i = 0
    while (i < raw.length) {
        val d = digitValue(raw.substring(i, i + 1))
        if (d < 0) {
            return null
        }
        n = n * 10 + d
        digits = digits + 1
        i = i + 1
    }
    if (digits == 0) {
        return null
    }
    return n
}

// Env positive with default: absent/blank takes the fallback, present
// but malformed or non-positive throws. Typos stay fail-fast instead
// of silently defaulting.
fun envPositive(raw: String?, fallback: Int, name: String): Int {
    if (raw == null || raw == "") {
        return fallback
    }
    val parsed = parsePositive(raw)
    if (parsed == null || parsed!! <= 0) {
        return throw InvalidConfig(name + " must be a positive integer")
    }
    return parsed!!
}

fun loadConfig(): Config {
    val workersRaw = Env.get("BROWSER_WORKERS")
    if (workersRaw == null || workersRaw == "") {
        return throw InvalidConfig("set BROWSER_WORKERS (comma-separated worker ws URLs)")
    }
    val workers = splitCsv(workersRaw)
    if (workers.size() == 0) {
        return throw InvalidConfig("BROWSER_WORKERS is empty")
    }
    val db = Env.get("DATABASE_URL")
    if (db == null || db == "") {
        return throw InvalidConfig("set DATABASE_URL")
    }
    val concurrency = envPositive(Env.get("CONCURRENCY"), 4, "CONCURRENCY")
    val pollMs = envPositive(Env.get("POLL_INTERVAL_MS"), 1000, "POLL_INTERVAL_MS")
    val artifacts = Env.get("ARTIFACT_DIR")
    if (artifacts == null || artifacts == "") {
        return throw InvalidConfig("set ARTIFACT_DIR")
    }
    val pipelines = Env.get("PIPELINES_DIR")
    if (pipelines == null || pipelines == "") {
        return throw InvalidConfig("set PIPELINES_DIR")
    }
    val caps = splitCsv(Env.get("CAPTCHA_PROVIDERS") ?: "")
    val solverUrl = Env.get("SOLVER_URL") ?: ""
    val solverKey = Env.get("SOLVER_KEY") ?: ""
    val schedMs = envPositive(Env.get("SCHEDULER_INTERVAL_MS"), 60000, "SCHEDULER_INTERVAL_MS")
    // Reap threshold for running jobs of dead workers. Must exceed the
    // longest legitimate run (captcha solves take minutes).
    val orphanMs = envPositive(Env.get("ORPHAN_TIMEOUT_MS"), 600000, "ORPHAN_TIMEOUT_MS")
    return Config(workers, db, concurrency, pollMs, artifacts, pipelines, caps, solverUrl, solverKey, schedMs, orphanMs)
}
