// Scraper service entry: config → store → browser → run loop.
// Health/metrics serve in a background task; the main task claims jobs.
import { exit, park } from "std.system"
import { Log } from "std.log"
import { DbError } from "std.db"
import { Postgres } from "postgres"
import { Browser } from "browser.browser"
import { InvalidConfig, loadConfig } from ".scraper.config"
import { Store } from ".scraper.store"
import { Scraper } from ".scraper.scraper"
import { PipelineStore } from ".scraper.pipeline.store"

fun main() {
    try {
        val config = loadConfig()
        val store = Store(Postgres.connect(config.databaseUrl))
        store.migrate()
        val scraper = Scraper(config, store, Browser(config.browserWorkers, config.concurrency), PipelineStore(config.pipelinesDir))
        task {
            scraper.serveArest(9090)
        }
        task {
            scraper.run()
        }
        Log.info { "scraper boot: ${config.concurrency} workers, ${config.browserWorkers.size()} browser endpoint(s)" }
        park()
    } catch (e: InvalidConfig) {
        Log.error { "invalid config: ${e.message()}" }
        exit(1)
    } catch (e: DbError) {
        Log.error { "store unreachable: ${e.message}" }
        exit(1)
    }
}
