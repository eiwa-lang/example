import { ServerConnection } from "std.http"

import { ArestBuilder } from ".arest_builder"
import { HttpDispatcher } from "http_dispatcher"
import { McpDispatcher } from ".mcp.mcp_dispatcher"

type Dispatcher(
    val builder: ArestBuilder,
    val http: HttpDispatcher = HttpDispatcher(builder),
    val mcp: McpDispatcher = McpDispatcher(builder)
) {
    fun dispatch(conn: ServerConnection) {
        val req = conn.readRequest()
        if (req.path.startsWith("/mcp")) {
            mcp.dispatch(conn, req)
        } else {
            http.dispatch(conn, req)
        }
        conn.close()
    }
}
