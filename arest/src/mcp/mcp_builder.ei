import { MutableList } from "std.collections"

import { McpCall } from "mcp_call"

type McpTool(
    val name: String,
    var description: String = "",
    val handler: McpCall.() -> Void
)

type McpResource(
    val uri: String,
    var description: String = "",
    val handler: McpCall.() -> Void
)

type McpPrompt(
    val name: String,
    var description: String = "",
    val handler: McpCall.() -> Void
)

type McpBuilder(
    val tools: MutableList<McpTool?> = MutableList<McpTool?>(),
    val resources: MutableList<McpResource?> = MutableList<McpResource?>(),
    val prompts: MutableList<McpPrompt?> = MutableList<McpPrompt?>()
) {

    fun tool(name: String, handler: McpCall.() -> Void) {
        tools.add(McpTool(name, "", handler))
    }

    fun resource(uri: String, handler: McpCall.() -> Void) {
        resources.add(McpResource(uri, "", handler))
    }

    fun prompt(name: String, handler: McpCall.() -> Void) {
        prompts.add(McpPrompt(name, "", handler))
    }
}
