import { ArestBuilder } from "arest.server.arest_builder"
import { Argument, JsonType } from "arest.mcp.mcp_builder"
import { Docs } from ".mcp.docs"
import { LessonsData } from ".mcp.lessons_data"
import { ExamplesData } from ".mcp.examples_data"
import { StdlibData } from ".mcp.stdlib_data"

fun setupMcp(server: ArestBuilder) {
    server.mcp {
        name("Eiwa Language")
        version("1.0.0")
        instructions(
            "Official MCP documentation and specification server for the Eiwa programming language (https://eiwa.dev).\n" +
            "Eiwa is a statically typed, natively compiled language with Kotlin-inspired syntax.\n" +
            "CRITICAL ARCHITECTURE RULES:\n" +
            "1. NO class, open, abstract, or override keywords exist.\n" +
            "2. Type system is 100% composition-based: type, contract, skill, object, implement.\n" +
            "3. Stackless coroutines: task {} and .await().\n" +
            "4. All APIs are explicitly declared in std/.\n" +
            "5. Standard library APIs to work with mcp, http, ai, html and etc are declared in std and Arest framework.\n" +
            "6. Complete per-module std API references (100% of methods) are available via the list_std_modules and get_std_module tools."
        )

        // Resources
        resource("eiwa://spec/overview") {
            respond(Docs.overview())
        }

        resource("eiwa://spec/type-system") {
            respond(Docs.typeSystem())
        }

        resource("eiwa://spec/platform-parity") {
            respond(Docs.section20PlatformParity())
        }

        resource("eiwa://spec/coroutines") {
            respond(Docs.coroutines())
        }

        resource("eiwa://spec/syntax-rules") {
            respond(Docs.syntaxRules())
        }

        resource("eiwa://spec/stdlib") {
            respond(Docs.stdlib())
        }

        resource("eiwa://spec/std-time") {
            respond(StdlibData.get("time"))
        }

        resource("eiwa://spec/std/core") {
            respond(StdlibData.get("core"))
        }

        resource("eiwa://spec/std/collections") {
            respond(StdlibData.get("collections"))
        }

        resource("eiwa://spec/std/math") {
            respond(StdlibData.get("math"))
        }

        resource("eiwa://spec/std/system") {
            respond(StdlibData.get("system"))
        }

        resource("eiwa://spec/std/exceptions") {
            respond(StdlibData.get("exceptions"))
        }

        resource("eiwa://spec/std/io") {
            respond(StdlibData.get("io"))
        }

        resource("eiwa://spec/std/fs") {
            respond(StdlibData.get("fs"))
        }

        resource("eiwa://spec/std/env") {
            respond(StdlibData.get("env"))
        }

        resource("eiwa://spec/std/log") {
            respond(StdlibData.get("log"))
        }

        resource("eiwa://spec/std/random") {
            respond(StdlibData.get("random"))
        }

        resource("eiwa://spec/std/time") {
            respond(StdlibData.get("time"))
        }

        resource("eiwa://spec/std/money") {
            respond(StdlibData.get("money"))
        }

        resource("eiwa://spec/std/uuid") {
            respond(StdlibData.get("uuid"))
        }

        resource("eiwa://spec/std/ulid") {
            respond(StdlibData.get("ulid"))
        }

        resource("eiwa://spec/std/regex") {
            respond(StdlibData.get("regex"))
        }

        resource("eiwa://spec/std/json") {
            respond(StdlibData.get("json"))
        }

        resource("eiwa://spec/std/serde") {
            respond(StdlibData.get("serde"))
        }

        resource("eiwa://spec/std/yaml") {
            respond(StdlibData.get("yaml"))
        }

        resource("eiwa://spec/std/jsonrpc") {
            respond(StdlibData.get("jsonrpc"))
        }

        resource("eiwa://spec/std/http") {
            respond(StdlibData.get("http"))
        }

        resource("eiwa://spec/std/net") {
            respond(StdlibData.get("net"))
        }

        resource("eiwa://spec/std/db") {
            respond(StdlibData.get("db"))
        }

        resource("eiwa://spec/std/coroutines") {
            respond(StdlibData.get("coroutines"))
        }

        resource("eiwa://spec/std/thread") {
            respond(StdlibData.get("thread"))
        }

        resource("eiwa://spec/std/atomic") {
            respond(StdlibData.get("atomic"))
        }

        resource("eiwa://spec/std/process") {
            respond(StdlibData.get("process"))
        }

        resource("eiwa://spec/stdlib/all") {
            respond(StdlibData.list())
        }

        resource("eiwa://spec/packages") {
            respond(Docs.packages())
        }

        resource("eiwa://spec/cli") {
            respond(Docs.cli())
        }

        resource("eiwa://spec/lessons") {
            respond(LessonsData.list())
        }

        resource("eiwa://spec/examples") {
            respond(ExamplesData.list())
        }

        // Tools
        tool("list_lessons") {
            respond(LessonsData.list())
        }

        tool("get_lesson", description = "Get a language tour lesson by number or name", arguments = [
            Argument("lesson", JsonType.STRING, "Lesson number, slug, or name (e.g. '1', '12', 'tasks', 'compositionobject')", true),
            Argument("id", JsonType.STRING, "Alias for lesson (kept for compatibility)", false)
        ]) {
            val query = hasArgument("lesson") ? argument("lesson")!!.asString() : (hasArgument("id") ? argument("id")!!.asString() : "")
            if (query == "") {
                error("Missing required parameter 'lesson' (e.g. '1', '12', 'tasks', 'compositionobject').")
            } else {
                respond(LessonsData.get(query))
            }
        }

        tool("list_examples") {
            respond(ExamplesData.list())
        }

        tool("get_example", description = "Get a functional example by topic (http, http_client, html, tasks, postgres, mcp, time, money, tests, platform, regex, json, uuid, ulid)", arguments = [
            Argument("topic", JsonType.STRING, "Example topic (http, html, mcp, tasks, postgres, money, tests, time)", true),
            Argument("name", JsonType.STRING, "Alias for topic (kept for compatibility)", false)
        ]) {
            val topic = hasArgument("topic") ? argument("topic")!!.asString() : (hasArgument("name") ? argument("name")!!.asString() : "http")
            respond(ExamplesData.get(topic))
        }

        tool("list_doc_topics") {
            respond(Docs.listTopics())
        }

        tool("get_doc_topic", description = "Get a documentation section", arguments = [
            Argument("topic", JsonType.STRING, "Documentation section (overview, type-system, platform-parity, coroutines, syntax-rules, stdlib, cli)", true),
            Argument("section", JsonType.STRING, "Alias for topic (kept for compatibility)", false)
        ]) {
            val topic = hasArgument("topic") ? argument("topic")!!.asString() : (hasArgument("section") ? argument("section")!!.asString() : "overview")
            respond(Docs.getSection(topic))
        }

        tool("list_tour_section") {
            respond(Docs.listTourSections())
        }

        tool("get_tour_section", description = "Get a language tour section by number", arguments = [
            Argument("section", JsonType.STRING, "Tour section number (1-20)", true),
            Argument("number", JsonType.STRING, "Alias for section (kept for compatibility)", false)
        ]) {
            val section = hasArgument("section") ? argument("section")!!.asString() : (hasArgument("number") ? argument("number")!!.asString() : "1")
            respond(Docs.getSection(section))
        }

        tool("get_syntax_rules") {
            respond(Docs.syntaxRules())
        }

        tool("list_std_modules") {
            respond(StdlibData.list())
        }

        tool("get_std_module", description = "Get the complete API reference for one std module (100% of methods)", arguments = [
            Argument("module", JsonType.STRING, "Std module (core, collections, math, system, exceptions, io, fs, env, log, random, time, money, uuid, ulid, regex, json, serde, yaml, jsonrpc, http, net, db, coroutines, thread, atomic, process)", true),
            Argument("name", JsonType.STRING, "Alias for module (kept for compatibility)", false)
        ]) {
            val module = hasArgument("module") ? argument("module")!!.asString() : (hasArgument("name") ? argument("name")!!.asString() : "")
            if (module == "") {
                error("Missing required parameter 'module' (e.g. 'random', 'money', 'time').")
            } else {
                respond(StdlibData.get(module))
            }
        }

        // Prompts
        prompt("eiwa_expert") {
            respond(
                "You are an expert systems programmer in Eiwa (https://eiwa.dev).\n" +
                "Follow these strict language rules:\n" +
                "1. NEVER use `class`, `open`, `abstract`, or `override` — they do not exist. Use `type`, `contract`, `skill`, `object`, `implement`.\n" +
                "2. Operator overloads REQUIRE the `operator` modifier (`operator fun plus(...)`).\n" +
                "3. Concurrency is stackless: `task { ... }` + `.await()`; no top-level `sleep` in std.coroutines (use `std.system` sleep/sleepMs or `Coroutine.sleepMs`).\n" +
                "4. Enforce strict null safety (`Type?`, `?.`, `?:`, `!!`).\n" +
                "5. Money builders take Int minor units (`brl(14990)`), format with `format()` (no `formatted()`, no Double args).\n" +
                "6. JSON: types use `: Serializable + Json`, `toJson()` / `fromJson<T>()` (no `Json.encode/decode`).\n" +
                "7. Time: `now()/nowMillis()/date()`, `.sec` epoch seconds (no `Clock.System`, no `Time.now()/elapsed()/toMillis()`).\n" +
                "8. Only use std APIs from `get_std_module` / `eiwa://spec/std/<module>`; `postgres`/`arest`/`html` are external packages, not `std.*`."
            )
        }

        prompt("port_kotlin") {
            respond(
                "You are porting Kotlin/JVM code to Eiwa (https://eiwa.dev).\n" +
                "Mapping rules: `Clock.System.now().toEpochMilliseconds()` -> `nowMillis()` (`std.time`); `/ 86400000L` days -> `nowMillis() / 86400000` or `now().sec / 86400`. " +
                "`runCatching { f() }.getOrNull()` -> bare value-`try { f() }` (`T?`). " +
                "Kotlin `map/filter` on lists -> value-position `for (list) { ... }` (null yields are skipped). " +
                "Kotlin `class/open/override` -> Eiwa `type` + `contract` + `skill` + `implement`. " +
                "Kotlin `BigDecimal` money -> `std.money` minor-unit `Money` (`brl(cents)`, `format()`). " +
                "Kotlin `UUID.randomUUID()` -> `Uuid.v4()`; `kotlinx.datetime` formatting -> `Time.format(\"YYYY-MM-DD HH:mm:ss\")`. " +
                "Always verify signatures via `get_std_module` before emitting code."
            )
        }

        prompt("explain_concept") {
            val topic = hasArgument("topic") ? argument("topic")!!.asString() : "composition"
            respond(
                "Explain the concept of '$topic' in the Eiwa programming language.\n" +
                "Contrast it with other languages (Kotlin, Rust, Go, TypeScript) and provide a concise, working code example."
            )
        }
    }
}
