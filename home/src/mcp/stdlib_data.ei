object StdlibData {
    fun list(): String {
        return "# Eiwa Standard Library - 26 Modules\n\n" +
            "Use `get_std_module` with one of:\n" +
            "- `core` — Primitive types (String, Int, Double, Bool, Pointer), contracts, Scope skill\n" +
            "- `collections` — List, MutableList, Map, MutableMap, Set, MutableSet, String.split\n" +
            "- `math` — Math object (sin/cos/tan/sqrt/pow/abs/floor/ceil/round) + mod\n" +
            "- `system` — loop, repeat, retry, sleep, sleepMs, yield, exit\n" +
            "- `exceptions` — Throwable, Exception, AssertionException, error, assert\n" +
            "- `io` — print, println, echo, printWelcome, Echoable\n" +
            "- `fs` — File (read/write/delete/exists)\n" +
            "- `env` — Env (load/get/set/unset/exists) + env() helpers, .env loader\n" +
            "- `log` — Log/Logger/LogLevel, TextFormatter/JsonFormatter\n" +
            "- `random` — Random + SeededRandom (nextInt/nextDouble/nextBool/nextPercent/choice/shuffle/seeded)\n" +
            "- `time` — Time, Duration, now/date/hours/minutes/seconds/nowMillis/daysInMonth\n" +
            "- `money` — Money, Currency, Currencies, money/brl/usd/... helpers\n" +
            "- `uuid` — Uuid (v4/v7/generate/parse/version) + Identifier contract\n" +
            "- `ulid` — Ulid (generate/parse/timestamp) + decodeCrockford/crockfordVal\n" +
            "- `regex` — Regex, MatchResult, String.matchesRegex/findRegex/replaceRegex\n" +
            "- `json` — JsonValue, JsonParser, parseJson, Json skill, serializeJson/fromJson\n" +
            "- `serde` — Serializable, SerdeValue/SerdeObject/SerdeList, asString/asInt/asDouble/asBool, deserializeList\n" +
            "- `yaml` — Yaml skill (toYaml/writeYaml/...)\n" +
            "- `jsonrpc` — JsonRpc (argument*/response/errorResponse/parse)\n" +
            "- `http` — Client (get/post), Server, ServerConnection, Request/Response, urlEncode\n" +
            "- `net` — Socket, SocketClient, TCPServer\n" +
            "- `db` — Row/Result/Statement/Connection contracts, DbError, BoundStatement, ConnectionPool\n" +
            "- `coroutines` — task, StackTask (await/isDone), Scheduler, Dispatchers, Coroutine, EventLoop\n" +
            "- `thread` — Thread, Mutex, RawMutex, CondVar, Threads, sync\n" +
            "- `atomic` — AtomicBool, AtomicInt\n" +
            "- `process` — Process (exec/capture/chdir/realpath/args) + platform parity objects"
    }

    fun get(module: String): String {
        if (module == "core" || module == "std.core") {
            return "## std.core — Primitive Types & Base Contracts\n\n" +
                "Contracts: `Stringable { fun toString(): String }`, `Equatable { operator fun equals(other: Equatable): Bool }`, " +
                "`Hashable { fun hashCode(): Int }`, `Runnable { fun run() }`, `Closeable { fun close() }`, " +
                "`Awaitable<T> { fun await(): T; fun isDone(): Bool }`.\n\n" +
                "Skill `Scope<T>`: `let<R>(block: (T) -> R): R`, `also(block: (T) -> Void): T`, `apply(block: (T) -> Void): T`, " +
                "`run<R>(block: (T) -> R): R`, `takeIf(predicate: (T) -> Bool): T?`, `takeUnless(predicate: (T) -> Bool): T?`.\n" +
                "Top-level: `with<T, R>(receiver: T, block: (T) -> R): R`, `use<T>(receiver: T, block: (T) -> Void): Void` (closes Closeable).\n\n" +
                "`Pointer`: `readByte(index: Int): Int`, `writeByte(index: Int, value: Int): Void`. " +
                "`IntVar(ptr)`: `get(): Int`, `set(value: Int): Void`. `Memory.alloc<T>(block: (T) -> Void): T`.\n\n" +
                "`String`: `toString()`, `equals()`, `plus(other: Stringable): String`, `replace(old: String, newStr: String): String`, " +
                "`indexOf(needle: String): Int`, `contains(other: String): Bool`, `startsWith(prefix: String): Bool`, " +
                "`endsWith(suffix: String): Bool`, `substring(start: Int, end: Int): String`, `charAt(index: Int): String`, " +
                "`trim(): String`, `toDouble(): Double`, `toInt(): Int`, `isEmpty(): Bool`, `isNotEmpty(): Bool`, " +
                "`lowercase(): String`, `uppercase(): String`, `hashCode(): Int`.\n\n" +
                "`Int`: `toString()`, `hashCode()`, `equals()`, `toDouble(): Double`, `toInt(): Int`. " +
                "`Double`: `toString()`, `hashCode()`, `equals()`, `toInt(): Int`, `toDouble(): Double`. " +
                "`Bool`: `toString()`, `hashCode()`, `equals()`.\n\n" +
                "```kotlin\nval s = \"Eiwa\"\nprintln(s.uppercase())\nprintln(s.substring(0, 2))\nprintln(s.contains(\"wa\"))\n```"
        }
        if (module == "collections" || module == "std.collections") {
            return "## std.collections — Lists, Maps, Sets\n\n" +
                "`MutableList<T>`: `add(element: T): Void`, `add(elements: List<T>): Void` (in-place concat, Kotlin `addAll`), " +
                "`addAll(elements: List<T>): Void` (alias), `plus(element: T): List<T>` (operator `+`, NEW list), " +
                "`plus(other: List<T>): List<T>` (operator `+`, NEW list), " +
                "`get(index: Int): T`, `set(index: Int, element: T): Void`, " +
                "`remove(index: Int): Void`, `size(): Int`, `isEmpty(): Bool`, `isNotEmpty(): Bool`, `freeze(): List<T>`, `contains(element: T): Bool`.\n\n" +
                "`List<T>`: `plus(element: T): List<T>` (operator `+`, NEW list), `plus(other: List<T>): List<T>` (operator `+`, NEW list), " +
                "`get(index: Int): T`, `size(): Int`, `isEmpty(): Bool`, `isNotEmpty(): Bool`, `contains(element: T): Bool`, `mut(): MutableList<T>`.\n\n" +
                "Concat rules: `+` NEVER mutates — it always returns a new `List<T>`. `add`/`addAll` take an immutable `List<T>`; " +
                "append a `MutableList<T>` via `.freeze()` first (`all.add(other.freeze())`). " +
                "Overload resolution is by type: `m.add(2)` appends one element, `m.add([2])` appends the contents.\n\n" +
                "`MutableMap<K, V>`: `put(key: K, value: V): Void` (operator `m[k] = v`), `get(key: K): V?` (operator `m[k]`), " +
                "`contains(key: K): Bool`, `size(): Int`, `isEmpty(): Bool`, `isNotEmpty(): Bool`, `freeze(): Map<K, V>`, `keys()`, `values()`.\n\n" +
                "`Map<K, V>`: `get(key: K): V?`, `contains(key: K): Bool`, `size(): Int`, `isEmpty(): Bool`, `isNotEmpty(): Bool`, " +
                "`mut(): MutableMap<K, V>`, `keys()`, `values()`. `MapKeys/MapValues`: `size()`, `isEmpty()`, `isNotEmpty()`.\n\n" +
                "`MutableSet<T>`: `add(element: T): Void`, `contains(element: T): Bool`, `size(): Int`, `isEmpty()`, `isNotEmpty()`, `freeze(): Set<T>`. " +
                "`Set<T>`: `contains(element: T): Bool`, `size(): Int`, `isEmpty()`, `isNotEmpty()`, `mut(): MutableSet<T>`.\n\n" +
                "Extension: `String.split(delimiter: String): List<String>` (keeps empty parts; whole string when delimiter absent/empty).\n\n" +
                "```kotlin\nimport { MutableList, MutableMap } from \"std.collections\"\n\nval m = MutableMap<String, Int>()\nm[\"a\"] = 1\nval frozen = m.freeze()\nprintln(\"a\".split(\"x\").size())\n\nval all = [1, 2].mut()\nall.add([3, 4])\nall.addAll([5])\nprintln(all.freeze())\nprintln([1, 2] + [3, 4])\n```"
        }
        if (module == "math" || module == "std.math") {
            return "## std.math — Native Math + mod\n\n" +
                "`Math`: `sin(x: Double): Double`, `cos(x: Double): Double`, `tan(x: Double): Double`, `sqrt(x: Double): Double`, " +
                "`pow(base: Double, exp: Double): Double`, `abs(x: Double): Double`, `floor(x: Double): Double`, " +
                "`ceil(x: Double): Double`, `round(x: Double): Double`.\n\n" +
                "Top-level: `mod(a: Int, b: Int): Int` (sign follows dividend; used by random/time/ulid).\n\n" +
                "```kotlin\nimport { Math } from \"std.math\"\nimport { mod } from \"std.math\"\n\nprintln(Math.sqrt(16.0))\nprintln(mod(7, 3))\n```"
        }
        if (module == "system" || module == "std.system") {
            return "## std.system — Loops, Sleep, Exit\n\n" +
                "`loop(block: () -> Void)` (infinite), `repeat(count: Int, block: (Int) -> Void)`, " +
                "`retry(times: Int, block: (Int) -> Void)` (rethrows last Throwable), " +
                "`sleep(seconds: Int): Void`, `sleepMs(ms: Int): Void`, `yield(): Void`, `exit(code: Int): Void`.\n\n" +
                "```kotlin\nrepeat(3) { i -> println(i) }\nretry(3) { attempt -> println(attempt) }\n```"
        }
        if (module == "exceptions" || module == "std.exceptions") {
            return "## std.exceptions — Throwable & Assertions\n\n" +
                "`Throwable { fun message(): String }` (any type implementing it is throwable). " +
                "`Exception(val text: String) : Throwable`, `AssertionException(val text: String) : Throwable`.\n\n" +
                "`error(msg: String): Void` (throws), `assert(condition: Bool, message: String = \"Assertion failed\")`.\n\n" +
                "```kotlin\ntype AppError(val msg: String) : Throwable {\n    implement fun message(): String = msg\n}\n\ntry {\n    throw AppError(\"boom\")\n} catch (e: AppError) {\n    println(e.message())\n}\n```"
        }
        if (module == "io" || module == "std.io") {
            return "## std.io — Console Output\n\n" +
                "`print(value: Stringable?)`, `println(value: Stringable?)`, `println()` (blank line), " +
                "`echo(value: Stringable?)` (alias of println), `printWelcome()` (Eiwa banner). " +
                "Skill `Echoable : Stringable { fun echo() }` (prints itself via println).\n\n" +
                "```kotlin\nprint(\"hi\")\nprintln(\"hi\")\necho(\"hi\")\n```"
        }
        if (module == "fs" || module == "std.fs") {
            return "## std.fs — File I/O\n\n" +
                "`File(path: String)`: `read(): String`, `write(content: String): Bool`, `delete(): Bool`, `exists(): Bool`. " +
                "Companion shortcuts: `File.read(path: String)`, `File.write(path: String, content: String)`, " +
                "`File.delete(path: String)`, `File.exists(path: String)`.\n\n" +
                "```kotlin\nimport { File } from \"std.fs\"\n\nFile.write(\"hello.txt\", \"hi\")\nprintln(File.read(\"hello.txt\"))\n```"
        }
        if (module == "env" || module == "std.env") {
            return "## std.env — Environment & .env Loader\n\n" +
                "`Env.load(path: String? = null): Bool` (parses `.env` by default; handles quotes, comments, CRLF), " +
                "`Env.parseLine(line: String): Void`, `Env.trim(s: String): String`, `Env.isWhitespace(c: String): Bool`, " +
                "`Env.exists(key: String): Bool`, `Env.set(key: String, value: String): Bool`, `Env.unset(key: String): Bool`, " +
                "`Env.get(key: String): String?`, `Env.get(key: String, defaultValue: String): String`, " +
                "`Env.get(key: String, defaultValue: Int): Int`, `Env.get(key: String, defaultValue: Bool): Bool` " +
                "(true values: `true`/`1`/`yes`/`on`).\n\n" +
                "Helpers: `env(key: String): String?`, `env(key, defaultValue: String)`, `env(key, defaultValue: Int)`, `env(key, defaultValue: Bool)`.\n\n" +
                "```kotlin\nimport { Env } from \"std.env\"\n\nval port = Env.get(\"PORT\", \"8080\")\nprintln(\"Port: \$port\")\n```"
        }
        if (module == "log" || module == "std.log") {
            return "## std.log — Structured Logging\n\n" +
                "`enum LogLevel { TRACE, DEBUG, INFO, WARN, ERROR, OFF }`. " +
                "`LogFormatter { fun format(level: LogLevel, message: String, throwable: Throwable?, fields: Map<String, String>): String }`.\n\n" +
                "`StandardLogFormatter(useColors: Bool = true)`, `JsonLogFormatter()`. " +
                "`Logger`: `setLevel`, `setFormatter`, `with(key: String, value: String): Logger`, `withFields(extraFields: Map<String, String>): Logger`, " +
                "`isEnabled(targetLevel: LogLevel): Bool`, `log(targetLevel, message, throwable? = null)`, " +
                "`trace/debug/info/warn/error(msgFn: () -> String)`, `warn(throwable, msgFn)`, `error(throwable, msgFn)`.\n\n" +
                "`Log` facade: `setLevel`, `setFormatter`, `with`, `withFields`, `trace/debug/info/warn/error` (same signatures).\n\n" +
                "```kotlin\nimport { Log } from \"std.log\"\n\nLog.info { \"Server starting\" }\nLog.with(\"port\", \"8080\").info { \"listening\" }\n```"
        }
        if (module == "random" || module == "std.random") {
            return "## std.random — CSPRNG + Seeded Generators + Collections\n\n" +
                "Contract `RandomProvider { fun nextRawBits(): Int }`. " +
                "Skill `RandomOps : RandomProvider` (shared by `Random` and `SeededRandom`):\n" +
                "- `nextInt(): Int` (non-negative full-range)\n" +
                "- `nextInt(min: Int, max: Int): Int` (inclusive range; returns min when min >= max)\n" +
                "- `nextPercent(): Int` (0..100 inclusive)\n" +
                "- `nextDouble(): Double` (0.0..<1.0)\n" +
                "- `nextDouble(min: Double, max: Double): Double` (returns min when min >= max)\n" +
                "- `nextBool(): Bool`\n" +
                "- `choice<T>(list: List<T>): T?` (null when empty)\n" +
                "- `shuffle<T>(list: List<T>): List<T>` (Fisher-Yates, returns NEW list)\n\n" +
                "`object Random : RandomProvider + RandomOps` (CSPRNG via `NativeMemory.randomBytes`) + `seeded(seed: Int): SeededRandom`. " +
                "`type SeededRandom(var state: Int) : RandomProvider + RandomOps` (deterministic LCG; state 0 reseeds to 12345).\n\n" +
                "```kotlin\nimport { Random } from \"std.random\"\n\nval roll = Random.nextInt(1, 6)\nval coin = Random.nextBool()\nval pct = Random.nextPercent()\nval f = Random.nextDouble(0.0, 1.0)\nval pick = Random.choice([\"a\", \"b\", \"c\"])\nval deck = Random.shuffle([1, 2, 3])\nval rng = Random.seeded(42)\nprintln(\"\$roll \$coin \$pct\")\n```"
        }
        if (module == "time" || module == "std.time") {
            return "## std.time — Epoch Timestamps & Durations\n\n" +
                "Epoch-first design: `Time` is a zero-overhead wrapper around Unix epoch seconds. " +
                "There is NO `Clock.System` in Eiwa, NO `Time.now()`, NO `elapsed()`, NO `toMillis()`.\n\n" +
                "Full signatures (from `src/std/time.ei`):\n" +
                "- `type Time(val sec: Int)`: `second(): Int`, `minute(): Int`, `hour(): Int`, `year(): Int`, " +
                "`month(): Int`, `day(): Int`, `format(pattern: String): String` (tokens YYYY/MM/DD/HH/mm/ss), " +
                "`plus(duration: Duration): Time` (operator `+`), `minus(other: Time): Duration` (operator `-`), " +
                "`pad(value: Int): String`, `serialize(): SerdeValue`, `toString(): String` (`YYYY-MM-DD HH:mm:ss`)\n" +
                "- `type Duration(val seconds: Int)`: `minutes(): Int` (seconds/60), `hours(): Int` (seconds/3600)\n" +
                "- `fun now(): Time` (epoch seconds via `NativeTime.time`), `fun nowMillis(): Int` (epoch millis via `eiwa_now_millis`)\n" +
                "- `fun date(year: Int, month: Int, day: Int): Time` (midnight UTC)\n" +
                "- `fun hours(h: Int): Duration`, `fun minutes(m: Int): Duration`, `fun seconds(s: Int): Duration`\n" +
                "- `fun daysInMonth(m: Int, isLeap: Bool): Int`\n\n" +
                "Porting Kotlin `Clock.System.now().toEpochMilliseconds() / 86400000L`:\n" +
                "- `nowMillis() / 86400000` (millis -> days) OR `now().sec / 86400` (seconds -> days).\n\n" +
                "```kotlin\nimport { now, date, hours } from \"std.time\"\n\nval base = date(2026, 7, 20)\nval deadline = base + hours(2)\nprintln(deadline.format(\"YYYY-MM-DD HH:mm:ss\"))\nprintln((deadline - base).hours())\n```\n\n" +
                "Example (a) — days since epoch for daily rotation:\n" +
                "```kotlin\nimport { now, nowMillis } from \"std.time\"\n\nval daysA = nowMillis() / 86400000\nval daysB = now().sec / 86400\nval rotation = daysB % 7\nprintln(\"Day index: \$daysB, rotation slot: \$rotation\")\n```\n\n" +
                "Example (b) — formatting YYYY-MM-DD HH:mm:ss:\n" +
                "```kotlin\nimport { now, date } from \"std.time\"\n\nprintln(now().format(\"YYYY-MM-DD HH:mm:ss\"))\nprintln(date(2026, 7, 20).format(\"YYYY-MM-DD HH:mm:ss\"))\nprintln(now().toString())\n```"
        }
        if (module == "money" || module == "std.money") {
            return "## std.money — Currency-Safe Arithmetic (minor units)\n\n" +
                "`Currency(code, name, symbol, decimals, decimalSeparator = \".\", thousandSeparator = \"\")`: " +
                "`equals(other: Currency): Bool`, `formatAmount(cents: Int): String`.\n\n" +
                "`Currencies`: BRL ARS CLP COP PEN UYU PYG BOB VES USD CAD MXN CRC DOP GTQ HNL NIO PAB JMD TTD " +
                "EUR GBP JPY CHF AUD NZD CNY HKD SGD KRW INR SEK NOK DKK PLN TRY AED SAR ILS ZAR.\n\n" +
                "`Money(cents: Int, currency: Currency)`: `plus/minus` (operator `+`/`-`, throws on currency mismatch), " +
                "`times(factor: Int)` (operator `*`), `equals`, `isZero()`, `isPositive()`, `isNegative()`, " +
                "`allocate(ratios: List<Int>): List<Money>` (Fowler, preserves exact sum), `split(parts: Int): List<Money>`, `format(): String`.\n\n" +
                "Builders take MINOR units: `money(cents, currency)`, `brl/cop/pen/uyu/bob/ves/usd/cad/mxn/crc/dop/gtq/hnl/nio/pab/jmd/ttd/eur/gbp/chf/aud/nzd/cny/hkd/sgd/inr/sek/nok/dkk/pln/tryLira/aed/sar/ils/zar(cents)`, " +
                "zero-decimal: `clp/pyg/jpy/krw(amount)`.\n\n" +
                "```kotlin\nimport { brl } from \"std.money\"\n\nval total = brl(14990) + brl(1000)\nprintln(total.format())\nprintln(brl(1000).split(3)[0].format())\n```"
        }
        if (module == "uuid" || module == "std.uuid") {
            return "## std.uuid — RFC 4122 UUIDs\n\n" +
                "`contract Identifier { fun toString(): String; fun toBytes(): List<Int> }`.\n\n" +
                "`Uuid(bytes: List<Int>) : Identifier`: `toString(): String` (canonical 8-4-4-4-12 lowercase), " +
                "`toBytes(): List<Int>`, `version(): Int`, `equals()`.\n\n" +
                "Companion: `generate(): Uuid` (= v7), `v7(): Uuid` (time-ordered), `v4(): Uuid` (random), `parse(str: String): Uuid?` " +
                "(null unless 36 chars with dashes). Helpers: `parseHexByte(hex: String): Int`, `hexCharToInt(c: String): Int`.\n\n" +
                "```kotlin\nimport { Uuid } from \"std.uuid\"\n\nval id = Uuid.v4()\nprintln(id.toString())\nprintln(id.version())\n```"
        }
        if (module == "ulid" || module == "std.ulid") {
            return "## std.ulid — Sortable 128-bit ULIDs (Crockford Base32)\n\n" +
                "`Ulid(bytes: List<Int>) : Identifier`: `toString(): String` (26-char Crockford), `toBytes(): List<Int>`, " +
                "`timestamp(): Int` (48-bit ms prefix), `equals()`.\n\n" +
                "Companion: `generate(): Ulid` (millis prefix + CSPRNG), `parse(str: String): Ulid?` (null unless 26 chars decode to 16 bytes). " +
                "Helpers: `decodeCrockford(str: String): MutableList<Int>?`, `crockfordVal(c: String): Int`.\n\n" +
                "```kotlin\nimport { Ulid } from \"std.ulid\"\n\nval id = Ulid.generate()\nprintln(id.toString())\n```"
        }
        if (module == "regex" || module == "std.regex") {
            return "## std.regex — Pure-Eiwa Regex Engine\n\n" +
                "`MatchResult(start, end, value, groups)`: `group(index: Int): String`, `groupCount(): Int` (groups.size() - 1).\n\n" +
                "`Regex(pattern: String)`: `ensureCompiled()`, `newCaps()`, `resetCaps(caps)`, `buildResult(input, start, end, caps)`, " +
                "`matches(input: String): Bool` (FULL match), `findFrom(input: String, fromPos: Int): MatchResult?`, " +
                "`find(input: String): MatchResult?`, `findAll(input: String): List<MatchResult>`, `replace(input: String, replacement: String): String`.\n\n" +
                "String extensions: `String.matchesRegex(pattern: String): Bool`, `String.findRegex(pattern: String): MatchResult?`, " +
                "`String.findAllRegex(pattern: String): List<MatchResult>`, `String.replaceRegex(pattern: String, replacement: String): String`.\n\n" +
                "```kotlin\nimport { Regex } from \"std.regex\"\n\nprintln(Regex(\"[0-9]+\").find(\"abc123\")?.value)\nprintln(\"hello\".replaceRegex(\"l+\", \"L\"))\n```"
        }
        if (module == "json" || module == "std.json") {
            return "## std.json — Reflectionless JSON\n\n" +
                "`enum JsonKind { OBJECT, ARRAY, STRING, NUMBER, BOOL, NULL }`.\n\n" +
                "`JsonValue`: `isObject/isArray/isString/isNumber/isBool/isNull(): Bool`, `get(key: String): JsonValue?`, " +
                "`getIndex(index: Int): JsonValue?`, `asString(): String`, `asNumber(): Double`, `asBool(): Bool`, " +
                "`asObject(): Map<String, JsonValue>`, `asArray(): List<JsonValue>`, `toSerdeObject()`, `toSerde()`, `write(): String`, " +
                "`writeString(s)`, `writeObject()`, `writeArray()`.\n\n" +
                "Builders: `jsonEscape(s)`, `jsonObject(map)`, `jsonArray(list)`, `jsonString(s)`, `jsonNumber(d)`, `jsonBool(b)`, `jsonNull()`.\n\n" +
                "`JsonParser(source, pos)`: `parse()`, `parseValue()`, `skipWhitespace()`, `expect(word)`, `parseString()`, " +
                "`parseNumber()`, `parseObject()`, `parseArray()`. `parseJson(source: String): JsonValue`.\n\n" +
                "Skill `Json : Serializable`: `escapeJsonString(s)`, `toJson()`, `writeJson(fields)`, `writeJsonValue(v)`, `writeJsonList(list)`. " +
                "`serializeJson(obj)`, `serializeJsonFields(fields)`, `serializeJsonValue(v)`, `serializeJsonList(list)`, " +
                "`parseJsonToSerde(raw)`, `fromJson<T>(raw: String): T`.\n\n" +
                "```kotlin\nimport { parseJson } from \"std.json\"\n\nval v = parseJson(\"{\\\"a\\\": 1}\")\nprintln(v.get(\"a\")?.asNumber())\n```"
        }
        if (module == "serde" || module == "std.serde") {
            return "## std.serde — Serialization Contracts\n\n" +
                "`Serializable { fun serialize(): SerdeValue }`, `Deserializable<T> { fun deserialize(value: SerdeValue): T }`, " +
                "`SerdeValue`, `SerdeList { fun size(): Int; fun getAt(index: Int): SerdeValue }`.\n\n" +
                "`SerdeNull/SerdeInt(v)/SerdeDouble(v)/SerdeBool(v)/SerdeString(v)/SerdeListValue(list) : SerdeValue`. " +
                "`SerdeObject(fields)`: `get(name)`, `getString(name)`, `getInt(name)`, `getDouble(name)`, `getBool(name)`, `getObject(name)`, `getList(name)`.\n\n" +
                "`SerdeIntList/SerdeDoubleList/SerdeBoolList/SerdeStringList/SerdeObjectList<T>/SerdeGenericList<T>(list) : SerdeList`.\n\n" +
                "Helpers: `asSerdeObject(v)`, `asString(v)`, `asInt(v)`, `asDouble(v)`, `asBool(v)`, `asSerdeList(v): SerdeList?`, " +
                "`deserializeList<T>(serdeList, mapper: (SerdeValue) -> T): List<T>`."
        }
        if (module == "yaml" || module == "std.yaml") {
            return "## std.yaml — YAML Encoding (skill)\n\n" +
                "Skill `Yaml : Serializable`: `toYaml(): String`, `writeYaml(fields: List<SerdeField>): String`, " +
                "`writeYamlBlock(fields, indent: String): String`, `writeYamlValueSuffix(v, indent: String)`, " +
                "`writeYamlList(list, indent: String)`, `writeYamlListItem(v, indent: String)`, `writeYamlScalar(v)`."
        }
        if (module == "jsonrpc" || module == "std.jsonrpc") {
            return "## std.jsonrpc — JSON-RPC Message\n\n" +
                "`JsonRpc(id: JsonValue, method: String, params: JsonValue)`: `argument(name: String): JsonValue?`, " +
                "`argumentString(name: String): String`, `argumentInt(name: String): Int`, `argumentDouble(name: String): Double`, " +
                "`argumentBool(name: String): Bool`, `response(result: String): String`, `errorResponse(code: Int, message: String): String`, " +
                "companion `parse(body: String): JsonRpc`."
        }
        if (module == "http" || module == "std.http") {
            return "## std.http — HTTP Client & Socket Server\n\n" +
                "`Response(status: Int, body: String)`. `Client()`: `get(url: String): Response`, `post(url: String, body: String): Response`.\n\n" +
                "`Request(method, path, body, headers: Map<String, String>, queries: Map<String, String>)`. " +
                "`ServerConnection(sock: Socket)`: `readRequest(): Request`, `parseContentLength(headersPart: String): Int`, " +
                "`iequals(a: String, b: String): Bool`, `parseInt(s: String): Int`, " +
                "`writeResponse(status: Int, contentType: String, body: String): Void`, `statusReason(status: Int): String`, " +
                "`writeResponseWithHeaders(status, contentType, body, extraHeaders: List<String>): Void`, `close(): Void`.\n\n" +
                "`Server(tcpServer)`: `bind(port: Int): Bool`, `accept(): ServerConnection?`, `close(): Void`.\n\n" +
                "`urlEncode(s: String): String`, `writeCallback(contents, size, nmemb, userp): Int` (curl bridge).\n\n" +
                "```kotlin\nimport { Client } from \"std.http\"\n\nval res = Client().get(\"https://example.com\")\nprintln(res.status)\n```"
        }
        if (module == "net" || module == "std.net") {
            return "## std.net — TCP Sockets (suspending IO)\n\n" +
                "`Socket(fd: Int = -1)`: `@Suspend read(maxLen: Int): String`, `@Suspend write(data: String): Int`, `close(): Void`. " +
                "`SocketClient.connect(host: String, port: Int): Socket?`. " +
                "`TCPServer(fd: Int = -1)`: `bind(port: Int): Bool`, `@Suspend accept(): Socket?`, `close(): Void`.\n\n" +
                "`@Suspend` methods must run inside `task {}` / coroutine context, not in plain `main()`.\n\n" +
                "```kotlin\nimport { SocketClient } from \"std.net\"\n\nval sock = SocketClient.connect(\"example.com\", 80)\nprintln(sock == null)\n```"
        }
        if (module == "db" || module == "std.db") {
            return "## std.db — Database Contracts & Pool\n\n" +
                "`Row { fun int(name: String): Int; fun double(name: String): Double; fun string(name: String): String; " +
                "fun bool(name: String): Bool; fun isNull(name: String): Bool }`.\n\n" +
                "`Result { fun rows(): List<Row>; fun rowsAffected(): Int }`. " +
                "`Statement { fun query(params: List<String>): Result; fun execute(params: List<String>): Result }`. " +
                "`Connection { fun execute(sql: String, params: List<String> = []): Result; fun query(sql: String, params: List<String> = []): Result; " +
                "fun prepare(sql: String): Statement; fun close() }`.\n\n" +
                "`DbError(message: String) : Throwable`. " +
                "`BoundStatement(conn, sql, params): Statement`: `bind(String/Int/Double/Bool): BoundStatement`, `query(params = []): Result`, `execute(params = []): Result`.\n\n" +
                "`ConnectionPool<C>(factory, maxConnections = 10, ...) : Connection, Closeable`: `acquire(): C`, `release(conn: C)`, " +
                "`query/execute/prepare` (pool-aware), `prepareBound(sql: String): BoundStatement`, `transaction(block: (Connection) -> Void)` (BEGIN/COMMIT/ROLLBACK), `close()`."
        }
        if (module == "coroutines" || module == "std.coroutines") {
            return "## std.coroutines — Stackless Coroutines (FIFO Scheduler)\n\n" +
                "`@Coroutine task<T>(block: () -> T): StackTask<T>`, `task<T>(dispatcher: Dispatcher, block: () -> T)` (spawn). " +
                "`StackTask<T> : Awaitable<T>`: `@Suspend await(): T` (cooperatively suspends; call inside `task {}` or from awaitable context), `awaitCoop(cont: Continuation): Bool`, `isDone(): Bool`. " +
                "There is NO top-level `sleep` here (blocking `sleep/sleepMs` live in `std.system`; cooperative sleep is `Coroutine.sleepMs`).\n\n" +
                "`Scheduler`: `schedule(cont)`, `sleep(cont, ms): Bool`, `yield(cont): Bool`, `waitReadable/waitWritable(cont, fd): Bool`, " +
                "`run()`, `runStep(): Bool`. `TaskScheduler`: `schedule/sleep/yield/waitIo/waitReadable/waitWritable/pollIoLocked/popBlocking/fireTimers/fireTimersLocked/waitMs/run/runStep/shutdown/create`.\n\n" +
                "`Dispatcher`: `ensureStarted()`, `shutdown()`. `Dispatchers`: `createDefault(): Dispatcher`, `create(name: String, threads: Int): Dispatcher`.\n\n" +
                "`Coroutine`: `yield(): Int`, `sleep(nanosecs: Int): Int`, `sleepMs(ms: Int): Int`. " +
                "`EventLoop`: `waitReadable(fd: Int, timeout: Int = -1): Int`, `waitWritable(fd: Int, timeout: Int = -1): Int`.\n\n" +
                "Platform parity: `PollLayoutContract(entrySize/eventsOffset/reventsOffset/fdBytes/pollInLow/pollInHigh/pollOutLow/pollOutHigh/poll)` " +
                "implemented by `object(\"posix\") PollLayout` and `object(\"windows\") PollLayout`.\n\n" +
                "```kotlin\nimport { task } from \"std.coroutines\"\n\nval t = task { 40 + 2 }\nprintln(t.await())\n```"
        }
        if (module == "thread" || module == "std.thread") {
            return "## std.thread — OS Threads, Mutexes, CondVars\n\n" +
                "`RawMutex(ptr)`: `lock()`, `unlock()`, `destroy()`, companion `create(): RawMutex`. " +
                "`Mutex(raw = RawMutex.create())`: `withLock<T>(action: () -> T): T`. " +
                "`GlobalSync`, `sync<T>(action: () -> T): T`, `sync<T>(lock: Mutex, action: () -> T): T`.\n\n" +
                "`CondVar(ptr)`: `wait(mutex: RawMutex)`, `signal()`, `broadcast()`, `destroy()`, companion `create(): CondVar`.\n\n" +
                "`Thread(handle)`: `join()`. " +
                "`Threads`: `numCores(): Int`, `currentThread(): Pointer`, `spawn(block: () -> Void): Thread`.\n\n" +
                "`ThreadConstants`, `ThreadTask(action)`, `threadTrampoline(arg: Pointer): Pointer`, `CurrentCoreDetector : CoreDetector` " +
                "(`object(\"posix\")`, `object(\"windows\")`, universal; `getCores(): Int`).\n\n" +
                "Platform rule: `ThreadOpsContract` (pthread*/cond*) implemented by `object(\"posix\") NativeThread` and `object(\"windows\") NativeThread` — no duplicate `lib` names.\n\n" +
                "```kotlin\nimport { Threads } from \"std.thread\"\n\nval t = Threads.spawn { println(\"bg\") }\nt.join()\n```"
        }
        if (module == "atomic" || module == "std.atomic") {
            return "## std.atomic — Lock-Free Atomics\n\n" +
                "`AtomicBool(ptr)`: `get(): Bool`, `set(value: Bool)`, `compareAndSet(expected: Bool, newValue: Bool): Bool`, " +
                "companion `create(initial: Bool): AtomicBool`.\n\n" +
                "`AtomicInt(ptr)`: `get(): Int`, `set(value: Int)`, `addAndGet(delta: Int): Int`, `getAndAdd(delta: Int): Int`, " +
                "`incrementAndGet(): Int`, `decrementAndGet(): Int`, `compareAndSet(expected: Int, newValue: Int): Bool`, " +
                "companion `create(initial: Int): AtomicInt`.\n\n" +
                "```kotlin\nimport { AtomicInt } from \"std.atomic\"\n\nval c = AtomicInt.create(0)\nprintln(c.incrementAndGet())\n```"
        }
        if (module == "process" || module == "std.process") {
            return "## std.process — OS Processes & CLI Args\n\n" +
                "`Process`: `exec(cmd: String): Int`, `capture(cmd: String): String`, `chdir(path: String): Bool`, " +
                "`realpath(path: String): String?`, `argsCount(): Int`, `argAt(i: Int): String?`, `args(): List<String>`.\n\n" +
                "Platform parity: `NativeProcessOpsContract(system/popen/pclose/fgets/chdir/eiwa_args_count/eiwa_args_get)` " +
                "implemented by `object(\"posix\") NativeProcess` and `object(\"windows\") NativeProcess`; " +
                "`PathResolverContract(resolve)` via `object(\"posix\") PathResolver` / `object(\"windows\") PathResolver` " +
                "(distinct FFI libs `PosixProcess` vs `Win32Process`).\n\n" +
                "```kotlin\nimport { Process } from \"std.process\"\n\nprintln(Process.capture(\"echo hi\"))\nprintln(Process.args().size())\n```"
        }
        return "Unknown std module: $module. Call list_std_modules to see all 26 modules (core, collections, math, system, exceptions, io, fs, env, log, random, time, money, uuid, ulid, regex, json, serde, yaml, jsonrpc, http, net, db, coroutines, thread, atomic, process)."
    }
}
