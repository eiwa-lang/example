type Docs() {
} object {

    fun overview(): String {
        return "# Eiwa Language Overview\n\n" +
            "Eiwa is a modern, statically typed, natively compiled systems language with a Kotlin-inspired syntax.\n\n" +
            "## Key Highlights:\n" +
            "- **Native Performance:** Compiles directly to native machine code via LLVM with Boehm GC memory management.\n" +
            "- **Zero JVM, Zero Runtime Overhead:** No virtual machine, instant startup, lightweight binaries.\n" +
            "- **Composition-Only Type System:** NO implementation inheritance (`class`, `abstract`, `open`, `override` DO NOT EXIST). Uses `type`, `contract`, `skill`, and `object` with `implement`.\n" +
            "- **Strict Platform Parity:** Compile-time guarantee of identical APIs across operating systems. Specialized types/objects must implement contracts with complete variant parity, banning false symmetry and ad-hoc platform divergence.\n" +
            "- **Compile-Time Null Safety & Union Types:** `T | Null` or `T?`, safe calls `?.`, elvis `?:`, and force unwrap `!!`.\n" +
            "- **Stackless Coroutines:** Cooperative concurrency with `task {}`, `.await()`, `sleep()/sleepMs()`, `yield()` and `park()` powered by a pure Eiwa FIFO Scheduler.\n" +
            "- **Explicit Declarations:** Every standard API is formally declared in `src/std/` (`std.core`, `std.collections`, `std.http`, `std.json`, `std.time`); web/DB frameworks are external packages (`arest`, `html`, `postgres`)."
    }

    fun section1Modules(): String {
        return "# Section 1: Module System & Imports\n\n" +
            "Every `.ei` file is an implicit module. Import syntax uses destructuring: `import { SymbolA, SymbolB } from \".path.to.module\"`.\n\n" +
            "## Module Resolution Rules:\n" +
            "| Form | Resolves Against | Example |\n" +
            "|---|---|---|\n" +
            "| `.x` | Project root (entry file directory) | `import { ArestBuilder } from \".arest_builder\"` |\n" +
            "| `x` / `x.y` | Importing file's directory | `import { McpCall } from \"mcp_call\"` |\n" +
            "| `std.x` | Standard library package | `import { Time } from \"std.time\"` |\n\n" +
            "**Case Sensitivity:** Module paths are strictly case-sensitive on all OSes. Use `snake_case` / `lowercase` file names."
    }

    fun section2TopLevel(): String {
        return "# Section 2: Top-Level Statements & Side-Effects\n\n" +
            "`fun main()` is optional in the root entry file. You can write top-level statements for scripts.\n\n" +
            "**Golden Rule of Modules:** Top-level side effects are ONLY allowed in the entry file. Imported files must be passive libraries (declaring types, functions, tests) without top-level executable statements, otherwise the compiler raises `ImportSideEffectsNotAllowed`."
    }

    fun section3Loops(): String {
        return "# Section 3: Arrays and Loops\n\n" +
            "- `[Type]` is sugar for immutable `List<T>`.\n" +
            "- **Lambda-style `for` loops:**\n" +
            "  - `for (numbers) { sum = sum + it }` (implicit `it`)\n" +
            "  - `for (numbers) { n -> product = product * n }` (named param)\n" +
            "  - `for (numbers) { idx, n -> println(\"\$idx: \$n\") }` (index & item)\n" +
            "- `while (cond) { ... }`\n" +
            "- Higher-order loops: `repeat(count) { it -> ... }`, `loop { ... }` (infinite), `retry(times) { attempt -> ... }`.\n" +
            "- No `continue` in Eiwa: `leave` always exits the loop entirely; skipping an iteration is written with `if`/`else`. In `@Leaveable` blocks (`repeat`/`loop`/`retry`), bare `leave` ends the whole loop."
    }

    fun section4Strings(): String {
        return "# Section 4: String Escape Sequences, Concatenation & Multiline\n\n" +
            "- Supported escapes: `\\\"`, `\\\\`, `\\n`, `\\r`, `\\t`, `\\b`, `\\'`, `\\$` (literal dollar, no interpolation).\n" +
            "- String concatenation (`+`) automatically converts operands to String if they implement `Stringable` (`implement fun toString(): String`).\n\n" +
            "## Multiline (no triple-quote delimiter)\n" +
            "A literal line break inside `\"...\"` is preserved as-is — indentation is kept literally and `\\r\\n` is preserved without normalization:\n" +
            "```kotlin\nval s = \"one\ntwo\"\nassert(s == \"one\\ntwo\")\n```\n" +
            "Escapes and `\${...}` interpolation work across lines, and raw newlines mix freely with `\\n` escapes:\n" +
            "```kotlin\nval name = \"Eiwa\"\nval s = \"hello \${name}\nsecond line\"\nassert(s == \"hello Eiwa\\nsecond line\")\n```\n\n" +
            "## Dedent is opt-in (`std.string` extensions, no import needed)\n" +
            "`trimIndent()` drops blank first/last lines, removes the minimal common indent of the non-blank lines, " +
            "turns blank middle lines into empty lines, and keeps trailing spaces:\n" +
            "```kotlin\nval indented = \"\n    hello\n      world\n    \"\nassert(indented.trimIndent() == \"hello\\n  world\")\n```\n" +
            "`trimMargin(marginPrefix: String = \"|\")` uses the same blank-line handling but strips leading whitespace + prefix per line " +
            "(lines without the prefix are kept unchanged; custom prefixes allowed):\n" +
            "```kotlin\nval margined = \"\n    |hello\n    |  world\n    \"\nassert(margined.trimMargin() == \"hello\\n  world\")\nassert(\"  #a\\n  #b\".trimMargin(\"#\") == \"a\\nb\")\n```"
    }

    fun section5NullSafety(): String {
        return "# Section 5: Union Types & Compile-Time Null Safety\n\n" +
            "- **Union Types:** `val v: String | Int = \"Eiwa\"`\n" +
            "- **Null Safety:** `null` is a union variant (`T | Null` or `T?`). Direct access on a `T?` receiver is a compile-time error.\n" +
            "- **Operators:**\n" +
            "  - Safe navigation: `user?.address?.city`\n" +
            "  - Elvis unwrap: `val name = user?.name ?: \"Guest\"`\n" +
            "  - Force unwrap: `val name = user!!.name`\n\n" +
            "## Smart cast (null check narrows `T?` to `T`)\n" +
            "After an explicit null check, a `val` of nullable type narrows to its non-null variant — no `?.` / `!!` needed. " +
            "Works in `if`, in the ternary, and in `when` with a `null` branch:\n" +
            "```kotlin\nfun len(s: String?): Int {\n    if (s != null) {\n        return s.length   // s: String here\n    }\n    return -1\n}\n\nfun early(s: String?): Int {\n    if (s == null) {\n        return -1         // diverging branch...\n    }\n    return s.length       // ...so s: String below\n}\n\nval n: Int = if (s != null) s.length else -1\nval m: Int = (s != null) ? s.length : -1\nval k = when (s) {\n    null -> -1\n    else -> s.length      // narrowed (a `null` branch exists)\n}\n```\n" +
            "Rules (v1): only immutable `val`s narrow (params, locals, `val` fields — a mutated `var` keeps requiring `?.`/`!!`); " +
            "reference types only (`Int?`/`Bool?`/`Double?` are heap-boxed scalars and still need `?.`/`!!`); " +
            "`while` conditions do not narrow. A `?.`/`!!` applied after the narrowing is a no-op and produces a `warning` (the build still passes)."
    }

    fun section6Exceptions(): String {
        return "# Section 6: Exception Handling (try-catch)\n\n" +
            "- Any type implementing `Throwable` (`implement fun message(): String`) can be thrown via `throw`.\n" +
            "- Control-flow signals implement `ControlFlow` instead (e.g. `Leave`): generic handlers never observe them.\n" +
            "- **Standard catch:** `try { ... } catch (e: MyError) { ... }`\n" +
            "- **Multi-catch:** `try { ... } catch (e: ErrorA | ErrorB) { ... }`\n" +
            "- **Bare try:** `try { optionalCall() }` (swallows exceptions silently)\n" +
            "- **Catch-all:** `try { ... } catch { println(\"Error occurred\") }`"
    }

    fun section7Collections(): String {
        return "# Section 7: Collections (List, Map, Set)\n\n" +
            "- `List<T>`: Immutable list `[1, 2, 3]`\n" +
            "- `MutableList<T>`: `list.mut()` or `MutableList<T>()` with `.add()`, `.set()`, `.remove()`\n" +
            "- **Concat (in-place):** `all.add(otherList)` (overload of `add`, Kotlin `addAll`) and `all.addAll(otherList)`; " +
            "both take an immutable `List<T>` — freeze mutable sources first (`all.add(other.freeze())`)\n" +
            "- **Concat (new list):** `listA + listB` and `list + element` return a NEW immutable `List<T>` on both `List` and `MutableList` receivers; operands are never mutated\n" +
            "- `Map<K, V>`: Created via infix `of`: `val capitals = [\"Brazil\" of \"Brasília\", \"Japan\" of \"Tokyo\"]`\n" +
            "- `MutableMap<K, V>`: `map.mut()` with `m[\"key\"] = val`\n" +
            "- `Set<T>` / `MutableSet<T>`: Unique elements container\n" +
            "- **Immutability Conversion (O(1)):** `.mut()` (wraps mutably) and `.freeze()` (locks as immutable snapshot).\n" +
            "- **Slicing (`Slicable<T>`, both `List` and `MutableList` receivers, always returns a NEW `List<T>`):** " +
            "`slice(start: Int, end: Int)` (`start` inclusive, `end` exclusive, clamped to `[0, size]`), " +
            "`skip(n)` (Eiwa's name for Kotlin's `drop`), `take(n)`, `skipLast(n)`, `takeLast(n)`.\n" +
            "- **Searching:** `contains(element)`, `indexOf(element): Int` (`-1` when absent), `first()`, `last()`, `isEmpty()`, `isNotEmpty()`."
    }

    fun section8Ternary(): String {
        return "# Section 8: Ternary Operators\n\n" +
            "- **Standard Ternary:** `condition ? true_expr : false_expr` (right-associative, type inferred)\n" +
            "- **Short Ternary:** `condition ? true_expr` (omits else branch; returns `null` if false, promoting return type to `Type?`)."
    }

    fun section9OperatorOverloading(): String {
        return "# Section 9: Operator Overloading\n\n" +
            "In Eiwa, operator functions MUST be explicitly tagged with the `operator` modifier:\n" +
            "```kotlin\ntype Vector(val x: Int, val y: Int) {\n    operator fun plus(other: Vector): Vector = Vector(x + other.x, y + other.y)\n    operator fun minus(other: Vector): Vector = Vector(x - other.x, y - other.y)\n}\n```\n" +
            "Supported operator methods: `plus` (+), `minus` (-), `times` (*), `div` (/), `rem` (%), `unaryMinus` (-x), `not` (!x)."
    }

    fun section10When(): String {
        return "# Section 10: Pattern Matching (when Expressions)\n\n" +
            "`when` acts as an expression or statement:\n" +
            "```kotlin\nval label = when (status) {\n    200 -> \"OK\"\n    404 -> \"Not Found\"\n    else -> \"Unknown\"\n}\n```\n" +
            "Supports multiple matches (`200, 201 -> ...`), ranges, contract checks (`is Contract -> ...`), and type casts."
    }

    fun typeSystem(): String {
        return "# Section 11: Composition Type System (ADR 25)\n\n" +
            "Eiwa eliminates traditional OOP inheritance in favor of pure composition. `class`, `open`, `abstract`, and `override` DO NOT EXIST.\n\n" +
            "1. **`type`:** Holds state and identity. Cannot be subclassed. Implements contracts (`:`) and composes skills (`+`).\n" +
            "2. **`contract`:** Pure API signature without state or method bodies.\n" +
            "3. **`skill`:** Reusable behavior with method bodies. Borrows contracts via `:` which are fulfilled by the host `type`.\n" +
            "4. **`object`:** Singleton for static state and companion namespaces (`} object {`).\n" +
            "5. **`implement`:** Mandatory keyword inside `type` to implement contract methods or resolve ambiguities.\n\n" +
            "```kotlin\ncontract Named { fun getName(): String }\nskill FormalGreeter : Named { fun greet(): String = \"Hello, \${getName()}\" }\ntype User(val name: String) : Named + FormalGreeter {\n    implement fun getName(): String = name\n}\n```"
    }

    fun coroutines(): String {
        return "# Section 12: Tasks & Stackless Coroutines\n\n" +
            "Stackless cooperative coroutines compiled into state machines (heap Continuation objects) managed by a FIFO Scheduler.\n\n" +
            "- `task { ... }`: Spawns a background cooperative coroutine returning a `Task<T>`.\n" +
            "- `.await()`: Cooperatively suspends until task completion and yields result.\n" +
            "- Blocking top-level (`std.system`, implicit import, no import needed): `sleep(seconds: Int): Void`, `sleepMs(ms: Int): Void`, `yield(): Void`. Outside `task {}` they block the calling thread (nanosleep/sched_yield); written directly inside a `task {}` body they become cooperative suspension points (the worker is released until the timer fires). A `sleep` called from a method invoked by the task still blocks.\n" +
            "- `park(): Void` (`std.system`): parks the calling thread FOREVER at 0% CPU (un-signaled cond wait) — the idiom to keep `main` alive until the process is killed. Never suspends, never use inside `task {}`.\n" +
            "- `Coroutine` (`std.coroutines`, object form, same blocking semantics outside tasks): `yield(): Int`, `sleep(nanosecs: Int): Int`, `sleepMs(ms: Int): Int`, `park(): Void`.\n" +
            "- `EventLoop`: `waitReadable(fd: Int, timeout: Int = -1): Int`, `waitWritable(fd: Int, timeout: Int = -1): Int` (poll)."
    }

    fun section13Serialization(): String {
        return "# Section 13: Reflectionless JSON Serialization\n\n" +
            "Direct LLVM compile-time schema generation with zero runtime reflection overhead. " +
            "Types opt in with `: Serializable + Json`, serialize with `toJson(): String`, decode with `fromJson<T>(raw: String): T`. " +
            "There is NO `Json.encode/Json.decode`.\n\n" +
            "```kotlin\nimport { Serializable } from \"std.serde\"\nimport { Json } from \"std.json\"\nimport { fromJson } from \"std.json\"\n\ntype User(val id: Int, val name: String) : Serializable + Json\n\nval u = User(1, \"Alice\")\nval raw = u.toJson()\nval decoded: User = fromJson<User>(raw)\n```"
    }

    fun section14SmartCast(): String {
        return "# Section 14: Smart Casts & Type Inspection\n\n" +
            "## 14.1 Null smart cast (`T?` -> `T` after a null check)\n" +
            "Checking `if (s != null)` narrows the `then` branch to `T`; checking `if (s == null)` narrows the `else` branch " +
            "and any code after a diverging `then` (early `return`/`throw`). The same narrowing applies to the matching ternary branch " +
            "(`(s != null) ? s.length : -1`, `(s == null) ? -1 : s.length`) and to `when (s)` once a `null` (or `is Null`) branch exists " +
            "(`else -> s.length`).\n" +
            "```kotlin\nfun len(s: String?): Int {\n    if (s != null) {\n        return s.length   // s: String here\n    }\n    return -1\n}\n\nfun early(s: String?): Int {\n    if (s == null) {\n        return -1\n    }\n    return s.length       // narrowed by early return\n}\n\nval k = when (s) {\n    null -> -1\n    else -> s.length\n}\n```\n" +
            "Limits (v1): `val` only (`var` keeps requiring `?.`/`!!` so a reassignment between check and use cannot slip through); " +
            "reference types only (`Int?`/`Bool?`/`Double?` still need `?.`/`!!`); `while` conditions do not narrow; " +
            "redundant `?.`/`!!` on an already-narrowed value is a `warning`, not an error.\n\n" +
            "## 14.2 Contract / type smart cast (`is` check)\n" +
            "Checking `if (x is Type)` or `when (x) is Contract` automatically promotes `x` to the target type without explicit casting.\n\n" +
            "Explicit cast syntax: `val user = value as User`."
    }

    fun section15Enums(): String {
        return "# Section 15: Enums & Algebraic Data Types\n\n" +
            "```kotlin\nenum HttpMethod {\n    GET, POST, PUT, DELETE\n}\n\nfun main() {\n    val m = HttpMethod.GET\n    println(m.name())\n}\n```"
    }

    fun section16Generics(): String {
        return "# Section 16: Generics & Parametric Polymorphism\n\n" +
            "Supports generic types `type Box<T>(val value: T)` and generic functions `fun <T> identity(item: T): T = item`."
    }

    fun section17ScopeFunctions(): String {
        return "# Section 17: Scope Functions\n\n" +
            "- `apply`: `obj.apply { field = 1 }` (returns receiver `this`)\n" +
            "- `let`: `obj.let { it.transform() }` (returns lambda result)\n" +
            "- `also`: `obj.also { log(it) }` (returns receiver)\n" +
            "- `run`: `obj.run { compute() }` (returns lambda result)\n" +
            "- `with`: `with(obj) { doSomething() }`"
    }

    fun section18CInterop(): String {
        return "# Section 18: C Interoperability (cimport & lib)\n\n" +
            "Zero-overhead native C interoperability using `@Header` and `@CFunction`:\n\n" +
            "```kotlin\n@Header(\"math.h\")\nlib {\n    @CFunction fun sqrt(x: Double): Double\n}\n```\n" +
            "Types map directly to C ABI: `Int` -> `int64_t`/`int32_t`, `Double` -> `double`, `Pointer` -> `void*`."
    }

    fun section19Extensions(): String {
        return "# Section 19: Extension Functions\n\n" +
            "Extend existing types without inheritance or wrapper allocations:\n\n" +
            "```kotlin\nfun String.shout(): String = \"\$this!\"\nfun Int.squared(): Int = this * this\n```"
    }

    fun section20PlatformParity(): String {
        return "# Section 20: Cross-Compilation & Platform Parity\n\n" +
            "## 1. The Architectural Problem: False Symmetry\n" +
            "In traditional systems programming (C/C++ `#ifdef`, Rust `cfg`, Go build tags), conditional compilation easily suffers from **False Symmetry**:\n" +
            "- A developer implements a feature on POSIX/Linux, adding methods like `fork()`, `waitpid()`, or `getPriority()`.\n" +
            "- Another developer implements the Windows variant with `createProcess()` or omits `getPriority()` entirely.\n" +
            "- Because the two variants share the same type or lib name, code written on Linux compiles cleanly locally, but breaks with cryptic linker or compile errors when built on Windows or in CI.\n\n" +
            "Eiwa eliminates this class of bugs at compile time through **Strict Platform Parity (ADR 60)**.\n\n" +
            "## 2. The 5 Core Principles\n\n" +
            "| Rule | Requirement | Compiler Enforcement |\n" +
            "|---|---|---|\n" +
            "| **1. Unique FFI Names** | `lib` blocks can NEVER share the same name across platforms. | `TypeError.DuplicateDeclaration` via `seen_libs` map |\n" +
            "| **2. Mandatory Contracts** | Every specialized `type(\"...\")` or `object(\"...\")` MUST implement contracts (`: Contract`). | `TypeError.PlatformSpecializationRequiresContract` |\n" +
            "| **3. Variant Parity** | All variants of the same name (including universal default fallbacks) must implement the EXACT SAME contracts. | `TypeError.PlatformVariantContractsMismatch` via `areContractsEqual()` |\n" +
            "| **4. Method Parity** | Specialized types cannot define ad-hoc public methods. Every method must carry `implement` or come from a skill. | `TypeError.PlatformSpecializationCannotIntroduceAdHocMethods` |\n" +
            "| **5. Zero-Cost Pruning** | Inactive platform declarations are eliminated during LLVM IR generation. | Active symbol bound directly with static zero-overhead dispatch |\n\n" +
            "## 3. The Three-Tier Architecture Pattern\n\n" +
            "Every cross-platform subsystem in Eiwa follows a clean 3-tier boundary:\n\n" +
            "```kotlin\n// ==========================================================================\n" +
            "// TIER 1: LOW-LEVEL FFI BINDINGS (Explicit, Distinct Names)\n" +
            "// ==========================================================================\n" +
            "@Header(\"<unistd.h>\")\n" +
            "lib(\"posix\") PosixProcess {\n" +
            "    fun fork(): Int\n" +
            "    fun waitpid(pid: Int, status: Pointer, options: Int): Int\n" +
            "}\n\n" +
            "@Header(\"<windows.h>\")\n" +
            "@Link(\"kernel32\")\n" +
            "lib(\"windows\") Win32Process {\n" +
            "    fun GetCurrentProcessId(): Int\n" +
            "}\n\n" +
            "// ==========================================================================\n" +
            "// TIER 2: UNIVERSAL SPECIFICATION (Pure Contract)\n" +
            "// ==========================================================================\n" +
            "contract ProcessOpsContract {\n" +
            "    fun getPid(): Int\n" +
            "    fun spawn(cmd: String): Int\n" +
            "}\n\n" +
            "// ==========================================================================\n" +
            "// TIER 3: PLATFORM-SPECIALIZED BRIDGES (Must implement the Contract)\n" +
            "// ==========================================================================\n" +
            "object(\"posix\") ProcessOps : ProcessOpsContract {\n" +
            "    implement fun getPid(): Int = 42\n" +
            "    implement fun spawn(cmd: String): Int {\n" +
            "        val pid = PosixProcess.fork()\n" +
            "        return pid\n" +
            "    }\n" +
            "}\n\n" +
            "object(\"windows\") ProcessOps : ProcessOpsContract {\n" +
            "    implement fun getPid(): Int = Win32Process.GetCurrentProcessId()\n" +
            "    implement fun spawn(cmd: String): Int {\n" +
            "        // Win32 CreateProcess implementation\n" +
            "        return 100\n" +
            "    }\n" +
            "}\n\n" +
            "// ==========================================================================\n" +
            "// TIER 4: PORTABLE APPLICATION CODE (Zero platform leak)\n" +
            "// ==========================================================================\n" +
            "fun main() {\n" +
            "    val pid = ProcessOps.getPid()\n" +
            "    println(\"Process running with PID: \$pid\")\n" +
            "}\n" +
            "```\n\n" +
            "## 4. Compiler Internals & Verification Pipeline\n\n" +
            "### A. Frontend Lexer & Parser (`src/frontend/parser.zig`)\n" +
            "- The parser recognizes platform attributes on declarations: `lib(\"posix\")`, `type(\"windows\", \"x86_64\")`, `object(\"linux\")`.\n" +
            "- Supported target tags: `posix`, `linux`, `macos`, `darwin`, `windows`, `win32`, architecture tags `x86_64`, `aarch64`, `arm64`, and negated tags `!windows`.\n" +
            "- Target tags are stored in the `platform_targets` slice of the `ASTNode`.\n\n" +
            "### B. Type Checker Parity Pass (`src/core/type_checker/core.zig`)\n" +
            "1. **`seen_libs` Tracking:** When checking `lib` declarations, the compiler inserts each lib name into a `seen_libs` hashmap. If a duplicate name is encountered (even under differing platform attributes), compilation halts immediately with `TypeError.DuplicateDeclaration`.\n" +
            "2. **Cross-Variant Grouping:** In `checkDeclarations()`, all `type_decl` and `object_decl` nodes are grouped by identifier name into a `StringHashMap(ArrayList(*ASTNode))`.\n" +
            "3. **Contract Parity Validation (`areContractsEqual`):** If any declaration in a group has `platform_targets`:\n" +
            "   - Every declaration in the group (specialized and universal fallback) MUST specify non-empty contracts.\n" +
            "   - The compiler runs `areContractsEqual(first.contracts, other.contracts)` ensuring that every variant implements the exact same list of contracts.\n" +
            "   - If any variant diverges, `TypeError.PlatformVariantContractsMismatch` is reported.\n\n" +
            "### C. Method Parity Validation (`src/core/type_checker/infer_decl.zig`)\n" +
            "- During declaration method inference, if `decl.platform_targets != null`, every method defined within the body is validated.\n" +
            "- If a method lacks `kw_implement` and does not originate from a composed `skill`, the compiler rejects it with `TypeError.PlatformSpecializationCannotIntroduceAdHocMethods`.\n\n" +
            "### D. LLVM Backend Emission (`src/backend/llvm_emitter/`)\n" +
            "- When compiling for a specific target triple (e.g. `x86_64-linux-gnu` or `x86_64-windows-msvc`), the LLVM emitter checks `platform_targets`.\n" +
            "- Inactive platform declarations are pruned from code emission. The active variant satisfies all contract calls with zero vtable indirection overhead.\n\n" +
            "## 5. Standard Library Case Studies (Phase 60 Refactoring)\n" +
            "- **`std.process`:** Split `NativeProcess` into `PosixProcess` and `Win32Process`. Both platforms implement `NativeProcessOpsContract` via `object NativeProcessOps`.\n" +
            "- **`std.thread`:** Split `NativeThread` into `PosixThread` (pthread) and `Win32Thread`. Both implement `ThreadOpsContract` via `object NativeThread`.\n" +
            "- **`std.coroutines`:** Split `NativePoll` into `PosixPoll` and `Win32Poll`. Both implement `PollLayoutContract` via `object PollLayout` used by the cooperative `Scheduler`.\n\n" +
            "## 6. CLI Cross-Compilation Commands\n" +
            "- Compile for Linux: `./bin/eiwac build --target x86_64-linux -o app_linux main.ei`\n" +
            "- Compile for Windows: `./bin/eiwac build --target x86_64-windows -o app.exe main.ei`\n" +
            "- Compile for macOS Apple Silicon: `./bin/eiwac build --target aarch64-macos -o app_mac main.ei`\n\n" +
            "Parity is enforced during semantic analysis on the host machine before backend emission, guaranteeing that cross-compiled targets never fail due to API mismatches."
    }

    fun syntaxRules(): String {
        return "# Strict Syntax Rules for LLMs & Developers\n\n" +
            "1. **NEVER use `class`, `open`, `abstract`, or `override`:** They do NOT exist in Eiwa.\n" +
            "2. **ALWAYS use `type`, `contract`, `skill`, `object`, and `implement`:**\n" +
            "   - `type MyType(...) : MyContract + MySkill { implement fun myMethod() { ... } }`\n" +
            "3. **Variable Declarations:** Immutable with `val`, mutable with `var`.\n" +
            "4. **No Raw Primitive Types:** Everything is a type declared in std (`Int`, `Double`, `Bool`, `String`, `Pointer`).\n" +
            "5. **Collections:**\n" +
            "   - `List<T>`: `val list = [1, 2, 3]`\n" +
            "   - `MutableList<T>`: `val mutList = list.mut()` or `MutableList<T>()`\n" +
            "   - Concat in place: `mutList.add(otherList)` / `mutList.addAll(otherList)` (takes `List<T>`; freeze mutable sources)\n" +
            "   - Concat as new list: `listA + listB`, `list + element` (never mutates)\n" +
            "   - `Map<K, V>`: `[\"key\" of \"value\"]`\n" +
            "6. **Loops:** `for (items) { ... }`, `for (items) { it -> ... }`, `for (items) { idx, it -> ... }`, `while (cond) { ... }`, `repeat(n) { ... }`.\n" +
            "7. **Null Safety:** `Type?` or `Type | Null`, safe call `obj?.prop`, elvis `a ?: b`, force `obj!!`. " +
            "After `if (v != null)` a `val` narrows to `T` (direct access, no `?.`/`!!`); `var` and `Int?`/`Bool?`/`Double?` never narrow.\n" +
            "8. **Import Syntax:** `import { SymbolA, SymbolB } from \".path.to.module\"` (relative to project root with leading `.`).\n" +
            "9. **Platform Parity (ADR 60):** Platform-specialized `type(\"...\")` and `object(\"...\")` MUST implement contracts. All platform variants sharing a name (including default fallback) MUST implement the exact same contract list. Ad-hoc uncontracted methods are forbidden in specialized declarations. `lib` blocks cannot share duplicate names across platforms (use explicit names like `PosixProcess` and `Win32Process`).\n" +
            "10. **Naming:** `camelCase` for functions/variables/parameters (`pickPort`, `liveConn`), `PascalCase` for `type`/`contract`/`skill`/`object`/`enum` names (`Button`, `Drawable`), `UPPER_SNAKE` for enum variants (`Direction.NORTH`), `snake_case` only for file names and C FFI targets (mapped with `@Alias`)."
    }

    fun stdlib(): String {
        return "# Eiwa Standard Library & Ecosystem (26 std modules + 3 external packages)\n\n" +
            "Per-module full API: `get_std_module(\"<name>\")` or resource `eiwa://spec/std/<name>`.\n\n" +
            "## std packages:\n" +
            "- `std.core`: `String/Int/Double/Bool/Pointer`, contracts (`Stringable/Equatable/Hashable/Runnable/Closeable/Awaitable`), skill `Scope<T>` (`let/also/apply/run/takeIf/takeUnless`), `with/use`, `Memory.alloc`.\n" +
            "- `std.collections`: `List/MutableList` (`add/addAll/plus/get/set/remove/size/freeze/mut/contains/indexOf/first/last/isEmpty/isNotEmpty/slice/skip/take/skipLast/takeLast`, contracts `Slicable/Indexed/Searchable`, skills `Slicing/Appending/Searching`), `Map/MutableMap` (`put/get/keys/values/freeze/mut`), `Set/MutableSet`, `String.split(delimiter)`.\n" +
            "- `std.math`: `Math` (`sin/cos/tan/sqrt/pow/abs/floor/ceil/round`) + top-level `mod(a, b)`.\n" +
            "- `std.system`: `loop/repeat/retry/sleep/sleepMs/yield/park/exit` (`@Leaveable` blocks: bare `leave` ends the whole loop).\n" +
            "- `std.exceptions`: `Throwable/Exception/AssertionException`, `ControlFlow/Leave` (bypass generic handlers), `error(msg)`, `assert(cond)`.\n" +
            "- `std.io`: `print/println/echo/printWelcome`, skill `Echoable`.\n" +
            "- `std.fs`: `File(path)` (`read/write/delete/exists`) + `File.read/write/delete/exists(path)` shortcuts.\n" +
            "- `std.env`: `Env` (`load/get/set/unset/exists`, typed `get` defaults) + `env()` helpers, `.env` loader.\n" +
            "- `std.log`: `LogLevel`, `Log/Logger` (`trace/debug/info/warn/error` with lazy lambdas, `with/withFields`, `setLevel/setFormatter`), `StandardLogFormatter/JsonLogFormatter`.\n" +
            "- `std.random`: `Random` (CSPRNG) + `SeededRandom`, skill `RandomOps` (`nextInt/nextDouble/nextBool/nextPercent/choice/shuffle`), `Random.seeded(seed)`.\n" +
            "- `std.time`: Epoch-first timestamps. `type Time(val sec: Int)` with `second/minute/hour/year/month/day`, " +
            "`format(pattern)` (tokens YYYY/MM/DD/HH/mm/ss), `plus(Duration)` (`+`), `minus(Time): Duration` (`-`). " +
            "Top-level: `now(): Time`, `nowMillis(): Int`, `date(year, month, day): Time`, `hours/minutes/seconds(n): Duration`, " +
            "`type Duration(val seconds: Int)` with `minutes()/hours()`. " +
            "NO `Clock.System` — port `Clock.System.now().toEpochMilliseconds() / 86400000L` as `nowMillis() / 86400000` or `now().sec / 86400`. " +
            "Full signatures: `get_std_module(\"time\")` or resource `eiwa://spec/std-time`.\n" +
            "- `std.money`: minor-unit `Money` (`plus/minus/times/allocate/split/format/isZero/isPositive/isNegative`), `Currency/Currencies`, builders take `Int` cents (`brl(14990)`), zero-decimal `clp/pyg/jpy/krw(amount)`.\n" +
            "- `std.uuid`: `Uuid` (`v4/v7/generate/parse/version/toString/toBytes`) + `Identifier` contract.\n" +
            "- `std.ulid`: `Ulid` (`generate/parse/timestamp/toString/toBytes`) + `decodeCrockford/crockfordVal`.\n" +
            "- `std.regex`: `Regex` (`find/findAll/matches/replace/findFrom`), `MatchResult` (`group/groupCount`), extensions `matchesRegex/findRegex/findAllRegex/replaceRegex`.\n" +
            "- `std.json`: `JsonValue` (`get/getIndex/asString/asNumber/asBool/isObject/.../write`), `JsonParser/parseJson`, skill `Json` (`toJson/writeJson`), `serializeJson/fromJson/parseJsonToSerde`. NO `Json.encode/decode`.\n" +
            "- `std.serde`: `Serializable/Deserializable`, `SerdeValue/SerdeObject/SerdeList` (`get/getString/getInt/getDouble/getBool/getObject/getList`), `asString/asInt/asDouble/asBool/deserializeList`.\n" +
            "- `std.yaml`: skill `Yaml` (`toYaml/writeYaml/...`).\n" +
            "- `std.jsonrpc`: `JsonRpc` (`argument/argumentString/argumentInt/argumentDouble/argumentBool/response/errorResponse`, `JsonRpc.parse`).\n" +
            "- `std.http`: `Client` (`get/post`), `Server/ServerConnection/Request/Response`, `urlEncode`.\n" +
            "- `std.net`: `Socket` (`@Suspend read/write`, `close`), `SocketClient.connect`, `TCPServer` (`bind/@Suspend accept`). `@Suspend` IO must run inside `task {}`.\n" +
            "- `std.db`: contracts `Row/Result/Statement/Connection`, `DbError`, `BoundStatement` (`bind`), `ConnectionPool` (`acquire/release/transaction`).\n" +
            "- `std.coroutines`: `@Coroutine task {}` -> `StackTask<T>` (`@Suspend await/isDone`), `Scheduler/Dispatchers/Dispatcher`, `Coroutine` (`yield/sleep/sleepMs/park`), `EventLoop` (`waitReadable/waitWritable`). Top-level blocking `sleep/sleepMs/yield/park` live in `std.system` (implicit import).\n" +
            "- `std.thread`: `Threads.spawn/join/numCores`, `Mutex.withLock/sync`, `RawMutex/CondVar`, `ThreadOpsContract` (posix/win32 parity).\n" +
            "- `std.atomic`: `AtomicBool/AtomicInt` (`get/set/compareAndSet`, `addAndGet/incrementAndGet/decrementAndGet`).\n" +
            "- `std.process`: `Process` (`exec/capture/chdir/realpath/args/argsCount/argAt`).\n\n" +
            "## External packages (NOT std.*):\n" +
            "- `arest` (`github: eiwa-lang/arest`): declarative REST (`arest(port) { health/routing/static }`) + MCP (`mcp { tool/resource/prompt }`) + typed client (`arestClient { baseUrl/timeout/bearerAuth }`).\n" +
            "- `html` (`github: eiwa-lang/html`): type-safe DSL (`html { head/body }`, `fragment`, `escapeHtml`).\n" +
            "- `postgres` (`github: eiwa-lang/postgres`): native driver (`Postgres.connect(url)`, `query/execute`, `Row.string/int/double/bool`). NOT `std.postgres`."
    }

    fun packages(): String {
        return "# Section 21: Package Management (eiwa.yaml)\n\n" +
            "Eiwa has no central registry — dependencies come from git hosts or local directories, declared in the project manifest `eiwa.yaml`.\n\n" +
            "## Manifest (`eiwa.yaml`)\n" +
            "```yaml\n" +
            "name: my-app\n" +
            "version: 1.0.0\n" +
            "output: bin/my-app   # optional, default: bin/<name>\n\n" +
            "dependencies:\n" +
            "  arest:\n" +
            "    github: eiwa-lang/arest\n" +
            "    branch: main\n" +
            "  postgres:\n" +
            "    github: eiwa-lang/postgres\n" +
            "    tag: v1.0.0\n" +
            "  auth:\n" +
            "    git: https://gitlab.com/company/auth.git\n" +
            "    commit: 84d2ab3\n" +
            "  meulib:\n" +
            "    path: ../meulib\n" +
            "```\n\n" +
            "## Dependency Sources\n" +
            "- `github: org/repo` — GitHub shorthand (branch/tag/commit optional).\n" +
            "- `gitlab: org/repo` — GitLab shorthand.\n" +
            "- `git: <url>` — any git URL.\n" +
            "- `path: <dir>` — **local path dependency (ADR 61)**: a directory used directly, no cloning, no versioning, no resolution cache. Changes are reflected on the very next `run`/`build`/`test`. Coexists with git deps; it is NOT an override. Path deps do not participate in `eiwa freeze`/`eiwa update`.\n\n" +
            "## Commands\n" +
            "- `eiwa init [dir]`: Scaffolds a project (`eiwa.yaml`, `src/main.ei`, `test/`).\n" +
            "- `eiwa add <name> <source> [--branch|--tag|--commit <ref>]`: Adds a git dependency.\n" +
            "- `eiwa add <name> --path <dir>` (or `path:<dir>`): Adds a local path dependency.\n" +
            "- `eiwa remove <name>`: Removes a dependency.\n" +
            "- `eiwa freeze`: Pins resolved commits into `eiwa.freeze` (path deps skipped).\n" +
            "- `eiwa update [name]`: Re-resolves git deps from the manifest.\n" +
            "- `eiwa build --frozen`: Fails unless `eiwa.freeze` exists (for CI).\n\n" +
            "## Freeze & Reproducible Builds\n" +
            "`eiwa freeze` writes `eiwa.freeze` with every git dependency pinned to its exact commit (`branch`/`tag` replaced by `commit`). When present, the freeze overrides the local resolution cache — commit it for deterministic CI/CD builds. `eiwa build` never upgrades dependencies on its own; only `eiwa update` re-resolves refs."
    }

    fun cli(): String {
        return "# Eiwa CLI Toolchain Guide\n\n" +
            "## Commands:\n" +
            "- `eiwa init <name>`: Initializes a new Eiwa project with `eiwa.yaml`.\n" +
            "- `eiwa add <source> [--branch|--tag|--commit <ref>]`: Adds a Git dependency to `eiwa.yaml`.\n" +
            "- `eiwa add <name> --path <dir>`: Adds a local path dependency (no git required).\n" +
            "- `eiwa run [file.ei]`: Compiles and executes code instantly with JIT/AOT.\n" +
            "- `eiwa build [file.ei] -o <binary>`: Generates an optimized native static binary.\n" +
            "- `eiwa test`: Executes all `test \"name\" { ... }` blocks across the project.\n\n" +
            "## Docker (`eiwac/eiwa` toolchain image)\n" +
            "The compiler repo (`eiwa-lang/Dockerfile`) publishes `eiwac/eiwa:latest` plus one tag per " +
            "release (see `eiwa-lang/.github/workflows/release.yml`). Contents: `eiwac` + `eiwa` in `/opt/eiwa/bin`, " +
            "stdlib at `/opt/eiwa/src` (`EIWA_HOME`), `EIWA_BASELINE_CPU=1` (portable binaries under emulation), " +
            "`WORKDIR /work`, `ENTRYPOINT eiwa`. Base `debian:trixie-slim` ships `gcc`, `libllvm21`, `libgc-dev`, " +
            "`libcurl4-openssl-dev` so `eiwa build` and the JIT work inside the container.\n\n" +
            "Tag policy: `latest` is for local development only. For production, pin the exact version " +
            "— see https://github.com/eiwa-lang/eiwa/releases for the newest tag.\n\n" +
            "### 1. Pull and run (dev loop, no install)\n" +
            "```bash\n" +
            "docker pull eiwac/eiwa:latest   # dev loop\n" +
            "# project in the current dir (needs eiwa.yaml + src/main.ei)\n" +
            "docker run --rm -v \"\$PWD\":/work -p 8080:8080 eiwac/eiwa:latest run .\n" +
            "# standalone file (delegates to eiwac, no eiwa.yaml)\n" +
            "docker run --rm -v \"\$PWD\":/work eiwac/eiwa:latest eiwac run script.ei\n" +
            "```\n\n" +
            "### 2. Ship a service (multi-stage, canonical `example/home/Dockerfile`)\n" +
            "Pin the compile image in prod (never `latest`).\n" +
            "Compile with the toolchain, copy ONLY the native binary + assets into a slim runtime " +
            "(`debian:stable-slim` + `libcurl4 libgc1 ca-certificates openssl`; add `zlib1g libssl3 libpcre2-8-0 " +
            "libevent-2.1-7 libgmp10` if your deps need them). " +
            "The runtime does NOT contain the compiler.\n" +
            "```dockerfile\n" +
            "FROM eiwac/eiwa:latest AS compile   # prod: pin the exact version, never latest\n" +
            "WORKDIR /app\n" +
            "COPY ./ ./\n" +
            "RUN eiwa build --release        # output: /app/app (see `output:` in eiwa.yaml)\n" +
            "FROM debian:stable-slim AS runtime\n" +
            "RUN apt-get update && apt-get install -y --no-install-recommends libcurl4 zlib1g libssl3 libpcre2-8-0 libgc1 libevent-2.1-7 libgmp10 ca-certificates openssl && rm -rf /var/lib/apt/lists/*\n" +
            "ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt\n" +
            "COPY --from=compile /app/app /app/server\n" +
            "COPY --from=compile /app/static /app/static\n" +
            "WORKDIR /app\n" +
            "CMD [\"./server\"]\n" +
            "```\n" +
            "```bash\ndocker build -t my-service .                # add `--build-arg EIWA_CACHE_BUST=<sha>` to force a fresh toolchain layer\ndocker run --rm -p 8080:8080 my-service\n```\n\n" +
            "### 3. Reproducible CI builds\n" +
            "- Commit `eiwa.freeze` (`eiwa freeze` pins every git dep to its commit) and build with " +
            "`RUN eiwa build --release --frozen` so CI fails instead of silently resolving floating refs.\n" +
            "- Keep a `.dockerignore` (`example/home/.dockerignore`): `.git .gitignore bin/ app *.o *.tar.gz` " +
            "so caches and local binaries never enter the build context.\n" +
            "- The repo `.dockerignore` (`eiwa-lang/.dockerignore`) additionally excludes `.zig-cache zig-out dist`.\n\n" +
            "### 4. Compose + Kubernetes\n" +
            "Read the listen port from the environment (`PORT`) instead of hardcoding it; arest-style servers " +
            "take the port as `arest(PORT)`. The deployed site (`example/home/k8s/02-eiwa.yaml`) runs " +
            "`eiwac/eiwa-home:latest` with `containerPort: 8081`, `env PORT=8081`, HTTP " +
            "liveness/readiness probes on `/health`, and a Traefik `IngressRoute` for `eiwa.dev`. " +
            "Publish with `example/home/Makefile` (`docker buildx build --platform linux/amd64 -t eiwac/eiwa-home:latest --push .`).\n\n" +
            "### 5. Troubleshooting\n" +
            "- `unsupported arch`: the toolchain image only publishes `linux/amd64,linux/arm64`.\n" +
            "- Binary runs locally but not in Docker: rebuild inside the image — `EIWA_BASELINE_CPU=1` avoids " +
            "host-only CPU features (e.g. AVX-512) leaking into the binary under emulation.\n" +
            "- Missing shared libs at runtime (`libcurl`, `libgc`): compare with the `runtime` apt list above.\n" +
            "- Stale toolchain layer after a release: the release workflow passes " +
            "`EIWA_CACHE_BUST=<sha>`; do the same on manual `docker build`."
    }

    fun listTopics(): String {
        return "# Eiwa Documentation Topics\n\n" +
            "Use `get_doc_topic` with one of:\n" +
            "- `overview` — Language overview and core concepts\n" +
            "- `type-system` — Composition-based type system (type, contract, skill, implement)\n" +
            "- `platform-parity` — Platform parity and cross-compilation\n" +
            "- `coroutines` — Stackless coroutines (task/await)\n" +
            "- `syntax-rules` — Syntax rules and restrictions\n" +
            "- `stdlib` — Standard library modules\n" +
            "- `packages` — Packages and modules\n" +
            "- `cli` — CLI toolchain guide"
    }

    fun listTourSections(): String {
        return "# Eiwa Language Tour Sections (1-20)\n\n" +
            "Use `get_tour_section` with a number (1-20) or slug:\n" +
            "1. Modules and imports\n" +
            "2. Top-level statements (optional main)\n" +
            "3. Loops, ranges and arrays\n" +
            "4. Strings\n" +
            "5. Null safety and union types\n" +
            "6. Exceptions (try/catch/throw)\n" +
            "7. Collections (lists, maps, sets)\n" +
            "8. Ternary operator\n" +
            "9. Operator overloading\n" +
            "10. When / pattern matching\n" +
            "11. Type system (composition)\n" +
            "12. Coroutines and tasks\n" +
            "13. Serialization / JSON\n" +
            "14. Smart casts\n" +
            "15. Enums\n" +
            "16. Generics\n" +
            "17. Scope functions\n" +
            "18. C interop\n" +
            "19. Extension functions\n" +
            "20. Platform parity / cross-compilation"
    }

    fun getSection(query: String): String {
        if (query == "overview") {
            return overview()
        }
        if (query == "type-system") {
            return typeSystem()
        }
        if (query == "syntax-rules") {
            return syntaxRules()
        }
        if (query == "stdlib") {
            return stdlib()
        }
        if (query == "packages") {
            return packages()
        }
        if (query == "cli") {
            return cli()
        }
        if (query == "1" || query == "01" || query == "modules" || query == "imports") {
            return section1Modules()
        }
        if (query == "2" || query == "02" || query == "toplevel") {
            return section2TopLevel()
        }
        if (query == "3" || query == "03" || query == "loops" || query == "arrays") {
            return section3Loops()
        }
        if (query == "4" || query == "04" || query == "strings") {
            return section4Strings()
        }
        if (query == "5" || query == "05" || query == "nullsafety" || query == "unions") {
            return section5NullSafety()
        }
        if (query == "6" || query == "06" || query == "exceptions" || query == "try") {
            return section6Exceptions()
        }
        if (query == "7" || query == "07" || query == "collections" || query == "maps" || query == "sets") {
            return section7Collections()
        }
        if (query == "8" || query == "08" || query == "ternary") {
            return section8Ternary()
        }
        if (query == "9" || query == "09" || query == "operators" || query == "operator_overloading") {
            return section9OperatorOverloading()
        }
        if (query == "10" || query == "when" || query == "pattern_matching") {
            return section10When()
        }
        if (query == "11" || query == "types" || query == "composition" || query == "type_system") {
            return typeSystem()
        }
        if (query == "12" || query == "coroutines" || query == "tasks" || query == "concurrency") {
            return coroutines()
        }
        if (query == "13" || query == "serialization" || query == "json") {
            return section13Serialization()
        }
        if (query == "14" || query == "smartcast" || query == "casts") {
            return section14SmartCast()
        }
        if (query == "15" || query == "enums") {
            return section15Enums()
        }
        if (query == "16" || query == "generics") {
            return section16Generics()
        }
        if (query == "17" || query == "scopefunc" || query == "scope_functions") {
            return section17ScopeFunctions()
        }
        if (query == "18" || query == "cinterop" || query == "c") {
            return section18CInterop()
        }
        if (query == "19" || query == "extensions") {
            return section19Extensions()
        }
        if (query == "20" || query == "platform" || query == "platform-parity" || query == "parity" || query == "cross-compilation" || query == "adr60") {
            return section20PlatformParity()
        }

        return overview()
    }
}
