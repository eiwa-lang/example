object ExamplesData {
    fun list(): String {
        return "# Functional Eiwa Examples\n\n" +
            "- `http`: Declarative HTTP routing with arest\n" +
            "- `http_client`: Type-safe HTTP Client with arest\n" +
            "- `html`: Type-safe HTML DSL with html builder\n" +
            "- `tasks`: Concurrency and parallel background coroutines\n" +
            "- `postgres`: Async database queries with the external `postgres` package\n" +
            "- `mcp`: Publishing MCP Tools and Resources with arest\n" +
            "- `time`: Timestamp formatting and calculation\n" +
            "- `money`: Precision financial arithmetic\n" +
            "- `tests`: Native unit testing with `test \"name\" { ... }` blocks\n" +
            "- `platform`: Declarative cross-platform parity and contracts (ADR 60)\n" +
            "- `regex`: Pure-Eiwa regex (find/replace/matches)\n" +
            "- `json`: Reflectionless JSON serialization (toJson/fromJson)\n" +
            "- `uuid`: RFC 4122 UUIDs (v4/v7/parse)\n" +
            "- `ulid`: Sortable Crockford ULIDs (generate/parse)"
    }

    fun get(topic: String): String {
        if (topic == "http") {
            return "## HTTP Server with arest\n\n" +
                "Declarative routing, typed JSON responses, and a health check in one compact server.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: api\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Server (http.ei)\n\n" +
                "```kotlin\n" +
                "import { arest } from \"arest.arest\"\n" +
                "import { MutableMap } from \"std.collections\"\n\n" +
                "arest(8080) {\n" +
                "    health()\n\n" +
                "    routing {\n" +
                "        get(\"/hello\") {\n" +
                "            respondText(\"Hello from Eiwa!\")\n" +
                "        }\n\n" +
                "        post(\"/echo\") {\n" +
                "            respondJson(request.body)\n" +
                "        }\n" +
                "        get(\"/user\") {\n" +
                "            val body = MutableMap<String, String>()\n" +
                "            body[\"name\"] = \"Ana\"\n" +
                "            body[\"role\"] = \"admin\"\n" +
                "            respond(body.freeze())\n" +
                "        }\n\n" +
                "        get(\"/users/:id\") {\n" +
                "            val id = pathParam(\"id\") ?: \"unknown\"\n" +
                "            respond(User(id.toInt(), \"User \$id\"))\n" +
                "        }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run and test\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "curl http://localhost:8080/hello\n" +
                "curl http://localhost:8080/user\n" +
                "```\n\n" +
                "Routes are plain functions over ApplicationCall: respond, respondText, respondJson, respondHtml. Static files and health checks are built in."
        }
        if (topic == "http_client" || topic == "client") {
            return "## HTTP Client with arest\n\n" +
                "Expressive DSL, automatic Content Negotiation, pluggable transport engines (CurlEngine / MockEngine), and zero-reflection typed response parsing directly into DTOs.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: my-client\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Client (client.ei)\n\n" +
                "```kotlin\n" +
                "import { arestClient } from \"arest.client.client\"\n" +
                "import { Serializable } from \"std.serde\"\n" +
                "import { Json } from \"std.json\"\n\n" +
                "type UserDto(val id: Int, val name: String, val email: String) : Serializable + Json\n\n" +
                "val client = arestClient {\n" +
                "    baseUrl(\"https://api.example.com\")\n" +
                "    timeout(10000)\n" +
                "    bearerAuth(\"secret-token\")\n" +
                "}\n\n" +
                "// GET with automatic typed deserialization into UserDto:\n" +
                "val res = client.get(\"/users/1\")\n" +
                "if (res.ok) {\n" +
                "    val user = res.body<UserDto>()\n" +
                "    print(\"Found user: \${user.name} (\${user.email})\")\n" +
                "}\n\n" +
                "// POST with automatic JSON serialization:\n" +
                "val newUser = UserDto(2, \"Ana\", \"ana@example.com\")\n" +
                "val createRes = client.post(\"/users\", newUser)\n" +
                "print(\"Created: \${createRes.status}\")\n" +
                "```\n\n" +
                "### 3. Run and test\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "Found user: Ana (ana@example.com)\n" +
                "Created: 201\n" +
                "```\n\n" +
                "The client supports query parameters, custom headers, status predicates (isNotFound, isServerError), and pluggable transport engines like CurlEngine (libcurl) and MockEngine."
        }
        if (topic == "html") {
            return "## HTML DSL with the html package\n\n" +
                "Build pages with a declarative, type-safe DSL — no string templates.\n\n" +
                "### 1. Declare the dependencies (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: site\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  html:\n" +
                "    github: eiwa-lang/html\n" +
                "    branch: main\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Page (page.ei)\n\n" +
                "```kotlin\n" +
                "import { html } from \"html\"\n" +
                "import { arest } from \"arest.arest\"\n\n" +
                "fun page(): String = html {\n" +
                "    head {\n" +
                "        title(\"Eiwa App\")\n" +
                "    }\n" +
                "    body {\n" +
                "        h1(\"Welcome to Eiwa\")\n" +
                "        ul {\n" +
                "            li { write(\"Native performance\") }\n" +
                "            li { write(\"Strict null safety\") }\n" +
                "        }\n" +
                "    }\n" +
                "}\n\n" +
                "arest(8080) {\n" +
                "    routing {\n" +
                "        get(\"/\") { respond(200, \"text/html\", page()) }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "The html builder escapes attributes automatically and returns a ready-to-serve String."
        }
        if (topic == "tasks") {
            return "## Stackless Coroutines (task & await)\n\n" +
                "Cooperative state-machine coroutines with zero OS-thread overhead. `task { ... }` spawns a `StackTask<T>`, `.await()` suspends cooperatively until done. " +
                "NOTE: there is no top-level `sleep` in `std.coroutines` — blocking sleeps live in `std.system` (`sleep(seconds)/sleepMs(ms)`), " +
                "cooperative sleeps are `Coroutine.sleepMs(n)` inside a task.\n\n" +
                "```kotlin\nimport { task } from \"std.coroutines\"\n\nfun fetchUser(id: Int): String = \"User #\$id\"\nfun fetchOrders(id: Int): String = \"Orders for #\$id\"\n\nfun main() {\n    val userTask = task { fetchUser(42) }\n    val ordersTask = task { fetchOrders(42) }\n    println(\"Profile: \${userTask.await()} | \${ordersTask.await()}\")\n}\n```"
        }
        if (topic == "postgres") {
            return "## PostgreSQL Driver (external `postgres` package)\n\n" +
                "Direct native connection and parameterized queries — no ORM. NOTE: this is NOT `std.postgres`; " +
                "it is the external `postgres` package (`github: eiwa-lang/postgres`).\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: users\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  postgres:\n" +
                "    github: eiwa-lang/postgres\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Query (database.ei)\n\n" +
                "```kotlin\n" +
                "import { Postgres } from \"postgres\"\n\n" +
                "val db = Postgres.connect(\"postgres://user:pass@localhost:5432/mydb\")\n\n" +
                "val result = db.query(\"SELECT id, name, email FROM users WHERE active = $1\", [\"true\"])\n\n" +
                "for (result.rows()) {\n" +
                "    println(\"User: \${it.string(\\\"name\\\")} <\${it.string(\\\"email\\\")}>\")\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "Rows expose typed accessors: string(name), int(name), double(name), bool(name). Queries are parameterized — no string concatenation."
        }
        if (topic == "mcp") {
            return "## MCP Server with arest\n\n" +
                "arest publishes MCP tools, resources, and prompts over HTTP/JSON-RPC — no extra server needed. " +
                "This example builds a Calculator tool with declared argument schemas that MCP clients render automatically.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: mcp-app\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Server (mcp.ei)\n\n" +
                "```kotlin\n" +
                "import { arest } from \"arest.arest\"\n" +
                "import { Argument, JsonType } from \"arest.mcp.mcp_builder\"\n\n" +
                "arest(8080) {\n" +
                "    mcp {\n" +
                "        name(\"Calculator\")\n" +
                "        version(\"1.0.0\")\n" +
                "        instructions(\"Soma dois números e retorna o total.\")\n\n" +
                "        tool(\"sum\", description = \"Soma dois números\", arguments = [\n" +
                "            Argument(\"a\", JsonType.INTEGER, \"Primeiro número\"),\n" +
                "            Argument(\"b\", JsonType.INTEGER, \"Segundo número\")\n" +
                "        ]) {\n" +
                "            val a = argument(\"a\")!!.asNumber()\n" +
                "            val b = argument(\"b\")!!.asNumber()\n" +
                "            respond(a + b)\n" +
                "        }\n\n" +
                "        resource(\"calc://historico\") {\n" +
                "            respond(\"Nenhum cálculo ainda\")\n" +
                "        }\n\n" +
                "        prompt(\"calculadora\") {\n" +
                "            respond(\"Você é uma calculadora. Use a tool 'sum' para somar números.\")\n" +
                "        }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "### 4. Test the endpoint\n\n" +
                "```bash\n" +
                "curl -s -X POST http://localhost:8080/mcp \\\n" +
                "  -H \"Content-Type: application/json\" \\\n" +
                "  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}'\n" +
                "```\n\n" +
                "The MCP endpoint is served at http://localhost:8080/mcp. Point Claude, Cursor, or any MCP client at it — " +
                "tools/list returns the declared schema (type, required, description) so clients render the arguments and call tools/call."
        }
        if (topic == "time") {
            return "## Time with std.time (Epoch-First)\n\n" +
                "`Time` is a zero-overhead wrapper around Unix epoch seconds (`Time.sec: Int`). " +
                "There is NO `Clock.System` in Eiwa and NO `Time.now()` / `elapsed()` / `toMillis()`.\n\n" +
                "Top-level functions: `now(): Time` (current epoch seconds), `nowMillis(): Int` (current epoch millis), " +
                "`date(year: Int, month: Int, day: Int): Time` (midnight UTC), `hours/minutes/seconds(n: Int): Duration`.\n\n" +
                "### 1. now(), nowMillis(), date() and .sec access\n\n" +
                "```kotlin\nimport { now, nowMillis, date } from \"std.time\"\n\nfun main() {\n    val t = now()\n    println(t.sec)\n    println(nowMillis())\n    val release = date(2026, 7, 20)\n    println(release.format(\"YYYY-MM-DD HH:mm:ss\"))\n}\n```\n\n" +
                "### 2. Porting Kotlin Clock.System.now().toEpochMilliseconds()\n\n" +
                "```kotlin\nimport { now, nowMillis } from \"std.time\"\n\nfun main() {\n    // Kotlin: Clock.System.now().toEpochMilliseconds() / 86400000L\n    val daysSinceEpoch = nowMillis() / 86400000\n    // Equivalent using seconds: now().sec / 86400\n    val daysSinceEpoch2 = now().sec / 86400\n    println(daysSinceEpoch)\n}\n```\n\n" +
                "### 3. Daily rotation (days since epoch)\n\n" +
                "```kotlin\nimport { now } from \"std.time\"\n\nfun main() {\n    val dayIndex = now().sec / 86400\n    val rotation = dayIndex % 7\n    println(\"Day index: \$dayIndex, rotation slot: \$rotation\")\n}\n```\n\n" +
                "### 4. Formatting YYYY-MM-DD HH:mm:ss\n\n" +
                "```kotlin\nimport { now } from \"std.time\"\n\nfun main() {\n    println(now().format(\"YYYY-MM-DD HH:mm:ss\"))\n    println(now().toString())\n}\n```"
        }
        if (topic == "money") {
            return "## Money with std.money (minor units, Int cents)\n\n" +
                "Builders take MINOR units (`Int` cents — never `Double`): `brl(14990)` = R$ 149,90. " +
                "Formatting is `format(): String` (there is no `formatted()`). `+`/`-` throw on currency mismatch.\n\n" +
                "```kotlin\nimport { brl } from \"std.money\"\n\nfun main() {\n    val subtotal = brl(10000)\n    val discount = brl(1550)\n    val total = subtotal - discount\n    println(\"Total: \${total.format()}\")\n    println(brl(1000).split(3)[0].format())\n}\n```"
        }
        if (topic == "tests") {
            return "```kotlin\nfun add(a: Int, b: Int): Int = a + b\n\ntest \"addition works correctly\" {\n    assert(add(2, 3) == 5)\n    assert(add(-1, 1) == 0)\n}\n```"
        }
        if (topic == "platform") {
            return "## Cross-Platform Parity with contracts\n\n" +
                "Eiwa guarantees cross-platform API parity at compile time using a 3-tier architecture. " +
                "Low-level FFI blocks use explicit, non-colliding names, while universal contracts ensure identical method signatures across all target platforms.\n\n" +
                "### 1. Source Code (`platform_terminal.ei`)\n\n" +
                "```kotlin\n" +
                "// TIER 1: Low-level C FFI with explicit OS-specific names\n" +
                "@Header(\"<unistd.h>\")\n" +
                "lib(\"posix\") PosixTerminal {\n" +
                "    fun isatty(fd: Int): Int\n" +
                "}\n\n" +
                "@Header(\"<windows.h>\")\n" +
                "@Link(\"kernel32\")\n" +
                "lib(\"windows\") Win32Terminal {\n" +
                "    fun GetConsoleMode(handle: Pointer, mode: Pointer): Int\n" +
                "}\n\n" +
                "// TIER 2: Universal Specification (Contract)\n" +
                "contract TerminalContract {\n" +
                "    fun isInteractive(): Bool\n" +
                "    fun writeAnsi(code: String)\n" +
                "}\n\n" +
                "// TIER 3: Platform Adapters (Must implement the contract)\n" +
                "object(\"posix\") Terminal : TerminalContract {\n" +
                "    implement fun isInteractive(): Bool {\n" +
                "        return PosixTerminal.isatty(1) == 1\n" +
                "    }\n" +
                "    implement fun writeAnsi(code: String) {\n" +
                "        print(code)\n" +
                "    }\n" +
                "}\n\n" +
                "object(\"windows\") Terminal : TerminalContract {\n" +
                "    implement fun isInteractive(): Bool {\n" +
                "        return true // Win32 console check\n" +
                "    }\n" +
                "    implement fun writeAnsi(code: String) {\n" +
                "        // Win32 console write\n" +
                "        print(code)\n" +
                "    }\n" +
                "}\n\n" +
                "// TIER 4: Portable User Code (Zero platform-specific leaks)\n" +
                "fun main() {\n" +
                "    if (Terminal.isInteractive()) {\n" +
                "        Terminal.writeAnsi(\"\\u001b[32m[OK]\\u001b[0m Running on interactive terminal\\n\")\n" +
                "    } else {\n" +
                "        println(\"[BATCH] Running in redirected pipe\")\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 2. Build for any target\n\n" +
                "```bash\n" +
                "# Build for active host:\n" +
                "eiwa run platform_terminal.ei\n\n" +
                "# Cross-compile native binaries for different targets:\n" +
                "eiwa build --target linux platform_terminal.ei -o terminal_linux\n" +
                "eiwa build --target windows platform_terminal.ei -o terminal.exe\n" +
                "eiwa build --target macos platform_terminal.ei -o terminal_macos\n" +
                "```\n\n" +
                "### 3. How the compiler enforces parity\n\n" +
                "- **No Asymmetric Methods:** The compiler forbids adding ad-hoc methods to `object(\"posix\")` without declaring them in `TerminalContract`.\n" +
                "- **Identical Variant Contracts:** Every variant named `Terminal` (including any universal fallback) must declare `: TerminalContract`.\n" +
                "- **Zero-Cost LLVM Emission:** At compile time, the LLVM emitter prunes the inactive platform branch and binds the active target statically."
        }
        if (topic == "regex") {
            return "## Regex with std.regex (pure-Eiwa engine)\n\n" +
                "`Regex(pattern)`: `find(input): MatchResult?` (first match), `findAll(input): List<MatchResult>`, " +
                "`matches(input): Bool` (FULL match), `replace(input, replacement): String`. " +
                "String shortcuts: `matchesRegex/findRegex/findAllRegex/replaceRegex`.\n\n" +
                "```kotlin\nimport { Regex } from \"std.regex\"\n\nfun main() {\n    println(Regex(\"[0-9]+\").find(\"abc123\")?.value)\n    println(\"hello\".replaceRegex(\"l+\", \"L\"))\n    println(\"abc\".matchesRegex(\"[a-z]+\"))\n}\n```"
        }
        if (topic == "json") {
            return "## JSON with std.json (reflectionless)\n\n" +
                "Types opt in with `: Serializable + Json`, then `toJson(): String`. " +
                "Decode with `fromJson<T>(raw: String): T`, inspect schemaless payloads with `parseJson(raw): JsonValue` " +
                "(`get(key): JsonValue?`, `asString()/asNumber()/asBool()`). There is NO `Json.encode/Json.decode`.\n\n" +
                "```kotlin\nimport { Serializable } from \"std.serde\"\nimport { Json } from \"std.json\"\nimport { parseJson, fromJson } from \"std.json\"\n\ntype User(val id: Int, val name: String) : Serializable + Json\n\nfun main() {\n    val u = User(1, \"Alice\")\n    val raw = u.toJson()\n    println(raw)\n    val back: User = fromJson<User>(raw)\n    println(back.name)\n    println(parseJson(raw).get(\"name\")?.asString())\n}\n```"
        }
        if (topic == "uuid" || topic == "ulid" || topic == "ids") {
            return "## IDs with std.uuid & std.ulid\n\n" +
                "`Uuid.v4(): Uuid` (random), `Uuid.v7()/generate(): Uuid` (time-ordered), `Uuid.parse(str): Uuid?`, `version(): Int`. " +
                "`Ulid.generate(): Ulid` (millis prefix + CSPRNG), `Ulid.parse(str): Ulid?`, `timestamp(): Int`, 26-char Crockford `toString()`.\n\n" +
                "```kotlin\nimport { Uuid } from \"std.uuid\"\nimport { Ulid } from \"std.ulid\"\n\nfun main() {\n    println(Uuid.v4().toString())\n    println(Ulid.generate().toString())\n}\n```"
        }

        return "Example not found for: $topic. Available: http, http_client, html, tasks, postgres, mcp, time, money, tests, platform, regex, json, uuid, ulid."
    }
}
