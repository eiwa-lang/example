object ExamplesData {
    fun list(): String {
        return "# Functional Eiwa Examples\n\n" +
            "- `http`: Declarative HTTP routing with arest\n" +
            "- `http_client`: Type-safe HTTP Client with arest\n" +
            "- `html`: Type-safe HTML DSL with html builder\n" +
            "- `tasks`: Concurrency and parallel background coroutines\n" +
            "- `postgres`: Async database queries with std.postgres\n" +
            "- `mcp`: Publishing MCP Tools and Resources with arest\n" +
            "- `time`: Timestamp formatting and calculation\n" +
            "- `money`: Precision financial arithmetic\n" +
            "- `tests`: Native unit testing with `test \"name\" { ... }` blocks\n" +
            "- `platform`: Declarative cross-platform parity and contracts (ADR 60)"
    }

    fun get(topic: String): String {
        if (topic == "http") {
            return "## HTTP Server with arest\n\n" +
                "Declarative routing, typed JSON responses, and a health check in one compact server.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: api\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Server (http.ei)\n\n" +
                "```kotlin\n" +
                "import { arest } from \"arest.arest\"\n" +
                "import { MutableMap } from \"std.collections\"\n\n" +
                "arest(8080) {\n" +
                "    health()\n\n" +
                "    routing {\n" +
                "        get(\"/hello\") {\n" +
                "            respondText(\"Hello from Eiwa!\")\n" +
                "        }\n\n" +
                "        get(\"/user\") {\n" +
                "            val body = MutableMap<String, String>()\n" +
                "            body.put(\"name\", \"Ana\")\n" +
                "            body.put(\"role\", \"admin\")\n" +
                "            respondJson(body.freeze().toJson())\n" +
                "        }\n\n" +
                "        post(\"/echo\") {\n" +
                "            respondJson(request.body)\n" +
                "        }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run and test\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "curl http://localhost:8080/hello\n" +
                "curl http://localhost:8080/user\n" +
                "```\n\n" +
                "Routes are plain functions over ApplicationCall: respond, respondText, respondJson, respondHtml. Static files and health checks are built in."
        }
        if (topic == "http_client" || topic == "client") {
            return "## HTTP Client with arest\n\n" +
                "Expressive DSL, automatic Content Negotiation, pluggable transport engines (CurlEngine / MockEngine), and zero-reflection typed response parsing directly into DTOs.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: my-client\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Client (client.ei)\n\n" +
                "```kotlin\n" +
                "import { arestClient } from \"arest.client.client\"\n" +
                "import { Serializable } from \"std.serde\"\n" +
                "import { Json } from \"std.json\"\n\n" +
                "type UserDto(val id: Int, val name: String, val email: String) : Serializable + Json\n\n" +
                "val client = arestClient {\n" +
                "    baseUrl(\"https://api.example.com\")\n" +
                "    timeout(10000)\n" +
                "    bearerAuth(\"secret-token\")\n" +
                "}\n\n" +
                "// GET with automatic typed deserialization into UserDto:\n" +
                "val res = client.get(\"/users/1\")\n" +
                "if (res.ok) {\n" +
                "    val user = res.body<UserDto>()\n" +
                "    print(\"Found user: \${user.name} (\${user.email})\")\n" +
                "}\n\n" +
                "// POST with automatic JSON serialization:\n" +
                "val newUser = UserDto(2, \"Ana\", \"ana@example.com\")\n" +
                "val createRes = client.post(\"/users\", newUser)\n" +
                "print(\"Created: \${createRes.status}\")\n" +
                "```\n\n" +
                "### 3. Run and test\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "Found user: Ana (ana@example.com)\n" +
                "Created: 201\n" +
                "```\n\n" +
                "The client supports query parameters, custom headers, status predicates (isNotFound, isServerError), and pluggable transport engines like CurlEngine (libcurl) and MockEngine."
        }
        if (topic == "html") {
            return "## HTML DSL with the html package\n\n" +
                "Build pages with a declarative, type-safe DSL — no string templates.\n\n" +
                "### 1. Declare the dependencies (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: site\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  html:\n" +
                "    github: eiwa-lang/html\n" +
                "    branch: main\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Page (page.ei)\n\n" +
                "```kotlin\n" +
                "import { html } from \"html\"\n" +
                "import { arest } from \"arest.arest\"\n\n" +
                "fun page(): String = html {\n" +
                "    head {\n" +
                "        title(\"Eiwa App\")\n" +
                "    }\n" +
                "    body {\n" +
                "        h1(\"Welcome to Eiwa\")\n" +
                "        ul {\n" +
                "            li { write(\"Native performance\") }\n" +
                "            li { write(\"Strict null safety\") }\n" +
                "        }\n" +
                "    }\n" +
                "}\n\n" +
                "arest(8080) {\n" +
                "    routing {\n" +
                "        get(\"/\") { respond(200, \"text/html\", page()) }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "The html builder escapes attributes automatically and returns a ready-to-serve String."
        }
        if (topic == "tasks") {
            return "```kotlin\nimport { task, sleep } from \"std.coroutines\"\n\nfun fetchItem(id: Int): String {\n    sleep(100)\n    return \"Item #\$id\"\n}\n\nfun main() {\n    val t1 = task { fetchItem(1) }\n    val t2 = task { fetchItem(2) }\n    println(\"\${t1.await()} and \${t2.await()}\")\n}\n```"
        }
        if (topic == "postgres") {
            return "## PostgreSQL Native Driver\n\n" +
                "Direct native connection and parameterized queries — no ORM.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: users\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  postgres:\n" +
                "    github: eiwa-lang/postgres\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Query (database.ei)\n\n" +
                "```kotlin\n" +
                "import { Postgres } from \"postgres\"\n\n" +
                "val db = Postgres.connect(\"postgres://user:pass@localhost:5432/mydb\")\n\n" +
                "val result = db.query(\"SELECT id, name, email FROM users WHERE active = $1\", [\"true\"])\n\n" +
                "for (result.rows()) {\n" +
                "    println(\"User: \${it.string(\\\"name\\\")} <\${it.string(\\\"email\\\")}>\")\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "Rows expose typed accessors: string(name), int(name), double(name), bool(name). Queries are parameterized — no string concatenation."
        }
        if (topic == "mcp") {
            return "## MCP Server with arest\n\n" +
                "arest publishes MCP tools, resources, and prompts over HTTP/JSON-RPC — no extra server needed. " +
                "This example builds a Calculator tool with declared argument schemas that MCP clients render automatically.\n\n" +
                "### 1. Declare the dependency (eiwa.yaml)\n\n" +
                "```yaml\n" +
                "name: mcp-app\n" +
                "version: 0.1.0\n\n" +
                "dependencies:\n" +
                "  arest:\n" +
                "    github: eiwa-lang/arest\n" +
                "    branch: main\n" +
                "```\n\n" +
                "### 2. Server (mcp.ei)\n\n" +
                "```kotlin\n" +
                "import { arest } from \"arest.arest\"\n" +
                "import { Argument, JsonType } from \"arest.mcp.mcp_builder\"\n\n" +
                "arest(8080) {\n" +
                "    mcp {\n" +
                "        name(\"Calculator\")\n" +
                "        version(\"1.0.0\")\n" +
                "        instructions(\"Soma dois números e retorna o total.\")\n\n" +
                "        tool(\"sum\", description = \"Soma dois números\", arguments = [\n" +
                "            Argument(\"a\", JsonType.INTEGER, \"Primeiro número\"),\n" +
                "            Argument(\"b\", JsonType.INTEGER, \"Segundo número\")\n" +
                "        ]) {\n" +
                "            val a = arguments.get(\"a\")!!.asNumber()\n" +
                "            val b = arguments.get(\"b\")!!.asNumber()\n" +
                "            respond(a + b)\n" +
                "        }\n\n" +
                "        resource(\"calc://historico\") {\n" +
                "            respond(\"Nenhum cálculo ainda\")\n" +
                "        }\n\n" +
                "        prompt(\"calculadora\") {\n" +
                "            respond(\"Você é uma calculadora. Use a tool 'sum' para somar números.\")\n" +
                "        }\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 3. Run\n\n" +
                "```bash\n" +
                "eiwa run\n" +
                "```\n\n" +
                "### 4. Test the endpoint\n\n" +
                "```bash\n" +
                "curl -s -X POST http://localhost:8080/mcp \\\n" +
                "  -H \"Content-Type: application/json\" \\\n" +
                "  -d '{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"tools/list\",\"params\":{}}'\n" +
                "```\n\n" +
                "The MCP endpoint is served at http://localhost:8080/mcp. Point Claude, Cursor, or any MCP client at it — " +
                "tools/list returns the declared schema (type, required, description) so clients render the arguments and call tools/call."
        }
        if (topic == "time") {
            return "```kotlin\nimport { Time, Duration } from \"std.time\"\n\nfun main() {\n    val start = Time.now()\n    val elapsed = start.elapsed()\n    println(\"Elapsed: \${elapsed.toMillis()}ms\")\n}\n```"
        }
        if (topic == "money") {
            return "```kotlin\nimport { Money } from \"std.money\"\n\nfun main() {\n    val subtotal = Money.brl(100.00)\n    val discount = Money.brl(15.50)\n    val total = subtotal - discount\n    println(\"Total: \${total.formatted()}\")\n}\n```"
        }
        if (topic == "tests") {
            return "```kotlin\nfun add(a: Int, b: Int): Int = a + b\n\ntest \"addition works correctly\" {\n    assert(add(2, 3) == 5)\n    assert(add(-1, 1) == 0)\n}\n```"
        }
        if (topic == "platform") {
            return "## Cross-Platform Parity with\n\n" +
                "Eiwa guarantees cross-platform API parity at compile time using a 3-tier architecture. " +
                "Low-level FFI blocks use explicit, non-colliding names, while universal contracts ensure identical method signatures across all target platforms.\n\n" +
                "### 1. Source Code (`platform_terminal.ei`)\n\n" +
                "```kotlin\n" +
                "// TIER 1: Low-level C FFI with explicit OS-specific names\n" +
                "@Header(\"<unistd.h>\")\n" +
                "lib(\"posix\") PosixTerminal {\n" +
                "    fun isatty(fd: Int): Int\n" +
                "}\n\n" +
                "@Header(\"<windows.h>\")\n" +
                "@Link(\"kernel32\")\n" +
                "lib(\"windows\") Win32Terminal {\n" +
                "    fun GetConsoleMode(handle: Pointer, mode: Pointer): Int\n" +
                "}\n\n" +
                "// TIER 2: Universal Specification (Contract)\n" +
                "contract TerminalContract {\n" +
                "    fun isInteractive(): Bool\n" +
                "    fun writeAnsi(code: String)\n" +
                "}\n\n" +
                "// TIER 3: Platform Adapters (Must implement the contract)\n" +
                "object(\"posix\") Terminal : TerminalContract {\n" +
                "    implement fun isInteractive(): Bool {\n" +
                "        return PosixTerminal.isatty(1) == 1\n" +
                "    }\n" +
                "    implement fun writeAnsi(code: String) {\n" +
                "        print(code)\n" +
                "    }\n" +
                "}\n\n" +
                "object(\"windows\") Terminal : TerminalContract {\n" +
                "    implement fun isInteractive(): Bool {\n" +
                "        return true // Win32 console check\n" +
                "    }\n" +
                "    implement fun writeAnsi(code: String) {\n" +
                "        // Win32 console write\n" +
                "        print(code)\n" +
                "    }\n" +
                "}\n\n" +
                "// TIER 4: Portable User Code (Zero platform-specific leaks)\n" +
                "fun main() {\n" +
                "    if (Terminal.isInteractive()) {\n" +
                "        Terminal.writeAnsi(\"\\u001b[32m[OK]\\u001b[0m Running on interactive terminal\\n\")\n" +
                "    } else {\n" +
                "        println(\"[BATCH] Running in redirected pipe\")\n" +
                "    }\n" +
                "}\n" +
                "```\n\n" +
                "### 2. Build for any target\n\n" +
                "```bash\n" +
                "# Build for active host:\n" +
                "eiwa run platform_terminal.ei\n\n" +
                "# Cross-compile native binaries for different targets:\n" +
                "eiwa build --target linux platform_terminal.ei -o terminal_linux\n" +
                "eiwa build --target windows platform_terminal.ei -o terminal.exe\n" +
                "eiwa build --target macos platform_terminal.ei -o terminal_macos\n" +
                "```\n\n" +
                "### 3. How the compiler enforces parity\n\n" +
                "- **No Asymmetric Methods:** The compiler forbids adding ad-hoc methods to `object(\"posix\")` without declaring them in `TerminalContract`.\n" +
                "- **Identical Variant Contracts:** Every variant named `Terminal` (including any universal fallback) must declare `: TerminalContract`.\n" +
                "- **Zero-Cost LLVM Emission:** At compile time, the LLVM emitter prunes the inactive platform branch and binds the active target statically."
        }

        return "Example not found for: $topic. Available: http, html, tasks, postgres, mcp, time, money, tests, platform."
    }
}
