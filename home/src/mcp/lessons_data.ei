type LessonInfo(
    val id: String,
    val title: String,
    val summary: String,
    val code: String
)

type LessonsData() {
} object {

    fun list(): String {
        return "# Eiwa Language Tour - 32 Lessons Index\n\n" +
            "01. Import symbols (`import { ... } from \".path\"`)\n" +
            "02. Write without main (Top-level statements & scripting)\n" +
            "03. Sum a list (List<T>, `for (items) { it -> }`)\n" +
            "04. Repeat and loops (`repeat(n)`, `while`, `loop`, `retry`)\n" +
            "05. Escape sequences (String escapes & `+` concat)\n" +
            "06. Avoid unsafe null (`T | Null`, `T?`, `?.`, `?:`, `!!`)\n" +
            "07. Exceptions (`try-catch`, `Throwable`, `throw`)\n" +
            "08. Create maps (`Map<K, V>`, `MutableMap<K, V>`)\n" +
            "09. Use ternary (`condition ? a : b`)\n" +
            "10. Overload + (Operator overloading `.plus()`, `.minus()`)\n" +
            "11. Standardize branches (`when (x) { val -> ... else -> ... }`)\n" +
            "12. Compose types and objects (`type`, `contract`, `skill`, `object`, `implement`)\n" +
            "13. Run tasks (Stackless coroutines `task {}`, `.await()`)\n" +
            "14. Serialize without reflection (`toJson()`, `fromJson()`)\n" +
            "15. Narrow contracts with casts (`is Contract`, `is Type`, smart cast)\n" +
            "16. Model variants with enum (Algebraic Data Types)\n" +
            "17. Write once with generics (`List<T>`, generic types/functions)\n" +
            "18. Chain with scope functions (`let`, `apply`, `also`, `run`, `with`)\n" +
            "19. Talk to native C (`cimport`, `@Header`, `@CFunction`, `Pointer`)\n" +
            "20. Build, then freeze (Mutability `.mut()` and `.freeze()`)\n" +
            "21. Generate unique IDs (`std.uuid`)\n" +
            "22. Manage money (`std.money` currency-safe arithmetic)\n" +
            "23. Work with epoch time (`std.time` timestamps & durations)\n" +
            "24. Sortable ULIDs (`std.ulid` lexicographically sortable)\n" +
            "25. Structured logging (`std.log` JSON / plain)\n" +
            "26. Environment & .env (`std.env` config loader)\n" +
            "27. Random & collections (`std.random` sampling & shuffling)\n" +
            "28. Extension functions (`fun Type.extension(): Ret`)\n" +
            "29. Platform parity (`contract`, `object(\"posix\")`, `object(\"windows\")`)\n" +
            "30. Exit early with break (`break`, `break value`, no `continue`)\n" +
            "31. for returns List (`for` as map/filter, null-skip, `break value` appends)\n" +
            "32. try returns T? (bare `try` as expression, `runCatching {}.getOrNull()`)"
    }

    fun get(query: String): String {
        if (query == "1" || query == "01" || query == "imports") {
            return "### Lesson 01: Import Symbols\n" +
                "Eiwa uses explicit destructuring imports. Module paths use dots (e.g. `.fragments.user`).\n\n" +
                "```kotlin\nimport { add, Vector } from \".math\"\n\nfun main() {\n    val v = Vector(1, 1)\n    val r = add(5, 5)\n    println(r)\n}\n```"
        }
        if (query == "2" || query == "02" || query == "toplevel") {
            return "### Lesson 02: Write Without Main\n" +
                "Top-level execution is valid in the root entry file for fast scripting.\n\n" +
                "```kotlin\nval message = \"Fast script in Eiwa\"\nprintln(message)\n```"
        }
        if (query == "3" || query == "03" || query == "collections") {
            return "### Lesson 03: Sum a List\n" +
                "Collections are immutable by default (`[1, 2, 3]`). `for` loop injects `it` implicitly.\n\n" +
                "```kotlin\nfun main() {\n    val numbers = [1, 2, 3, 4, 5]\n    var sum = 0\n    for (numbers) {\n        sum = sum + it\n    }\n    println(\"Sum = \$sum\")\n}\n```"
        }
        if (query == "4" || query == "04" || query == "loops") {
            return "### Lesson 04: Repeat and Loops\n" +
                "`repeat(n) { ... }`, `while (cond) { ... }`, and `loop { ... }`.\n\n" +
                "```kotlin\nfun main() {\n    repeat(3) { idx ->\n        println(\"Step \$idx\")\n    }\n}\n```"
        }
        if (query == "5" || query == "05" || query == "strings") {
            return "### Lesson 05: Escape Sequences & Stringable\n" +
                "Backslash escapes `\\n`, `\\t`, `\\\"`, and string concatenation with `+` automatically calls `toString()`.\n\n" +
                "```kotlin\nfun main() {\n    val text = \"Line 1\\nLine 2\\tTabbed\"\n    println(text)\n}\n```"
        }
        if (query == "6" || query == "06" || query == "nullsafety") {
            return "### Lesson 06: Avoid Unsafe Null\n" +
                "Strict compile-time null safety with union type `Type?` (`Type | Null`), safe navigation `?.`, and elvis `?:`.\n\n" +
                "```kotlin\nfun main() {\n    val name: String? = null\n    val display = name ?: \"Guest\"\n    println(display)\n}\n```"
        }
        if (query == "7" || query == "07" || query == "exceptions") {
            return "### Lesson 07: Exceptions\n" +
                "Any type implementing `Throwable` can be thrown and caught with `try-catch`.\n\n" +
                "```kotlin\ntype AppError(val msg: String) : Throwable {\n    implement fun message(): String = msg\n}\n\nfun main() {\n    try {\n        throw AppError(\"Failed operation\")\n    } catch (e: AppError) {\n        println(\"Caught: \${e.message()}\")\n    }\n}\n```"
        }
        if (query == "8" || query == "08" || query == "maps") {
            return "### Lesson 08: Create Maps\n" +
                "`Map<K, V>` and `MutableMap<K, V>` with union values support.\n\n" +
                "```kotlin\nimport { MutableMap } from \"std.collections\"\n\nfun main() {\n    val map = MutableMap<String, String>()\n    map[\"lang\"] = \"Eiwa\"\n    println(map[\"lang\"])\n}\n```"
        }
        if (query == "9" || query == "09" || query == "ternary") {
            return "### Lesson 09: Ternary Operator\n" +
                "Standard ternary expression `condition ? ifTrue : ifFalse`.\n\n" +
                "```kotlin\nfun main() {\n    val score = 85\n    val result = score >= 60 ? \"Pass\" : \"Fail\"\n    println(result)\n}\n```"
        }
        if (query == "10" || query == "operators") {
            return "### Lesson 10: Operator Overloading\n" +
                "Types overload operators with the MANDATORY `operator` modifier: `operator fun plus(...)`. " +
                "Without `operator` the method is ordinary and `+` will not resolve to it.\n\n" +
                "```kotlin\ntype Vector(val x: Int, val y: Int) {\n    operator fun plus(other: Vector): Vector = Vector(x + other.x, y + other.y)\n}\n\nfun main() {\n    val v1 = Vector(1, 2)\n    val v2 = Vector(3, 4)\n    val v3 = v1 + v2\n    println(v3.x)\n}\n```"
        }
        if (query == "11" || query == "when") {
            return "### Lesson 11: Standardize Branches (when)\n" +
                "Pattern matching and branch execution with `when`.\n\n" +
                "```kotlin\nfun main() {\n    val status = 200\n    val desc = when (status) {\n        200 -> \"OK\"\n        404 -> \"Not Found\"\n        else -> \"Unknown\"\n    }\n    println(desc)\n}\n```"
        }
        if (query == "12" || query == "compositionobject") {
            return "### Lesson 12: Compose Types and Objects (ADR 25)\n" +
                "Eiwa uses composition instead of inheritance. `type` implements `contract` and composes `skill` using `implement`.\n\n" +
                "```kotlin\ncontract Greeter { fun greet(): String }\nskill Friendly : Greeter { fun salute(): String = \"\${greet()}! Welcome!\" }\n\ntype Host(val name: String) : Greeter + Friendly {\n    implement fun greet(): String = \"Hello, I am \$name\"\n}\n\nfun main() {\n    val h = Host(\"Eiwa\")\n    println(h.salute())\n}\n```"
        }
        if (query == "13" || query == "tasks") {
            return "### Lesson 13: Run Tasks (Stackless Coroutines)\n" +
                "`task { ... }` spawns a `StackTask<T>`, `.await()` suspends cooperatively until done. " +
                "There is no top-level `sleep` in `std.coroutines` (blocking `sleep/sleepMs` live in `std.system`; cooperative sleep is `Coroutine.sleepMs`).\n\n" +
                "```kotlin\nimport { task } from \"std.coroutines\"\n\nfun main() {\n    val t = task { 40 + 2 }\n    println(t.await())\n}\n```"
        }
        if (query == "14" || query == "serialization") {
            return "### Lesson 14: Serialize Without Reflection\n" +
                "Types opt in with `: Serializable + Json`, then `toJson(): String`; decode with `fromJson<T>(raw)`. " +
                "There is NO `Json.encode/Json.decode`.\n\n" +
                "```kotlin\nimport { Serializable } from \"std.serde\"\nimport { Json } from \"std.json\"\nimport { fromJson } from \"std.json\"\n\ntype User(val id: Int, val name: String) : Serializable + Json\n\nfun main() {\n    val user = User(1, \"Alice\")\n    val raw = user.toJson()\n    println(raw)\n    val back: User = fromJson<User>(raw)\n    println(back.name)\n}\n```"
        }
        if (query == "15" || query == "smartcast") {
            return "### Lesson 15: Smart Casts\n" +
                "Checking `when (x) is Contract` or `if (x is Type)` automatically casts the variable.\n\n" +
                "```kotlin\ncontract Shape { fun area(): Double }\ntype Circle(val r: Double) : Shape { implement fun area(): Double = 3.14 * r * r }\n\nfun printShape(s: Shape) {\n    if (s is Circle) {\n        println(\"Radius: \${s.r}\")\n    }\n}\n```"
        }
        if (query == "16" || query == "enum") {
            return "### Lesson 16: Model Variants with Enum\n" +
                "Enums model discrete variants and state sets.\n\n" +
                "```kotlin\nenum Status { PENDING, RUNNING, DONE }\n\nfun main() {\n    val s = Status.RUNNING\n    println(s.name())\n}\n```"
        }
        if (query == "17" || query == "generics") {
            return "### Lesson 17: Write Once with Generics\n" +
                "Parametric polymorphism for types and functions: `Box<T>(val item: T)`.\n\n" +
                "```kotlin\ntype Box<T>(val value: T) {\n    fun get(): T = value\n}\n\nfun main() {\n    val b = Box<String>(\"Eiwa\")\n    println(b.get())\n}\n```"
        }
        if (query == "18" || query == "scopefunc") {
            return "### Lesson 18: Scope Functions\n" +
                "Kotlin-style scope functions: `let`, `apply`, `also`, `run`, `with`.\n\n" +
                "```kotlin\ntype Config(var host: String = \"\", var port: Int = 0)\n\nfun main() {\n    val cfg = Config().apply {\n        host = \"localhost\"\n        port = 8080\n    }\n    println(\"\${cfg.host}:\${cfg.port}\")\n}\n```"
        }
        if (query == "19" || query == "cinterop") {
            return "### Lesson 19: Talk to Native C\n" +
                "Zero-overhead native C interop with `@Header` and `@CFunction`.\n\n" +
                "```kotlin\n@Header(\"stdlib.h\")\nlib {\n    @CFunction fun abs(n: Int): Int\n}\n\nfun main() {\n    println(abs(-42))\n}\n```"
        }
        if (query == "20" || query == "mutability") {
            return "### Lesson 20: Build, Then Freeze\n" +
                "Convert mutable collections to immutable views using `.freeze()` or `.mut()`. " +
                "`MutableList.add` is overloaded: `add(element)` appends one item, `add(list)` / `addAll(list)` appends a whole `List<T>` in place. " +
                "`listA + listB` and `list + element` return a NEW immutable `List<T>` without mutating the operands. " +
                "Appending a `MutableList` requires `.freeze()` first.\n\n" +
                "```kotlin\nfun main() {\n    val mut = [1, 2].mut()\n    mut.add(3)\n    mut.add([4, 5])\n    mut.addAll([6])\n    val frozen = mut.freeze()\n    println(frozen.size())\n    println([1, 2] + [3, 4])\n}\n```"
        }
        if (query == "21" || query == "uuid") {
            return "### Lesson 21: Generate Unique IDs\n" +
                "`std.uuid` provides RFC 4122 UUIDs: `Uuid.v4()` (random), `Uuid.v7()` / `Uuid.generate()` (time-ordered), " +
                "`Uuid.parse(str): Uuid?`, `version(): Int`, `toString()`, `toBytes()`.\n\n" +
                "```kotlin\nimport { Uuid } from \"std.uuid\"\n\nfun main() {\n    val id = Uuid.v4()\n    println(id.toString())\n    println(id.version())\n}\n```"
        }
        if (query == "22" || query == "money") {
            return "### Lesson 22: Manage Money\n" +
                "`std.money` provides precision-safe arithmetic in minor units (cents). Builders take `Int` cents: `brl/usd/eur/...(cents)`. " +
                "`Money` supports `+`/`-` (throws on currency mismatch), `* factor`, `isZero/isPositive/isNegative`, " +
                "`allocate(ratios: List<Int>)` (Fowler exact-sum split), `split(parts: Int)`, `format(): String`.\n\n" +
                "```kotlin\nimport { brl } from \"std.money\"\n\nfun main() {\n    val price = brl(1999)\n    val tax = brl(150)\n    val total = price + tax\n    println(total.format())\n}\n```"
        }
        if (query == "23" || query == "time") {
            return "### Lesson 23: Work with Epoch Time\n" +
                "`std.time` handles epoch timestamps and durations. `now(): Time`, `date(year, month, day): Time`, " +
                "builders `hours/minutes/seconds(n): Duration`. `Time` has `second/minute/hour/year/month/day`, " +
                "`format(pattern)` (tokens YYYY/MM/DD/HH/mm/ss), `+ Duration`, `- Time = Duration`.\n\n" +
                "```kotlin\nimport { now, hours } from \"std.time\"\n\nfun main() {\n    val start = now()\n    val deadline = start + hours(2)\n    println(deadline.format(\"YYYY-MM-DD HH:mm:ss\"))\n}\n```"
        }
        if (query == "24" || query == "ulid") {
            return "### Lesson 24: Sortable ULIDs\n" +
                "`std.ulid` generates 128-bit lexicographically sortable identifiers: `Ulid.generate(): Ulid`, " +
                "`Ulid.parse(str): Ulid?`, `timestamp(): Int`, `toString()` (26-char Crockford), `toBytes()`.\n\n" +
                "```kotlin\nimport { Ulid } from \"std.ulid\"\n\nfun main() {\n    val id = Ulid.generate()\n    println(id.toString())\n}\n```"
        }
        if (query == "25" || query == "logging") {
            return "### Lesson 25: Structured Logging\n" +
                "`std.log` provides leveled logging (`TRACE/DEBUG/INFO/WARN/ERROR`). Loggers take lazy message lambdas: " +
                "`Log.info { \"...\" }`, `Log.with(key, value)`, `Log.withFields(map)`, `Log.setLevel/setFormatter`.\n\n" +
                "```kotlin\nimport { Log } from \"std.log\"\n\nfun main() {\n    Log.with(\"port\", \"8080\").info { \"Server starting\" }\n}\n```"
        }
        if (query == "26" || query == "env") {
            return "### Lesson 26: Environment & .env\n" +
                "`std.env` reads OS environment variables and parses local `.env` files (auto-loaded on first `get`). " +
                "`Env.get(key): String?`, `Env.get(key, default: String/Int/Bool)`, `Env.set/unset/exists`, `Env.load(path?): Bool`.\n\n" +
                "```kotlin\nimport { Env } from \"std.env\"\n\nfun main() {\n    val port = Env.get(\"PORT\") ?: \"8080\"\n    println(\"Port: \$port\")\n}\n```"
        }
        if (query == "27" || query == "random") {
            return "### Lesson 27: Random & Collections\n" +
                "`std.random` provides a CSPRNG `Random` object and deterministic `SeededRandom` generators. " +
                "Both share skill `RandomOps`: `nextInt()`, `nextInt(min: Int, max: Int)` (inclusive), `nextPercent()` (0..100), " +
                "`nextDouble()` / `nextDouble(min: Double, max: Double)`, `nextBool()`, `choice(list): T?` (null when empty), " +
                "`shuffle(list): List<T>` (Fisher-Yates, returns a NEW list). `Random.seeded(seed: Int): SeededRandom` creates a reproducible generator.\n\n" +
                "```kotlin\nimport { Random } from \"std.random\"\n\nfun main() {\n    val roll = Random.nextInt(1, 6)\n    val coin = Random.nextBool()\n    val pct = Random.nextPercent()\n    val pick = Random.choice([\"Alice\", \"Bob\", \"Charlie\"])\n    val deck = Random.shuffle([1, 2, 3])\n    val rng = Random.seeded(42)\n    println(\"Roll: \$roll\")\n}\n```"
        }
        if (query == "28" || query == "extensions") {
            return "### Lesson 28: Extension Functions\n" +
                "Extend existing types with custom methods without subclassing.\n\n" +
                "```kotlin\nfun String.shout(): String = \"\$this!!!\"\n\nfun main() {\n    println(\"hello\".shout())\n}\n```"
        }

        if (query == "29" || query == "platform" || query == "parity") {
            return "### Lesson 29: Declarative Platform Parity\n\n" +
                "In traditional systems programming (C/C++ with `#ifdef` or Go build tags), platform-specific code easily diverges into **False Symmetry**: " +
                "a Linux implementation exposes methods that Windows lacks, compiling locally but breaking CI or cross-platform builds.\n\n" +
                "Eiwa eliminates this problem at compile time via **Strict Platform Parity** with a mandatory 3-Tier Architecture:\n\n" +
                "1. **FFI Isolation:** Low-level C bindings must declare explicit, unique names (e.g. `PosixTerminal` vs `Win32Terminal`). Reusing the same `lib` name across platforms is prohibited.\n" +
                "2. **Universal Specification:** A `contract` defines the pure semantic interface visible to user code.\n" +
                "3. **Platform Adapters:** Specialized `object(\"...\")` or `type(\"...\")` blocks MUST implement the contract. All variants sharing the same name (including universal default fallbacks) must implement the identical contract list. Ad-hoc uncontracted public methods are rejected by the compiler.\n\n" +
                "```kotlin\n" +
                "// 1. UNIVERSAL CONTRACT\n" +
                "contract TerminalContract {\n" +
                "    fun clear(): Bool\n" +
                "    fun getWidth(): Int\n" +
                "}\n\n" +
                "// 2. POSIX IMPLEMENTATION (Linux, macOS, BSD)\n" +
                "object(\"posix\") Terminal : TerminalContract {\n" +
                "    implement fun clear(): Bool {\n" +
                "        println(\"\\u001b[2J\\u001b[H\")\n" +
                "        return true\n" +
                "    }\n" +
                "    implement fun getWidth(): Int = 80\n" +
                "}\n\n" +
                "// 3. WINDOWS WIN32 IMPLEMENTATION\n" +
                "object(\"windows\") Terminal : TerminalContract {\n" +
                "    implement fun clear(): Bool {\n" +
                "        // Win32 Console API calls\n" +
                "        return true\n" +
                "    }\n" +
                "    implement fun getWidth(): Int = 80\n" +
                "}\n\n" +
                "// 4. PORTABLE USER CODE\n" +
                "fun main() {\n" +
                "    Terminal.clear()\n" +
                "    println(\"Width: \${Terminal.getWidth()}\")\n" +
                "}\n" +
                "```\n\n" +
                "### Compiler Guarantees:\n" +
                "- **Compile-time parity validation:** If any platform variant lacks a method from the contract, compilation fails immediately.\n" +
                "- **Zero runtime cost:** The LLVM emitter prunes inactive platform branches and binds the active target statically without virtual dispatch."
        }

        if (query == "30" || query == "break" || query == "breaklesson") {
            return "### Lesson 30: Exit Early with Break\n" +
                "`break` exits the innermost `while`/`for` loop. There is no `continue` — skipping an iteration is written with `if`/`else`. " +
                "Inside a lambda, `return` is forbidden; `break value` exits the lambda early with that value instead. " +
                "`break` outside any loop or lambda, and `break` inside `task {}` blocks, are compile-time errors.\n\n" +
                "```kotlin\n" +
                "var total = 0\n" +
                "for ([1, 2, 3, 4, 5]) { n ->\n" +
                "    if (n == 4) {\n" +
                "        break\n" +
                "    }\n" +
                "    total = total + n\n" +
                "}\n" +
                "println(\"total: \$total\")\n\n" +
                "val f: (Int) -> Int = { x ->\n" +
                "    if (x < 0) {\n" +
                "        break 0\n" +
                "    }\n" +
                "    x * 2\n" +
                "}\n" +
                "println(\"f(5): \${f(5)}\")\n" +
                "println(\"f(-3): \${f(-3)}\")\n" +
                "```"
        }
        if (query == "31" || query == "formap" || query == "map" || query == "filter") {
            return "### Lesson 31: for Returns List (Map & Filter)\n" +
                "A `for` loop in value position collects each iteration into a `List<T>` like Kotlin's `map`. " +
                "Iterations yielding `null` are skipped (inline `filter`); an `if` without `else` in value position types as `T?`. " +
                "Bare `break` ends with what was collected; `break value` appends and ends. Used as a statement, `for` allocates nothing.\n\n" +
                "```kotlin\n" +
                "val doubled = for ([1, 2, 3]) { it * 2 }\n\n" +
                "val odds = for ([1, 2, 3, 4]) { n ->\n" +
                "    if (n == 1 || n == 3) n\n" +
                "}\n\n" +
                "val withEnd = for ([1, 2, 3]) { n ->\n" +
                "    if (n == 2) {\n" +
                "        break -1\n" +
                "    }\n" +
                "    n\n" +
                "}\n" +
                "```"
        }
        if (query == "32" || query == "tryvalue" || query == "try" || query == "getornull") {
            return "### Lesson 32: try Returns T? (Native getOrNull)\n" +
                "A bare `try` without `catch` in value position yields `T?`: success stores the trailing expression, any exception stores `null` — " +
                "the native substitute for Kotlin's `runCatching { f() }.getOrNull()`, with no `Result` wrapper. " +
                "The elvis LHS counts as a value slot, so `try { f() } ?: fallback` works directly. " +
                "A `Void` body in value position is a compile-time error; `try` with `catch` in value position and value-`try` inside `task {}` are rejected.\n\n" +
                "```kotlin\n" +
                "val retorno: String? = try { PersonaGoal.metodo() }\n" +
                "// ok -> value | throw -> null\n\n" +
                "val greeting: String = try { fetchName() } ?: \"guest\"\n" +
                "```"
        }
        return "Lesson not found for: $query. Call list_lessons to see all 32 lessons."
    }
}
