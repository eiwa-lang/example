import { fragment } from "html"

fun hero(): String {
    return fragment {
        div(class = "wrap hero-grid") {
            div(class = "hero-copy") {
                span("A modern programming language", class = "pill")
                h1 {
                    write("Build software with ")
                    span("clarity.", class = "grad")
                }
                p("Eiwa combines Kotlin-like ergonomics with native compilation, compile-time null safety, and a practical path for APIs, MCPs, and safe systems.", class = "lead")
                div(class = "cta-row") {
                    a(href = "#tour", class = "btn btn-primary") {
                        write("Explore the tour")
                        svg(viewBox = "0 0 24 24", class = "button-icon") { path(d = "M5 12h14M13 6l6 6-6 6", fill = "none") }
                    }
                    a(href = "#examples", class = "btn btn-ghost") {
                        write("View examples")
                        svg(viewBox = "0 0 24 24", class = "button-icon") { path(d = "M4 19.5A2.5 2.5 0 016.5 17H20V4H6.5A2.5 2.5 0 004 6.5v13zM4 19.5A2.5 2.5 0 006.5 22H20v-5", fill = "none") }
                    }
                }
                div(class = "install-container") {
                    div(class = "os-selector") {
                        button(text = "macOS / Linux", id = "tab-os-unix", class = "os-tab active")
                        button(text = "Windows (PowerShell)", id = "tab-os-win", class = "os-tab")
                    }
                    div(class = "install", id = "hero-install-box") {
                        span("$", class = "dollar", id = "hero-install-prompt")
                        code("curl -fsSL https://eiwa.dev/install.sh | sh", id = "hero-install-code")
                        button(id = "copy-install", class = "copy-button") {
                            svg(viewBox = "0 0 24 24", class = "copy-icon") { path(d = "M9 9h12v12H9zM5 15V5a2 2 0 012-2h10", fill = "none") }
                        }
                    }
                }
            }
            div(class = "hero-art") {
                div("hero-note") {
                    write("// Eiwa sees")
                    br()
                    write("what others")
                    br()
                    write("don't.")
                    br()
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                }
                img(src = "/assets/owl-hero.avif", alt = "Eiwa owl mascot")
            }
        }
    }
}
