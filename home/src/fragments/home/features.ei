                }
                div(class = "card") {
                    div(class = "icon") { svg(viewBox = "0 0 24 24") { path(d = "M5 15c-1.5 1.5-2 5-2 5s3.5-.5 5-2M14 4c3-3 8-2 8-2s1 5-2 8l-8 8-4-4 6-6z", fill = "none") } }
                    div {
