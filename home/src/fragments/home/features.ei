                }
                div(class = "card") {
                    div(class = "icon") { svg(viewBox = "0 0 24 24") { path(d = "M12 2l9 5v10l-9 5-9-5V7l9-5zM12 22V12M3 7l9 5 9-5", fill = "none") } }
                    div {
                        h3("Composition")
                        p("Types, contracts, skills, and objects compose behavior.")
