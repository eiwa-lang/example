import { fragment } from "html"

fun features(): String {
    return fragment {
        div(class = "wrap") {
            div(class = "feature-row") {
                div(class = "card") {
                    div(class = "icon") { svg(viewBox = "0 0 24 24") { path(d = "M13 2L4 14h6l-1 8 9-12h-6l1-8z", fill = "none") } }
                    div {
                        h3("Native, no JVM")
                        p("Build standalone binaries with a lightweight runtime.")
                    }
                }
                div(class = "card") {
                    div(class = "icon") { svg(viewBox = "0 0 24 24") { path(d = "M8 6l-6 6 6 6M16 6l6 6-6 6", fill = "none") } }
                    div {
                        h3("Expressive")
                        p("Kotlin-like ergonomics with clear, compact code.")
                    }
                }
                div(class = "card") {
                    div(class = "icon") { svg(viewBox = "0 0 24 24") { path(d = "M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6l8-4z", fill = "none") } }
                    div {
                        h3("Null safety")
                        p("Unsafe access is blocked by the type system.")
