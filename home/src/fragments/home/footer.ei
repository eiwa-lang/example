import { fragment } from "html"

fun footer(): String {
    return fragment {
        div(class = "wrap") {
            p(text = "Eiwa is built for developers who value clarity and native performance.", class = "tagline")
            p(class = "built-with") {
                write("Built with ")
                a(text = "Eiwa", href = "https://github.com/eiwa-lang/eiwa", target = "_blank", rel = "noreferrer")
                write(" + ")
                a(text = "Arest", href = "https://github.com/eiwa-lang/arest", target = "_blank", rel = "noreferrer")
            }
        }
    }
}
