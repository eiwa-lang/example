import { fragment } from "html"

fun collectionsExample(): String {
    return fragment {
        div {
            div(class = "editor-bar") {
                div(class = "file-title") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    write("collections.ei")
                }
            }
            div(class = "editor-content") {
            h3(text = "list concat with add & +")
            p(text = "Append whole lists in place with add/addAll, or combine immutably with the + sugar.")
            pre {
                code(class = "language-kotlin") {
                    write("import { List } from \"std.collections\"\n\nfun main() {\n    // In-place: overload of add (Kotlin: addAll)\n    val queue = [\"hello\"].mut()\n    queue.add([\"world\"])\n    queue.addAll([\"!\"])\n    print(queue.freeze()) // [hello, world, !]\n\n    // Sugar: + always returns a NEW List\n    val feed = [\"hello\"] + [\"world\"] + \"!\"\n    print(feed) // [hello, world, !]\n}")
                }
            }
            }
        }
    }
}
