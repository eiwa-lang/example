import { fragment } from "html"

fun httpExample(): String {
    return fragment {
        div {
            div(class = "editor-bar") {
                div(class = "file-title") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    write("http.ei")
                }
            }
            div(class = "editor-content") {
            h3("JSON routes with Arest")
            p("Return map-based JSON and serialize typed objects in one compact server.")
            pre {
                code(class = "language-kotlin") {
                    write("import { arest } from \"arest.arest\"\n\narest(8082) {\n    routing {\n        get(\"/map\") {\n            val body = MutableMap<String, String>()\n            body[\"content\"] = \"Welcome to Eiwa!\"\n            body[\"page\"] = request.queries[\"page\"] ?: \"home\"\n\n            respond(200, \"application/json\", body.toJson())\n        }\n\n        get(\"/json\") {\n            val addr = Address(\"Sao Paulo\", \"01000-000\")\n            val person = Person(\"Ana\", 30, addr, date(1987, 10, 10), [\"friend\", \"coder\"])\n\n            respond(200, \"application/json\", person.toJson())\n        }\n    }\n}")
                }
            }
            }
        }
    }
}