import { fragment } from "html"

fun moneyExample(): String {
    return fragment {
        div {
            div(class = "editor-bar") {
                div(class = "file-title") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    write("money.ei")
                }
            }
            div(class = "editor-content") {
            h3("Money, currencies and allocation")
            p("Standard currencies, overloaded arithmetic, and the Fowler allocation engine prevent fractional-cent loss.")
            pre {
                code(class = "language-kotlin") {
                    write("import { brl, usd, eur } from \"std.money\"\n\n// 1. Precise arithmetic without floating-point rounding errors\nval price = brl(14990)        // R$ 149,90\nval shipping = brl(2500)      // R$ 25,00\nval discount = brl(1500)      // R$ 15,00\nval total = price + shipping - discount\n\nprintln(\"Order Total: \" + total.format()) // R$ 159,90\n\n// 2. Fowler Allocation: split R$ 100,00 among 3 partners (70%, 20%, 10%)\nval payout = brl(10000)\nval shares = payout.allocate([70, 20, 10])\n\nprintln(\"Partner A (70%): \" + shares[0].format()) // R$ 70,00\nprintln(\"Partner B (20%): \" + shares[1].format()) // R$ 20,00\nprintln(\"Partner C (10%): \" + shares[2].format()) // R$ 10,00\n\n// 3. Fair split: R$ 10,00 divided in 3 parts without losing 1 cent\nval splitBill = brl(1000).split(3)\nprintln(\"Split: \" + splitBill[0].format() + \" + \" + splitBill[1].format() + \" + \" + splitBill[2].format())")
                }
            }
            }
        }
    }
}
