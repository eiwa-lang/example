import { fragment } from "html"

fun mcpExample(): String {
    return fragment {
        div {
            div(class = "editor-bar") {
                div(class = "file-title") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    write("mcp.ei")
                }
            }
            div(class = "editor-content") {
            h3("MCP tool in Arest")
            p("The same syntax can publish a tool consumed by MCP agents and clients.")
            pre {
                code(class = "language-kotlin") {
                    write("import { arest } from \"arest.arest\"\nimport { Argument, JsonType } from \"arest.mcp.mcp_builder\"\n\narest(8080) {\n    mcp {\n        name(\"Calculator\")\n        version(\"1.0.0\")\n        tool(\"sum\", description = \"Soma dois números\", arguments = [\n            Argument(\"a\", JsonType.INTEGER, \"Primeiro número\", true),\n            Argument(\"b\", JsonType.INTEGER, \"Segundo número\", true)\n        ]) {\n            val a = arguments.get(\"a\")!!.asNumber()\n            val b = arguments.get(\"b\")!!.asNumber()\n            respond((a + b).toString())\n        }\n    }\n}")
                }
            }
            }
        }
    }
}
