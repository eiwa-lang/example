import { fragment } from "html"

fun mcpExample(): String {
    return fragment {
        div {
            div(class = "editor-bar") {
                div(class = "file-title") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    write("mcp.ei")
                }
            }
            div(class = "editor-content") {
            h3("MCP tool in Eiwa")
            p("The same syntax can publish a tool consumed by MCP agents and clients.")
            pre {
                code(class = "language-kotlin") {
                    write("import { arest } from \"arest.arest\"\n\narest(8080) {\n    mcp {\n        name(\"Calculator\")\n        version(\"1.0.0\")\n        tool(\"sum\") {\n            val a = argument<Int>(\"a\")\n            val b = argument<Int>(\"b\")\n            respond(a + b)\n        }\n    }\n}")
                }
            }
            }
        }
    }
}
