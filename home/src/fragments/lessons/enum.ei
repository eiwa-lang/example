import { fragment } from "html"

fun enumTypes(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "Every enum variant is a compile-time constant with synthesized name, ordinal, and values().", dataOutput = "NORTH 0\nNORTH\n\n[ok] Enum variants are closed sets and match exhaustively in when.") {
            p("Define a strongly typed set of constants and pattern-match on it.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("enum Direction { NORTH, EAST, SOUTH, WEST }\n\nval d = Direction.NORTH\nprint(d.name + \" \" + d.ordinal.toString())\n\nwhen (d) {\n    Direction.EAST -> print(\"east\")\n    else -> print(\"north\")\n}")
                }
            }
        }
    }
}