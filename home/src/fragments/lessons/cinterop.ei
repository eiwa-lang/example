import { fragment } from "html"

fun cInterop(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "A lib block maps C symbols into Eiwa with annotations for headers, linking, and aliases.", dataOutput = "[compiled with the resolver]\n\n[ok] No wrapper code: @Header injects includes and @Link resolves pkg-config.") {
            p("Declare a lib block to bind a C library without hand-written glue.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("@Link(\"curl\")\n@Header(\"<curl/curl.h>\")\nlib NativeHttp {\n    @Alias(\"curl_easy_init\")\n    fun init(): Pointer\n\n    @Alias(\"curl_easy_perform\")\n    fun perform(handle: Pointer): Int\n}")
                }
            }
        }
    }
}