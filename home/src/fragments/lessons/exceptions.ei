import { fragment } from "html"

fun exceptions(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "You can also use catch without a variable as a catch-all.", dataOutput = "Invalid age\n\n[ok] Any type implementing Throwable can be thrown and handled by type.") {
            p("Declare a simple Throwable and handle the error.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("type InvalidAgeException(val text: String) : Throwable {\n    implement fun message(): String {\n        return text\n    }\n}\n\nfun checkAge(age: Int) {\n    if (age < 18) {\n        throw InvalidAgeException(\"Invalid age\")\n    }\n}\n\ntry {\n    checkAge(15)\n} catch (e: InvalidAgeException) {\n    print(e.message())\n}")
                }
            }
        }
    }
}