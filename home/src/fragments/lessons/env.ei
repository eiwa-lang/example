import { fragment } from "html"

fun envLesson(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "std.env automatically parses .env files and reads system environment variables with typed defaults.", dataOutput = "Production: 8080\n\n[ok] Env variables support typed fallbacks for String, Int, and Bool.") {
            p("Read system environment variables and .env configs safely.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("import { Env } from \"std.env\"\n\nval port = Env.getInt(\"PORT\", 8080)\nval isProd = Env.getBool(\"PRODUCTION\", false)\n\nprintln(\"Production: \" + port)")
                }
            }
        }
    }
}
