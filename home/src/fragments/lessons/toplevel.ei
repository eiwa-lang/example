import { fragment } from "html"

fun topLevel(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "fun main() is optional for scripts and small examples.", dataOutput = "Eiwa native\n\n[ok] Eiwa allows top-level code in the file passed to eiwa run and blocks side effects in imports.") {
            p("Execute statements directly in the root file.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("val language = \"Eiwa\"\nval mode = \"native\"\n\nprint(language + \" \" + mode)")
                }
            }
        }
    }
}