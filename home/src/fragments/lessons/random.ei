import { fragment } from "html"

fun randomLesson(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "std.random provides CSPRNG random bytes, seeded generators, and collection helpers.", dataOutput = "Roll: 6\nWinner: Bob\n\n[ok] Random helpers support ranges, weighted percentages, and list shuffling.") {
            p("Generate numbers, percentages, and pick elements from collections.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("import { Random } from \"std.random\"\n\nval dice = Random.nextInt(1, 6)\nprintln(\"Roll: \$dice\")\n\nval team = [\"Alice\", \"Bob\", \"Charlie\"]\nval lucky = Random.choice(team)\nprintln(\"Winner: \$lucky\")")
                }
            }
        }
    }
}
