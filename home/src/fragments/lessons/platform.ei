import { fragment } from "html"

fun platformLesson(): String {
    return fragment {
        div(class = "lesson-fragment space-y-4", dataHint = "Strict Platform Parity (ADR 60): specialized types and objects MUST implement contracts, all variants must share the identical contract list, and low-level FFI libs use explicit unique names like PosixTerminal and Win32Terminal.", dataOutput = "[compiled for posix target: aarch64-macos-none]\n\n[ok] Parity verified: All variants implement TerminalOpsContract.\n[ok] Static dispatch bound with zero runtime overhead.\n[ok] Cross-compilation verified for windows and linux targets.") {
            div(class = "space-y-2") {
                p("In traditional systems programming (C/C++ with #ifdef), platform-conditional code easily suffers from False Symmetry: Windows implementations expose methods that Linux lacks, silently breaking cross-platform builds and CI pipelines.", class = "text-slate-300 text-sm leading-relaxed")
                p("Eiwa solves this at compile time via Strict Platform Parity (ADR 60) using a 3-Tier Architecture:", class = "text-slate-300 text-sm leading-relaxed")
                ul(class = "list-disc list-inside text-xs text-slate-400 space-y-1 pl-2") {
                    li { write("1. FFI Isolation: Low-level C bindings must have unique, explicit names (PosixTerminal vs Win32Terminal). Duplicate lib names are banned.") }
                    li { write("2. Semantic Contract: A universal contract defines the exact public API visible to application code.") }
                    li { write("3. Platform Adapters: Specialized object(\"...\") or type(\"...\") blocks MUST implement the contract. Ad-hoc uncontracted methods are rejected by the compiler.") }
                }
            }
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("// 1. UNIVERSAL CONTRACT (Pure Specification)\ncontract TerminalOpsContract {\n    fun clear(): Bool\n    fun getWidth(): Int\n}\n\n// 2. POSIX IMPLEMENTATION (Linux & macOS)\nobject(\"posix\") Terminal : TerminalOpsContract {\n    implement fun clear(): Bool {\n        println(\"\\u001b[2J\\u001b[H\")\n        return true\n    }\n    implement fun getWidth(): Int = 80\n}\n\n// 3. WINDOWS WIN32 IMPLEMENTATION\nobject(\"windows\") Terminal : TerminalOpsContract {\n    implement fun clear(): Bool {\n        // Calls Win32 FillConsoleOutputCharacterA\n        return true\n    }\n    implement fun getWidth(): Int = 80\n}\n\n// 4. PORTABLE APPLICATION CODE (Zero platform leaks)\nfun main() {\n    Terminal.clear()\n    println(\"Terminal width: \${Terminal.getWidth()}\")\n}")
                }
            }
            p("The compiler validates that all variants share the identical contract list before generating LLVM IR. Inactive platform branches are pruned at compile time with zero runtime overhead.", class = "text-xs text-slate-400 italic")
        }
    }
}
