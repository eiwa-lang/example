import { fragment } from "html"

fun ulid(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "ULIDs are 128-bit lexicographically sortable identifiers with millisecond precision.", dataOutput = "26 chars\n\n[ok] ULIDs sort chronologically in databases without coordination.") {
            p("Generate 128-bit time-ordered identifiers with std.ulid.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("import { Ulid } from \"std.ulid\"\n\nval id = Ulid.generate()\nprintln(id.toString().length + \" chars\")\nprintln(\"Timestamp ms: \" + id.timestamp())")
                }
            }
        }
    }
}
