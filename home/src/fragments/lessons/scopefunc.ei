import { fragment } from "html"

fun scopeFunctions(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "let returns the lambda result, while also/apply return the receiver for chaining.", dataOutput = "22\nbox\n\n[ok] Scope functions keep the value in scope with an implicit it, reducing temp variables.") {
            p("Transform and configure values with let, also, and apply.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("val doubled = 20.let { it + 2 }\nprint(doubled.toString())\n\nval label = \"box\".also { /* side effect */ }\nprint(label)")
                }
            }
        }
    }
}