import { fragment } from "html"

fun scopeFunctions(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "Scope functions (let, run, with, apply, also) execute a block in the context of an object.", dataOutput = "22\nbox\n\n[ok] Scope functions reduce boilerplate and make chained operations clean and readable.") {
            p("Use scope functions like let and also for clean object transformations.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("val doubled = 20.let { it + 2 }\nprint(doubled)\n\nval label = \"box\".also { /* side effect */ }\nprint(label)")
                }
            }
        }
    }
}
