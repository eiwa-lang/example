import { fragment } from "html"

fun nullSafety(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "After if (guest != null), guest is String-free: direct access, no ?. needed.", dataOutput = "Leo\nAnonymous\n\n[ok] Null is a union type. Check once with != null and use directly.") {
            p(text = "Model absence with User? — unwrap with ?. / ?: or check once and use directly.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("type User(val name: String)\n\nval guest: User? = User(\"Leo\")\nif (guest != null) {\n    print(guest.name)\n}\n\nval anon: User? = null\nprint(anon?.name ?: \"Anonymous\")")
                }
            }
        }
    }
}