import { fragment } from "html"

fun collections(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "The [1, 2, 3] syntax creates a List. For mutation, use .mut().", dataOutput = "10\n\n[ok] Loops are straightforward and the list remains immutable during reads.") {
            p("Iterate through an immutable List using for.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("val numbers = [1, 2, 3, 4]\nvar total = 0\n\nfor (item in numbers) {\n    total = total + item\n}\n\nprint(total)")
                }
            }
        }
    }
}