import { fragment } from "html"

fun strings(): String {
    return fragment {
        div(class = "lesson-fragment space-y-3", dataHint = "Keep \\n or \\t in the text to see how the compiler handles escaped literals.", dataOutput = "C:\\eiwa\\bin\n\nFirst Line\nSecond Line\n\n[ok] Escapes are resolved by the type checker before size calculations and runtime operations.") {
            p("Use Kotlin-style escapes in string literals.", class = "text-slate-300")
            pre(class = "overflow-x-auto border border-white/15 bg-slate-950/80 p-5 text-sm leading-6") {
                code(class = "language-kotlin") {
                    write("val path = \"C:\\\\eiwa\\\\bin\"\nval message = \"First Line\\nSecond Line\"\n\nprint(path)\nprint(message)")
                }
            }
        }
    }
}