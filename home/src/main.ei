import { html } from "html"
import { arest } from "arest.arest"

import { httpExample } from ".fragments.examples.http"
import { httpClientExample } from ".fragments.examples.http_client"
import { htmlExample } from ".fragments.examples.htmldsl"
import { mcpExample } from ".fragments.examples.mcp"
import { testExample } from ".fragments.examples.test"
import { timeExample } from ".fragments.examples.time"
import { moneyExample } from ".fragments.examples.money"
import { hero } from ".fragments.home.hero"
import { whyEiwa } from ".fragments.home.why"
import { features } from ".fragments.home.features"
import { paradigms } from ".fragments.home.paradigms"
import { start } from ".fragments.home.start"
import { footer } from ".fragments.home.footer"
import { packages } from ".fragments.home.packages"
import { mcpCard } from ".fragments.home.mcp"
import { setupMcp } from ".mcp.server"
import { imports } from ".fragments.lessons.imports"
import { topLevel } from ".fragments.lessons.toplevel"
import { collections } from ".fragments.lessons.collections"
import { loops } from ".fragments.lessons.loops"
import { strings } from ".fragments.lessons.strings"
import { nullSafety } from ".fragments.lessons.nullsafety"
import { exceptions } from ".fragments.lessons.exceptions"
import { maps } from ".fragments.lessons.maps"
import { ternary } from ".fragments.lessons.ternary"
import { operators } from ".fragments.lessons.operators"
import { whenExpr } from ".fragments.lessons.when"
import { compositionObject } from ".fragments.lessons.compositionobject"
import { tasks } from ".fragments.lessons.tasks"
import { serialization } from ".fragments.lessons.serialization"
import { smartCast } from ".fragments.lessons.smartcast"
import { enumTypes } from ".fragments.lessons.enum"
import { generics } from ".fragments.lessons.generics"
import { scopeFunctions } from ".fragments.lessons.scopefunc"
import { cInterop } from ".fragments.lessons.cinterop"
import { mutability } from ".fragments.lessons.mutability"
import { uuid } from ".fragments.lessons.uuid"
import { tasksExample } from ".fragments.examples.tasks"
import { postgresExample } from ".fragments.examples.postgres"
import { money } from ".fragments.lessons.money"
import { time } from ".fragments.lessons.time"
import { ulid } from ".fragments.lessons.ulid"
import { logging } from ".fragments.lessons.logging"
import { envLesson } from ".fragments.lessons.env"
import { randomLesson } from ".fragments.lessons.random"
import { extensionsLesson } from ".fragments.lessons.extensions"
import { platformExample } from ".fragments.examples.platform"
import { platformLesson } from ".fragments.lessons.platform"

fun homePage() = html {
    head {
        meta(charset = "UTF-8")
        meta(name = "viewport", contentValue = "width=device-width, initial-scale=1.0")
        meta(name = "description", contentValue = "Eiwa is a modern programming language for native APIs, MCP, and safe systems.")
        title("Eiwa - Build software with clarity")
        link(rel = "stylesheet", href = "/app.css")
        link(rel = "stylesheet", href = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/base16/material-darker.min.css")
        script(src = "https://unpkg.com/htmx.org@2.0.6")
        script(src = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js")
        script(src = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/kotlin.min.js")
        script(src = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/json.min.js")
        script(src = "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/yaml.min.js")

        link(rel = "icon", linkType = "image/png", href = "/favicon/favicon-96x96.png", sizes = "96x96")
        link(rel = "icon", linkType = "image/svg+xml", href = "/favicon/favicon.svg")
        link(rel = "shortcut icon", href = "/favicon/favicon.ico")
        link(rel = "apple-touch-icon", href = "/favicon/apple-touch-icon.png", sizes="180x180")
        meta(name = "apple-mobile-web-app-title", contentValue = "Eiwa")
        link(rel = "manifest", href = "/favicon/site.webmanifest")
    }
    body(id = "top") {
        header {
            nav(class = "wrap nav") {
                a(href = "#top", class = "brand") {
                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                    span {
                        strong("eiwa")
                        small("lang")
                    }
                }
                div(class = "nav-links") {
                    a(text = "Paradigms", href = "#paradigms")
                    a(text = "Why Eiwa?", href = "#why")
                    a(text = "Language", href = "#tour")
                    a(text = "Examples", href = "#examples")
                    a(text = "Packages", href = "#packages")
                    a(text = "MCP AI", href = "#mcp")
                    a(text = "Start", href = "#start")
                    a(text = "GitHub", href = "https://github.com/eiwa-lang/eiwa", target = "_blank", rel = "noreferrer")
                }
                div(class = "nav-right") {
                    a(text = "Get Started", href = "#start", class = "btn btn-primary btn-sm nav-cta")
                    button(id = "menu-toggle", class = "menu-toggle") {
                        span(class = "hamburger-bar") {}
                        span(class = "hamburger-bar") {}
                        span(class = "hamburger-bar") {}
                    }
                }
            }
        }
        div(id = "mobile-menu", class = "mobile-menu") {
            div(class = "mobile-menu-inner") {
                a(text = "Paradigms", href = "#paradigms", class = "mobile-link")
                a(text = "Why Eiwa?", href = "#why", class = "mobile-link")
                a(text = "Language Tour", href = "#tour", class = "mobile-link")
                a(text = "Examples", href = "#examples", class = "mobile-link")
                a(text = "Packages", href = "#packages", class = "mobile-link")
                a(text = "MCP AI", href = "#mcp", class = "mobile-link")
                a(text = "Quick Start", href = "#start", class = "mobile-link")
                a(text = "GitHub", href = "https://github.com/eiwa-lang/eiwa", target = "_blank", rel = "noreferrer", class = "mobile-link")
                a(text = "Get Started", href = "#start", class = "btn btn-primary mobile-menu-btn")
            }
        }
        main {
            section(id = "hero", class = "hero", hxGet = "/fragments/home/hero", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "features", hxGet = "/fragments/home/features", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "playground", class = "section") {
                div(class = "wrap") {
                    div(class = "section-heading") {
                        p("Modern syntax with native performance, strict null safety, and a composition-first type model.")
                    }
                    div(class = "code-grid") {
                        div(class = "editor") {
                            div(class = "editor-bar") {
                                div(class = "file-title source-code") {
                                    img(src = "/assets/eiwa.avif", alt = "Eiwa", class = "logo")
                                    write("main.ei")
                                }
                                div(class = "thead") {
                                    span(class = "dot") {}
                                    write("Terminal")
                                }
                            }
                            div(class = "editor-split") {
                                div(class = "editor-content source-code") {
                                    pre(class = "playground-code") {
                                        code {
                                            span("fun", class = "tok-kw")
                                            write(" ")
                                            span("main", class = "tok-fn")
                                            write("() {\n    ")
                                            span("val", class = "tok-kw")
                                            write(" message = ")
                                            span("\"Hello, Eiwa!\"", class = "tok-str")
                                            write("\n    ")
                                            span("println", class = "tok-fn")
                                            write("(message)\n\n    ")
                                            span("val", class = "tok-kw")
                                            write(" numbers = [1, 2, 3, 4, 5]\n    ")
                                            span("for", class = "tok-kw")
                                            write(" (numbers) {\n        ")
                                            span("println", class = "tok-fn")
                                            write("(")
                                            span("\"n = \$it\"", class = "tok-str")
                                            write(")\n    }\n}")
                                        }
                                    }
                                }
                                div(class = "terminal") {
                                    div {
                                        span("$", class = "prompt")
                                        write(" eiwa run main.ei")
                                    }
                                    div {
                                        write("Hello, Eiwa!")
                                    }
                                    div {
                                        write("n = 1")
                                    }
                                    div {
                                        write("n = 2")
                                    }
                                    div {
                                        write("n = 3")
                                    }
                                    div {
                                        write("n = 4")
                                    }
                                    div {
                                        write("n = 5")
                                    }
                                    div(class = "ok") {
                                        write("Finished in 0.23s")
                                    }
                                    div {
                                        span("$", class = "prompt")
                                        write(" ")
                                        span("", class = "cursor")
                                    }
                                }
                            }
                        }
                        div(id = "playground-card", hxGet = "/fragments/home/start", hxTrigger = "load", hxSwap = "innerHTML") {}
                    }
                }
            }
            section(id = "paradigms", class = "section", hxGet = "/fragments/home/paradigms", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "why", class = "section", hxGet = "/fragments/home/why", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "examples", class = "section") {
                div(class = "wrap") {
                    div(class = "section-heading") { h2("Small code, clear intent")  p("Switch between HTTP, MCP, tests, time, and money examples.") }
                    div(class = "tabs-layout") {
                        div(class = "tab-list", id = "example-tabs") {
                            button(text = "HTTP Server", class = "tab-button active example-tab", hxGet = "/fragments/examples/http", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "HTTP Client", class = "tab-button example-tab", hxGet = "/fragments/examples/http_client", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "HTML", class = "tab-button example-tab", hxGet = "/fragments/examples/html", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Tasks", class = "tab-button example-tab", hxGet = "/fragments/examples/tasks", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Postgres", class = "tab-button example-tab", hxGet = "/fragments/examples/postgres", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "MCP Server", class = "tab-button example-tab", hxGet = "/fragments/examples/mcp", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Time", class = "tab-button example-tab", hxGet = "/fragments/examples/time", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Money", class = "tab-button example-tab", hxGet = "/fragments/examples/money", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Tests", class = "tab-button example-tab", hxGet = "/fragments/examples/tests", hxTarget = "#example-view", hxSwap = "innerHTML")
                            button(text = "Platform", class = "tab-button example-tab", hxGet = "/fragments/examples/platform", hxTarget = "#example-view", hxSwap = "innerHTML")
                        }
                        div(id = "example-view", class = "editor", hxGet = "/fragments/examples/http", hxTrigger = "load", hxSwap = "innerHTML") {}
                    }
                }
            }
            section(id = "packages", class = "section", hxGet = "/fragments/home/packages", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "tour", class = "section") {
                div(class = "wrap") {
                    div(class = "section-heading") { h2("Eiwa language tour") p("Choose a lesson, inspect its code, and view its expected output.") }
                    div(class = "lesson-layout") {
                        div(class = "tab-list lesson-list", id = "lesson-tabs") {
                            button(text = "01 Import symbols", class = "tab-button active lesson-tab", hxGet = "/fragments/lessons/imports", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "02 Write without main", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/toplevel", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "03 Sum a list", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/collections", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "04 Repeat and loops", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/loops", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "05 Escape sequences", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/strings", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "06 Avoid unsafe null", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/nullsafety", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "07 Exceptions", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/exceptions", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "08 Create maps", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/maps", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "09 Use ternary", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/ternary", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "10 Overload +", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/operators", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "11 Standardize branches", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/when", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "12 Compose types and objects", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/compositionobject", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "13 Run tasks", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/tasks", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "14 Serialize without reflection", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/serialization", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "15 Narrow contracts with casts", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/smartcast", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "16 Model variants with enum", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/enum", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "17 Write once with generics", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/generics", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "18 Chain with scope functions", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/scopefunc", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "19 Talk to native C", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/cinterop", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "20 Build, then freeze", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/mutability", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "21 Generate unique IDs", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/uuid", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "22 Manage money", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/money", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "23 Work with epoch time", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/time", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "24 Sortable ULIDs", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/ulid", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "25 Structured logging", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/logging", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "26 Environment & .env", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/env", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "27 Random & collections", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/random", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "28 Extension functions", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/extensions", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                            button(text = "29 Platform parity", class = "tab-button lesson-tab", hxGet = "/fragments/lessons/platform", hxTarget = "#lesson-preview", hxSwap = "innerHTML")
                        }
                        div(class = "lesson-workspace") {
                            div(id = "lesson-preview", class = "editor", hxGet = "/fragments/lessons/imports", hxTrigger = "load", hxSwap = "innerHTML") {}
                            button(text = "Show expected output", id = "run-lesson", class = "btn btn-primary")
                            div(class = "output-grid") {
                                div(class = "output-panel") { h3("Expected output")  pre("Choose a lesson, then click Show output.", id = "lesson-output", class = "expected") }
                                div(class = "output-panel") { h3("Hint")  p("The selected lesson will explain its intent here.", id = "lesson-hint") }
                            }
                        }
                    }
                }
            }
            section(id = "mcp", class = "section", hxGet = "/fragments/home/mcp", hxTrigger = "load", hxSwap = "innerHTML") {}
            section(id = "start", class = "section") {
                div(class = "wrap code-grid") {
                    div(class = "editor") {
                        div(class = "editor-bar") {
                            div(class = "quick") {
                                span(class = "dot") {}
                                write("Quick start")
                            }
                            div(class = "terminal-os-tabs") {
                                button(text = "macOS / Linux", id = "terminal-tab-unix", class = "terminal-tab active")
                                button(text = "Windows", id = "terminal-tab-win", class = "terminal-tab")
                            }
                        }
                        div(class = "terminal", id = "start-terminal-body") {
                            div(id = "terminal-unix-commands") {
                                div {
                                    span("$", class = "prompt")
                                    write(" curl -fsSL https://eiwa.dev/install.sh | sh")
                                }
                                div {
                                    span("$", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" init my-app && cd my-app")
                                }
                                div {
                                    span("$", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" add eiwa-lang/arest")
                                }
                                div {
                                    span("$", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" run")
                                }
                                div {
                                    span("$", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" test")
                                }
                                div {
                                    span("$", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" build")
                                }
                            }
                            div(id = "terminal-win-commands", class = "hidden") {
                                div {
                                    span("PS >", class = "prompt")
                                    write(" irm https://eiwa.dev/install.ps1 | iex")
                                }
                                div {
                                    span("PS >", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" init my-app; cd my-app")
                                }
                                div {
                                    span("PS >", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" add eiwa-lang/arest")
                                }
                                div {
                                    span("PS >", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" run")
                                }
                                div {
                                    span("PS >", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" test")
                                }
                                div {
                                    span("PS >", class = "prompt")
                                    span(" eiwa", class = "eiwa")
                                    write(" build")
                                }
                            }
                            div {
                                span("$", class = "prompt", id = "terminal-cursor-prompt")
                                write(" ")
                                span("", class = "cursor")
                            }
                        }
                    }
                    div(id = "start-card", hxGet = "/fragments/home/start", hxTrigger = "load", hxSwap = "innerHTML") {}
                }
            }
        }
        footer(id = "footer", hxGet = "/fragments/home/footer", hxTrigger = "load", hxSwap = "innerHTML") {}
        script(src = "/app.js")
    }
}

arest(8081) {
    health()
    setupMcp(this)
    routing {
        static("/", "static")
        get("/") { respond(homePage(), 200, "text/html") }
        get("/fragments/home/hero") { respond(hero(), 200, "text/html") }
        get("/fragments/home/why") { respond(whyEiwa(), 200, "text/html") }
        get("/fragments/home/features") { respond(features(), 200, "text/html") }
        get("/fragments/home/mcp") { respond(mcpCard(), 200, "text/html") }
        get("/fragments/home/paradigms") { respond(paradigms(), 200, "text/html") }
        get("/fragments/home/start") { respond(start(), 200, "text/html") }
        get("/fragments/home/footer") { respond(footer(), 200, "text/html") }
        get("/fragments/home/packages") { respond(packages(), 200, "text/html") }
        get("/fragments/examples/http") { respond(httpExample(), 200, "text/html") }
        get("/fragments/examples/http_client") { respond(httpClientExample(), 200, "text/html") }
        get("/fragments/examples/html") { respond(htmlExample(), 200, "text/html") }
        get("/fragments/examples/mcp") { respond(mcpExample(), 200, "text/html") }
        get("/fragments/examples/tests") { respond(testExample(), 200, "text/html") }
        get("/fragments/examples/time") { respond(timeExample(), 200, "text/html") }
        get("/fragments/examples/money") { respond(moneyExample(), 200, "text/html") }
        get("/fragments/lessons/imports") { respond(imports(), 200, "text/html") }
        get("/fragments/lessons/toplevel") { respond(topLevel(), 200, "text/html") }
        get("/fragments/lessons/collections") { respond(collections(), 200, "text/html") }
        get("/fragments/lessons/loops") { respond(loops(), 200, "text/html") }
        get("/fragments/lessons/strings") { respond(strings(), 200, "text/html") }
        get("/fragments/lessons/nullsafety") { respond(nullSafety(), 200, "text/html") }
        get("/fragments/lessons/exceptions") { respond(exceptions(), 200, "text/html") }
        get("/fragments/lessons/maps") { respond(maps(), 200, "text/html") }
        get("/fragments/lessons/ternary") { respond(ternary(), 200, "text/html") }
        get("/fragments/lessons/operators") { respond(operators(), 200, "text/html") }
        get("/fragments/lessons/when") { respond(whenExpr(), 200, "text/html") }
        get("/fragments/lessons/compositionobject") { respond(compositionObject(), 200, "text/html") }
        get("/fragments/lessons/tasks") { respond(tasks(), 200, "text/html") }
        get("/fragments/lessons/serialization") { respond(serialization(), 200, "text/html") }
        get("/fragments/lessons/smartcast") { respond(smartCast(), 200, "text/html") }
        get("/fragments/lessons/enum") { respond(enumTypes(), 200, "text/html") }
        get("/fragments/lessons/generics") { respond(generics(), 200, "text/html") }
        get("/fragments/lessons/scopefunc") { respond(scopeFunctions(), 200, "text/html") }
        get("/fragments/lessons/cinterop") { respond(cInterop(), 200, "text/html") }
        get("/fragments/lessons/mutability") { respond(mutability(), 200, "text/html") }
        get("/fragments/lessons/uuid") { respond(uuid(), 200, "text/html") }
        get("/fragments/examples/tasks") { respond(tasksExample(), 200, "text/html") }
        get("/fragments/examples/postgres") { respond(postgresExample(), 200, "text/html") }
        get("/fragments/lessons/money") { respond(money(), 200, "text/html") }
        get("/fragments/lessons/time") { respond(time(), 200, "text/html") }
        get("/fragments/lessons/ulid") { respond(ulid(), 200, "text/html") }
        get("/fragments/lessons/logging") { respond(logging(), 200, "text/html") }
        get("/fragments/lessons/env") { respond(envLesson(), 200, "text/html") }
        get("/fragments/lessons/random") { respond(randomLesson(), 200, "text/html") }
        get("/fragments/lessons/extensions") { respond(extensionsLesson(), 200, "text/html") }
        get("/fragments/examples/platform") { respond(platformExample(), 200, "text/html") }
        get("/fragments/lessons/platform") { respond(platformLesson(), 200, "text/html") }
    }
}
